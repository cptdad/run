        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тишина по умолчанию"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Aamusnaan asal ahaan"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyst som standard"
          }
        }
      }
    },
    "about_ready_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو Rún — هادئ وخاص وسرّه بيدك. أضف شخصًا وجهًا لوجه، وابدأ محادثة لا يراها أحد سواكما."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er Rún — stille, privat og din egen hemmelighed. Tilføj en person ansigt til ansigt, og start en samtale, ingen andre kan se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist Rún — still, privat und dein Geheimnis. Füge jemanden persönlich hinzu und beginne eine Unterhaltung, die niemand sonst sehen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's Rún — quiet, private, and yours to keep secret. Add someone in person, and start a conversation no one else can see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es Rún: silencioso, privado y tuyo para guardarlo en secreto. Añade a alguien en persona y empieza una conversación que nadie más puede ver."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این Rún است — ساکت، خصوصی و رازی که مال شماست. کسی را حضوری اضافه کنید و گفتگویی را آغاز کنید که هیچ‌کس دیگری نمی‌تواند ببیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on Rún — hiljainen, yksityinen ja sinun salaisuutesi. Lisää joku kasvokkain ja aloita keskustelu, jota kukaan muu ei näe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voilà Rún — discrète, privée, et à vous de la garder secrète. Ajoutez quelqu'un en personne, et commencez une conversation que personne d'autre ne peut voir."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоа е Rún — тивок, приватен и ваш, за да го чувате во тајност. Додадете некого лично и започнете разговор што никој друг не може да го види."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er Rún – stille, privat og din å holde hemmelig. Legg til noen ansikt til ansikt, og start en samtale ingen andre kan se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это и есть Rún — тихий, приватный и целиком ваш, чтобы хранить его в тайне. Добавьте кого-то лично и начните беседу, которую больше никто не увидит."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taasi waa Rún — aamusan, gaar ah, oo aad sir u haysan karto. Qof si toos ah ugu dar, oo bilow wada-hadal aan cid kale arki karin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är Rún — tyst, privat och din att hålla hemlig. Lägg till någon personligen och börja en konversation som ingen annan kan se."
          }
        }
      }
    },
    "about_ready_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز متى كنت جاهزًا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar, når du er"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit, wenn du es bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready when you are"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo cuando tú quieras"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر وقت آماده باشید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis, kun sinäkin olet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prête quand vous l'êtes"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготвен кога и вие сте"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar når du er klar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готов, когда готовы вы"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyaar marka aad diyaar tahay"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo när du är"
          }
        }
      }
    },
    "about_referrals_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد دليل بمن يستخدم Rún. بدلًا من ذلك، يمكن لشخص تثق به أصلًا أن يقدّمك إلى شخص يثق هو به — وأنت من يقرر القبول أو الرفض. الثقة تنتقل من شخص إلى شخص، ولا تمرّ أبدًا عبر خادم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes ingen fortegnelse over, hvem der bruger Rún. I stedet kan en, du allerede stoler på, introducere dig for en, de stoler på — og du vælger selv, om du vil sige ja. Tillid vandrer fra person til person, aldrig gennem en server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt kein Verzeichnis, wer bei Rún ist. Stattdessen kann jemand, dem du bereits vertraust, dich jemandem vorstellen, dem er vertraut — und du entscheidest, ob du annimmst. Vertrauen wandert von Mensch zu Mensch, nie über einen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no directory of who's on Rún. Instead, someone you already trust can introduce you to someone they trust — and you choose whether to accept. Trust travels person to person, never through a server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No existe ningún directorio de quién está en Rún. En su lugar, alguien en quien ya confías puede presentarte a alguien en quien confía, y tú decides si aceptas. La confianza viaja de persona a persona, nunca a través de un servidor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرستی از اینکه چه کسی در Rún است وجود ندارد. در عوض، کسی که از قبل به او اعتماد دارید می‌تواند شما را به کسی که خودش به او اعتماد دارد معرفی کند — و شما انتخاب می‌کنید که بپذیرید یا نه. اعتماد آدم‌به‌آدم سفر می‌کند، هرگز از راه یک سرور."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ei tarjoa hakemistoa siitä, kuka sitä käyttää. Sen sijaan joku, johon jo luotat, voi esitellä sinut jollekulle, johon hän luottaa — ja sinä päätät, hyväksytkö. Luottamus kulkee ihmiseltä ihmiselle, ei koskaan palvelimen kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'existe aucun annuaire des personnes présentes sur Rún. À la place, quelqu'un en qui vous avez déjà confiance peut vous présenter à quelqu'un en qui il a confiance — et vous choisissez d'accepter ou non. La confiance circule de personne à personne, jamais par un serveur."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема именик на тоа кој користи Rún. Наместо тоа, некој на кого веќе му верувате може да ве претстави на некој на кого исто така му верува — а вие избирате дали да прифатите. Довербата патува од личност до личност, никогаш преку сервер."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen katalog over hvem som er på Rún. I stedet kan noen du allerede stoler på, introdusere deg for noen de stoler på – og du velger selv om du vil takke ja. Tillit går fra person til person, aldri gjennom en server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Rún нет общего списка пользователей. Вместо этого человек, которому вы уже доверяете, может познакомить вас с тем, кому доверяет сам, — а принимать знакомство или нет, решаете вы. Доверие передаётся от человека к человеку, а не через сервер."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma jiro liis sheegaya cidda Rún isticmaasha. Taa beddelkeeda, qof aad hore ugu kalsoon tahay ayaa kuu soo bari kara qof uu isna ku kalsoon yahay — adiguna waxaad doorataa inaad aqbasho iyo in kale. Kalsoonidu waxay u socotaa qof ilaa qof, marnaba server kama gudubto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen katalog över vilka som använder Rún. I stället kan någon du redan litar på introducera dig för någon som de litar på — och du väljer själv om du vill acceptera. Förtroendet går från person till person, aldrig via en server."
          }
        }
      }
    },
    "about_referrals_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
