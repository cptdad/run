    "conversation_pending_banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار صندوق وارد جهة الاتصال هذه — ستتمكن من الإرسال بعد لحظات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på denne kontakts indbakke — du kan sende om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf das Postfach dieses Kontakts — du kannst gleich senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for this contact's inbox — you'll be able to send in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando el buzón de este contacto; podrás enviar en un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در انتظار صندوق ورودی این مخاطب — به‌زودی می‌توانید پیام بفرستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan tämän kontaktin postilaatikkoa — voit lähettää viestejä hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la boîte de réception de ce contact — vous pourrez envoyer dans un instant."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се чека сандачето на овој контакт — наскоро ќе можете да испраќате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på innboksen til denne kontakten – du kan sende om et øyeblikk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание почтового ящика этого контакта — вы сможете отправить сообщение через мгновение."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaa la sugayaa sanduuqa xiriiriyahan — dhowaan waad awoodi doontaa inaad fariin dirto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på kontaktens inkorg — du kan skicka om en stund."
          }
        }
      }
    },
    "conversation_ratchet_refused_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء قناة آمنة مع جهة الاتصال هذه. لا يتم إرسال الرسائل. احذف جهة الاتصال وأعد الاقتران."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke oprettes en sikker kanal med denne kontakt. Beskeder bliver ikke sendt. Fjern kontakten, og par jer igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Kontakt konnte kein sicherer Kanal aufgebaut werden. Nachrichten werden nicht gesendet. Entferne den Kontakt und führe die Kopplung erneut durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure channel could not be established with this contact. Messages are not being sent. Remove the contact and pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido establecer un canal seguro con este contacto. Los mensajes no se están enviando. Elimina el contacto y vuelve a emparejarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برقراری کانال امن با این مخاطب ممکن نشد. پیام‌ها ارسال نمی‌شوند. مخاطب را حذف کنید و دوباره جفت‌سازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattua kanavaa ei voitu muodostaa tämän kontaktin kanssa. Viestejä ei lähetetä. Poista kontakti ja tee paritus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'établir un canal sécurisé avec ce contact. Les messages ne sont pas envoyés. Supprimez le contact et appairez-vous à nouveau."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можеше да се воспостави безбеден канал со овој контакт. Пораките не се испраќаат. Избришете го контактот и спарете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opprette en sikker kanal med denne kontakten. Meldinger blir ikke sendt. Fjern kontakten og parkoble på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить защищённый канал с этим контактом. Сообщения не отправляются. Удалите контакт и выполните сопряжение заново."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama samayn karin kanaal ammaan ah oo aad xiriiriyahan la leedahay. Fariimaha lama dirayo. Xiriiriyaha tirtir, kadibna lammaanaanta mar kale samee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att upprätta en säker kanal med den här kontakten. Meddelanden skickas inte. Ta bort kontakten och parkoppla på nytt."
          }
        }
      }
    },
