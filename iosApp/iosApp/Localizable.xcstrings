          "stringUnit": {
            "state": "translated",
            "value": "Rún را باز نگه دارید — این کار روی Tor انجام می‌شود و کمی طول می‌کشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Rún auki — tämä tapahtuu Tor-verkon kautta ja kestää hetken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Rún ouvert — cette opération passe par Tor et prend un moment."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставете го Rún отворен — ова се одвива преку Tor и ќе потрае малку."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Rún åpen — dette går over Tor og tar en liten stund."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывайте Rún — это выполняется через Tor и может занять некоторое время."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún furan ku hay — tani waxay ku socotaa Tor, waxayna qaadanaysaa in yar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll Rún öppet — det här går via Tor och tar en liten stund."
          }
        }
      }
    },
