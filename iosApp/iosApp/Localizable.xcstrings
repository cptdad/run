    "burn_notice_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الرسائل مرة واحدة — هنا بالذات — ولا تُحفظ أبدًا. عندما تغادر هذه المحادثة، تختفي إلى الأبد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskeder vises én gang — lige her — og gemmes aldrig. Når du forlader denne samtale, er de væk for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten erscheinen ein einziges Mal — genau hier — und werden nie gespeichert. Wenn du diese Unterhaltung verlässt, sind sie für immer weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages appear once — right here — and are never saved. When you leave this conversation, they are gone for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes aparecen una vez, aquí mismo, y nunca se guardan. Cuando sales de esta conversación, desaparecen para siempre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام‌ها فقط یک بار ظاهر می‌شوند — همین‌جا — و هرگز ذخیره نمی‌شوند. وقتی این گفتگو را ترک کنید، برای همیشه از بین می‌روند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestit näkyvät kerran — juuri tässä — eikä niitä tallenneta koskaan. Kun poistut tästä keskustelusta, ne ovat lopullisesti poissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages n'apparaissent qu'une fois — ici même — et ne sont jamais enregistrés. Quand vous quittez cette conversation, ils disparaissent pour de bon."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пораките се појавуваат само еднаш — токму тука — и никогаш не се зачувуваат. Кога ќе го напуштите овој разговор, тие исчезнуваат засекогаш."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger vises én gang – akkurat her – og lagres aldri. Når du forlater denne samtalen, er de borte for godt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения появляются только один раз — прямо здесь — и никогда не сохраняются. Когда вы покидаете эту беседу, они исчезают навсегда."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fariimuhu waxay ka soo muuqdaan hal mar — halkan oo kale — mana kaydsana marnaba. Marka aad ka baxdo wada-hadalkan, si joogto ah ayay u baabba'aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden visas en gång — här — och sparas aldrig. När du lämnar konversationen är de borta för gott."
          }
        }
      }
    },
