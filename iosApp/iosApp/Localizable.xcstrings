    "ext_proxy_status_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة إعداد البروكسي الخارجي. المراسلة غير متاحة."
          }
        },
        "da": {
