    "create_group_precondition": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون كل شخص في المجموعة قد اقترن شخصيًا مع كل الآخرين. وأنت تزكّي ذلك عندما تنشئها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle i en gruppe skal være parret ansigt til ansigt med hinanden. Det går du god for, når du opretter den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle in einer Gruppe müssen sich persönlich mit allen anderen gekoppelt haben. Dafür bürgst du, wenn du sie erstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone in a group must have paired in person with everyone else. You are vouching for that when you create it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros de un grupo tienen que haberse emparejado en persona entre sí. Tú lo avalas al crearlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ اعضای یک گروه باید حضوری با یکدیگر جفت‌سازی کرده باشند. با ساختن گروه، شما ضامن این هستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkien ryhmän jäsenten on täytynyt tehdä paritus kasvokkain kaikkien muiden kanssa. Menet siitä takuuseen, kun luot ryhmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un groupe, chacun doit s'être appairé en personne avec tous les autres. Vous vous en portez garant en le créant."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сите во групата мора да се спарени лично едни со други. Вие гарантирате за тоа кога ја креирате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle i en gruppe må ha parkoblet ansikt til ansikt med alle andre. Du går god for det når du oppretter gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все участники группы должны лично выполнить сопряжение друг с другом. Создавая группу, вы ручаетесь за это."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qof kasta oo koox ku jira waa inuu si toos ah ula lammaanaadaa qof kale oo dhan. Taas waxaad dammaanad u tahay markaad abuurayso kooxda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla i en grupp måste ha parkopplat personligen med alla andra. Du går i god för det när du skapar den."
          }
        }
      }
    },
