    "protection_stop_no_lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في هاتفك %1$@، و«الحد الأقصى» وحده يستطيع حماية Rún هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon har ingen %1$@, så kun Maksimal kan beskytte Rún her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fehlt auf deinem Telefon, hier kann nur Maximum Rún schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone has no %1$@, only Maximum can protect Rún here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono no tiene %1$@; aquí solo Máximo puede proteger Rún."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی شما %1$@ ندارد؛ اینجا فقط «حداکثر» می‌تواند از Rún محافظت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimessasi ei ole %1$@, joten vain Maksimi voi suojata Rún-sovelluksen täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun %1$@ sur votre téléphone : seul Maximum peut protéger Rún ici."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот телефон нема %1$@, само Максимално може да го заштити Rún тука."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen din har ingen %1$@, bare Maksimal kan beskytte Rún her."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем телефоне отсутствует %1$@ — защитить Rún здесь может только уровень «Максимальный»."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankaagu ma laha %1$@, kaliya Ugu sarreeya ayaa Rún halkan ilaalin kara."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon saknar %1$@, bara Maximal kan skydda Rún här."
          }
        }
      }
    },
