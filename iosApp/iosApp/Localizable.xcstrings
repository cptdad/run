    "referral_introduce_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الاتصال بعد — حاول مجددًا بعد لحظات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke forbundet endnu — prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht verbunden — versuch es gleich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected yet — try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay conexión. Inténtalo dentro de un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز متصل نیستید — چند لحظهٔ دیگر دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyttä ei ole vielä — yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore connecté — réessayez dans un instant."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не сте поврзани — обидете се повторно за момент."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilkoblet ennå – prøv igjen om et øyeblikk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет подключения — попробуйте снова через мгновение."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli lama xidhiidhin — dib u isku day daqiiqad gudaheed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte ansluten än — försök igen om en stund."
          }
        }
      }
    },
