    "about_screen_privacy_body_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات الشاشة وتسجيل الشاشة ومعاينة التطبيقات الأخيرة كلها محجوبة، فلا يتسرّب شيء إلى معرض الصور أو مبدّل التطبيقات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder, skærmoptagelse og eksempelvisningen i oversigten over åbne apps er alle blokeret, så intet siver ud til dit galleri eller app-skifteren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, Bildschirmaufnahmen und die Vorschau in der App-Übersicht sind blockiert, damit nichts in deine Galerie oder in den App-Wechsler gelangt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, screen recording, and the recent-apps preview are all blocked, so nothing leaks to your gallery or the app switcher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla, la grabación de pantalla y la vista previa de apps recientes están bloqueadas, así que nada se filtra a tu galería ni al selector de apps."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین‌شات، ضبط صفحه و پیش‌نمایش برنامه‌های اخیر همگی مسدودند، پس چیزی به گالری یا صفحهٔ تعویض برنامه‌ها درز نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvakaappaukset, näytön tallennus ja viimeisimpien sovellusten esikatselu on kaikki estetty, joten mitään ei vuoda galleriaasi tai sovellusvalitsimeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d'écran, l'enregistrement de l'écran et l'aperçu dans les applications récentes sont tous bloqués : rien ne fuit vers votre galerie ni vers le sélecteur d'applications."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сликите од екранот, снимањето на екранот и прегледот на неодамнешни апликации се блокирани, така што ништо не истекува во вашата галерија или во листата на неодамнешни апликации."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermbilder, skjermopptak og forhåndsvisningen i appbytteren er blokkert, så ingenting lekker til galleriet eller appoversikten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты, запись экрана и превью в списке недавних приложений заблокированы, поэтому ничего не попадёт ни в галерею, ни в переключатель приложений."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Sawir-qaadka shaashadda, duubista shaashadda, iyo muuqaalka app-yada dhawaan la isticmaalay dhammaantood waa la xannibay, sidaa darteed waxba ma gaadhaan sawirradaada ama beddelaha app-yada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmdumpar, skärminspelning och förhandsvisningen bland senaste appar är alla blockerade, så inget läcker till ditt galleri eller appväxlaren."
          }
        }
      }
    },
    "about_screen_privacy_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة مبدّل التطبيقات وتسجيل الشاشة مُغطّيان. لا يستطيع iOS منع لقطة الشاشة اليدوية، فكن حذرًا في المحادثات الحساسة — وسيحذّرك Rún إذا التُقطت واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempelvisningen i app-skifteren og skærmoptagelse er dækket til. iOS kan ikke blokere et manuelt skærmbillede, så vær varsom med følsomme samtaler — Rún advarer dig, hvis der bliver taget et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau im App-Wechsler und Bildschirmaufnahmen sind abgedeckt. iOS kann einen manuellen Screenshot nicht verhindern, sei also bei heiklen Chats vorsichtig — Rún warnt dich, wenn einer gemacht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app-switcher preview and screen recording are covered. iOS can't block a manual screenshot, so take care with sensitive chats — Rún warns you if one is taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa del selector de apps y la grabación de pantalla están tapadas. iOS no puede bloquear una captura manual, así que ten cuidado en los chats delicados: Rún te avisa si alguien hace una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌نمایش در تعویض‌گر برنامه‌ها و ضبط صفحه پوشانده می‌شوند. iOS نمی‌تواند جلوی اسکرین‌شات دستی را بگیرد، پس در گفتگوهای حساس مراقب باشید — اگر اسکرین‌شاتی گرفته شود، Rún به شما هشدار می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellusvalitsimen esikatselu ja näytön tallennus on peitetty. iOS ei voi estää käsin otettua kuvakaappausta, joten ole varovainen arkaluontoisissa keskusteluissa — Rún varoittaa sinua, jos sellainen otetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu du sélecteur d'apps et l'enregistrement de l'écran sont masqués. iOS ne peut pas empêcher une capture d'écran manuelle : soyez donc prudent dans les discussions sensibles — Rún vous prévient si quelqu'un en prend une."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледот на неодамнешни апликации и снимањето на екранот се покриени. iOS не може да блокира рачна слика од екранот, затоа бидете внимателни со чувствителни разговори — Rún ве предупредува ако е направена таква слика."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisningen i appbytteren og skjermopptak er tildekket. iOS kan ikke blokkere et manuelt skjermbilde, så vær forsiktig i sensitive samtaler – Rún varsler deg hvis noen tar et."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превью в переключателе приложений и запись экрана скрыты. iOS не может заблокировать ручной снимок экрана, поэтому будьте осторожны в конфиденциальных переписках — Rún предупредит вас, если снимок всё же будет сделан."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuqaalka beddelaha app-yada iyo duubista shaashadda waa la daboolay. iOS ma xannibi karo sawir-qaad shaashadeed oo gacanta lagu qaado, sidaa darteed taxaddar la yeelo sheekaysiga xasaasiga ah — Rún wuu kuu digayaa haddii mid la qaado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsvisningen i appväxlaren och skärminspelning är övertäckta. iOS kan inte blockera en manuell skärmdump, så var försiktig i känsliga chattar — Rún varnar dig om någon tas."
          }
        }
      }
    },
    "about_screen_privacy_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصوصية الشاشة"
          }
        },
        "da": {
