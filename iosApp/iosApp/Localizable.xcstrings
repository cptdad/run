    "protection_downgrade_message_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل إلى «%1$@» يجعل هاتفك أسهل اختراقًا إذا أُخذ منك. هل تريد المتابعة؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter du til %1$@, bliver din telefon lettere at bryde ind i, hvis den bliver taget. Vil du fortsætte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel zu %1$@ macht dein Telefon leichter zu knacken, falls es dir abgenommen wird. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to %1$@ makes your phone easier to crack if it’s taken. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a %1$@ hace que tu teléfono sea más fácil de forzar si te lo quitan. ¿Continuar?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با تغییر به %1$@، اگر گوشی‌تان به دست دیگران بیفتد، شکستن آن آسان‌تر می‌شود. ادامه می‌دهید؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihto tasolle %1$@ tekee puhelimestasi helpomman murtaa, jos se viedään. Jatketaanko?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à %1$@ rend votre téléphone plus facile à forcer s'il vous est pris. Continuer ?"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Префрлањето на %1$@ го прави вашиот телефон полесен за разбивање ако биде одземен. Да продолжите?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bytte til %1$@ gjør telefonen lettere å knekke hvis den blir tatt. Vil du fortsette?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход на «%1$@» облегчит взлом вашего телефона, если его изымут. Продолжить?"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "U beddelka %1$@ wuxuu ka dhigayaa taleefankaaga mid si fudud loo jabin karo haddii la qaato. Sii wad?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter du till %1$@ blir telefonen lättare att knäcka om den beslagtas. Fortsätta?"
          }
        }
      }
    },
    "protection_downgrade_message_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل إلى «%1$@» يجعل هاتفك أسهل اختراقًا إذا أُخذ منك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter du til %1$@, bliver din telefon lettere at bryde ind i, hvis den bliver taget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel zu %1$@ macht dein Telefon leichter zu knacken, falls es dir abgenommen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to %1$@ makes your phone easier to crack if it’s taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a %1$@ hace que tu teléfono sea más fácil de forzar si te lo quitan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با تغییر به %1$@، اگر گوشی‌تان به دست دیگران بیفتد، شکستن آن آسان‌تر می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihto tasolle %1$@ tekee puhelimestasi helpomman murtaa, jos se viedään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à %1$@ rend votre téléphone plus facile à forcer s'il vous est pris."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Префрлањето на %1$@ го прави вашиот телефон полесен за разбивање ако биде одземен."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bytte til %1$@ gjør telefonen lettere å knekke hvis den blir tatt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход на «%1$@» облегчит взлом вашего телефона, если его изымут."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "U beddelka %1$@ wuxuu ka dhigayaa taleefankaaga mid si fudud loo jabin karo haddii la qaato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter du till %1$@ blir telefonen lättare att knäcka om den beslagtas."
          }
        }
      }
    },
