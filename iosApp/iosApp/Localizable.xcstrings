    "contact_list_delete_contact_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جهة الاتصال هذه وكل الرسائل المرتبطة بها نهائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det sletter denne kontakt og alle tilhørende beskeder permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dieser Kontakt und alle zugehörigen Nachrichten endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete this contact and all associated messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará de forma permanente este contacto y todos los mensajes asociados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار این مخاطب و همهٔ پیام‌های مرتبط با او را برای همیشه حذف می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tämän kontaktin ja kaikki siihen liittyvät viestit pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement ce contact et tous les messages associés."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова трајно ќе го избрише овој контакт и сите поврзани пораки."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter kontakten og alle tilhørende meldinger for godt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит контакт и все связанные с ним сообщения."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tani waxay si joogto ah u tirtiri doontaa xiriiriyahan iyo dhammaan fariimaha la xidhiidha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här raderar kontakten och alla tillhörande meddelanden permanent."
          }
        }
      }
    },
