    "move_kept_off_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد Rún يرسل أو يستقبل هنا. امحُه متى شئت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún sender og modtager ikke længere her. Slet den, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún sendet und empfängt hier nicht mehr. Lösch es, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún no longer sends or receives here. Wipe it whenever you are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ya no envía ni recibe aquí. Bórralo cuando estés listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún دیگر اینجا چیزی ارسال یا دریافت نمی‌کند. هر وقت آماده بودید آن را پاک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ei enää lähetä tai vastaanota täällä. Pyyhi se, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún n'envoie ni ne reçoit plus rien ici. Effacez-le quand vous serez prêt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún повеќе не испраќа и не прима тука. Избришете го телефонот кога ќе бидете подготвени."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún sender eller mottar ikke lenger her. Slett den når du er klar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún больше не отправляет и не получает сообщения на этом телефоне. Сотрите его, когда будете готовы."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún hadda halkan wax kama diro, waxna kama helo. Tirtir markastoo aad diyaar tahay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún varken skickar eller tar emot här längre. Radera den när du är redo."
          }
        }
      }
    },
