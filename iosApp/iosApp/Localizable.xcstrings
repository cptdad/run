    "pin_use_recovery_code_prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح القفل؟ استخدم رمز الاسترداد"
          }
