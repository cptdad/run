    "referral_offer_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد %1$@ تقديمك إلى «%2$@». وافق لإضافته كجهة اتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vil introducere dig for “%2$@”. Godkend for at tilføje dem som kontakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ möchte dich „%2$@“ vorstellen. Bestätige, um die Person als Kontakt hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wants to introduce you to “%2$@”. Approve to add them as a contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ quiere presentarte a “%2$@”. Aprueba la solicitud para añadir a esa persona a tus contactos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ می‌خواهد شما را به «%2$@» معرفی کند. برای افزودن او به مخاطبان، تأیید کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ haluaa esitellä sinut henkilölle ”%2$@”. Hyväksy, niin hänet lisätään kontaktiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ souhaite vous présenter « %2$@ ». Approuvez pour l'ajouter à vos contacts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сака да ве претстави на „%2$@“. Одобрете за да ги додадете како контакт."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vil introdusere deg for «%2$@». Godkjenn for å legge vedkommende til som kontakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет познакомить вас с «%2$@». Подтвердите, чтобы добавить этот контакт."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaa jira codsi ka yimid %1$@ oo ah in lagu soo baro “%2$@”. Ansixi si aad xiriiriye ahaan ugu darto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vill introducera dig för ”%2$@”. Godkänn för att lägga till personen som kontakt."
          }
        }
      }
    },
