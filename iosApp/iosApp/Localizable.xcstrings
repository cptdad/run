    "add_contact_announce_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن من مراسلتك بعد لحظات — يُسلَّم صندوق واردك تلقائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan skrive til dig om et øjeblik — din indbakke bliver leveret automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kontakt kann dir gleich schreiben — dein Postfach wird automatisch zugestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll be able to message you in a moment — your inbox is delivered automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá escribirte en un momento: tu buzón se entrega automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "او به‌زودی می‌تواند برای شما پیام بفرستد — صندوق ورودی شما به‌طور خودکار تحویل می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hän voi lähettää sinulle viestejä hetken kuluttua — postilaatikkosi toimitetaan automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre contact pourra vous écrire dans un instant — votre boîte de réception lui est transmise automatiquement."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскоро ќе можат да ви пишуваат — вашето сандаче се доставува автоматски."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan sende deg meldinger om et øyeblikk – innboksen din leveres automatisk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совсем скоро ваш контакт сможет вам написать — доступ к вашему почтовому ящику передаётся автоматически."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wax yar ka dib waxay awoodi doonaan inay fariin kuu soo diraan — sanduuqaaga si toos ah ayaa loo gudbinayaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan skriva till dig om en stund — din inkorg levereras automatiskt."
          }
        }
      }
    },
