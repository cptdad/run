    "protection_recovery_attempt_record_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل المحاولة — مفتاح الجهاز مشغول. حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke registrere forsøget — enhedsnøglen er optaget. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versuch konnte nicht erfasst werden — der Geräteschlüssel ist beschäftigt. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't record the attempt — the device key is busy. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido registrar el intento: la clave del dispositivo está ocupada. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت این تلاش ممکن نشد — کلید دستگاه مشغول است. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritystä ei voitu kirjata — laiteavain on varattu. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la tentative — la clé de l'appareil est occupée. Réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидот не можеше да се забележи — клучот на уредот е зафатен. Обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke registrere forsøket – enhetsnøkkelen er opptatt. Prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать попытку — аппаратный ключ занят. Попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isku daygii lama duubi karin — furaha qalabku wuu mashquulsan yahay. Isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte registrera försöket — enhetsnyckeln är upptagen. Försök igen."
          }
        }
      }
    },
