    "add_contact_scan_deadlock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز الظاهر على شاشة «على وشك الانتهاء» لدى جهة اتصالك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan koden på deres “Næsten der”-skærm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code auf dem Bildschirm „Fast geschafft“ deines Kontakts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code on their “Almost there” screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código de su pantalla “Casi listo”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کدِ روی صفحهٔ «تقریباً تمام شد» او را اسکن کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue koodi hänen ”Melkein perillä” -näkymästään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code sur son écran « Presque terminé »"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скенирајте го кодот на нивниот екран „Речиси готово“"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann koden på skjermen deres der det står «Nesten der»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код с экрана «Почти готово» вашего контакта"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka sawir gareyso koodhka ku yaal shaashaddooda ee “Ku dhawaad dhammaatay”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna koden på deras skärm ”Nästan där”"
          }
        }
