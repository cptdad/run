    "protection_recovery_ack_hint_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع علامة على «لقد كتبته» للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt flueben i “Jeg har skrevet den ned” for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze das Häkchen bei „Ich habe ihn aufgeschrieben“, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick “I’ve written it down” to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca “Lo he apuntado” para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامه، تیک «یادداشتش کردم» را بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastita ”Olen kirjoittanut sen ylös” jatkaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez « Je l'ai noté » pour continuer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Означете „Го запишав“ за да продолжите."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryss av for «Jeg har skrevet den ned» for å fortsette."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте «Код записан», чтобы продолжить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Calaamadee “Waan qoray” si aad u sii wadato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryssa i ”Jag har skrivit ner den” för att fortsätta."
          }
        }
      }
    },
