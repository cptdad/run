    "notif_settings_no_distributor_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الهاتف على خدمات Google، لذا تحتاج الإشعارات إلى تطبيق موزّع UnifiedPush. ثبّت واحدًا — ntfy هو الخيار الموصى به — ثم عد إلى هنا وشغّل الإشعارات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefon har ingen Google-tjenester, så notifikationer kræver en UnifiedPush-distributørapp. Installér en — ntfy er den anbefalede — og kom så tilbage hertil og slå notifikationer til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat keine Google-Dienste, deshalb brauchen Benachrichtigungen eine UnifiedPush-Distributor-App. Installiere eine — ntfy ist die empfohlene Wahl — komm dann hierher zurück und schalte Benachrichtigungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Google services, so notifications need a UnifiedPush distributor app. Install one — ntfy is the recommended choice — then come back here and turn notifications on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no lleva servicios de Google, así que las notificaciones necesitan una app distribuidora de UnifiedPush. Instala una (ntfy es la opción recomendada) y vuelve aquí para activar las notificaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گوشی سرویس‌های Google را ندارد، پس اعلان‌ها به یک برنامهٔ توزیع‌کنندهٔ UnifiedPush نیاز دارند. یکی نصب کنید — ntfy گزینهٔ پیشنهادی است — سپس به اینجا برگردید و اعلان‌ها را روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä puhelimessa ei ole Google-palveluita, joten ilmoitukset tarvitsevat UnifiedPush-välittäjäsovelluksen. Asenna sellainen — ntfy on suositeltu vaihtoehto — ja palaa sitten tänne ottamaan ilmoitukset käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne contient aucun service Google : les notifications nécessitent donc une application distributrice UnifiedPush. Installez-en une — ntfy est le choix recommandé — puis revenez ici pour activer les notifications."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој телефон нема Google-услуги, па известувањата бараат апликација-дистрибутер за UnifiedPush. Инсталирајте една — ntfy е препорачаниот избор — па вратете се тука и вклучете ги известувањата."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefonen har ingen Google-tjenester, så varsler krever en UnifiedPush-distributørapp. Installer en – ntfy er den anbefalte – og kom så tilbake hit og slå på varsler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет сервисов Google, поэтому для уведомлений нужно приложение-дистрибьютор UnifiedPush. Установите такое приложение — рекомендуем ntfy — и вернитесь сюда, чтобы включить уведомления."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankan ma laha adeegyada Google, sidaa darteed ogeysiisyadu waxay u baahan yihiin app qaybiye UnifiedPush ah. Rakib mid — ntfy waa doorashada lagula talinayo — kadibna halkan ku soo noqo oo shid ogeysiisyada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här telefonen har inga Google-tjänster, så notiser kräver en app som fungerar som UnifiedPush-distributör. Installera en — ntfy är det rekommenderade valet — och kom sedan tillbaka hit och slå på notiser."
          }
        }
      }
    },
    "notif_settings_register_error_distributor_refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض موزّع الإشعارات لديك التسجيل. افتحه وتأكد من إعداده ثم حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notifikationsdistributør afviste registreringen. Åbn den, tjek at den er sat op, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Benachrichtigungs-Distributor hat die Registrierung abgelehnt. Öffne ihn, prüfe seine Einrichtung und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notification distributor refused the registration. Open it, check it's set up, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu distribuidor de notificaciones ha rechazado el registro. Ábrelo, comprueba que está configurado y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توزیع‌کنندهٔ اعلان شما ثبت‌نام را رد کرد. آن را باز کنید، از راه‌اندازی‌اش مطمئن شوید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välittäjäsovelluksesi hylkäsi rekisteröinnin. Avaa se, tarkista, että se on määritetty, ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre distributeur de notifications a refusé l'inscription. Ouvrez-le, vérifiez sa configuration, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот дистрибутер за известувања ја одби регистрацијата. Отворете го, проверете дали е поставен и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varseldistributøren din avviste registreringen. Åpne den, sjekk at den er satt opp, og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибьютор уведомлений отклонил регистрацию. Откройте его, проверьте настройку и повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaybiyaha ogeysiiskaagu wuu diiday diiwaan gelinta. Fur, hubi in la dejiyay, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notisdistributör nekade registreringen. Öppna den, kontrollera att den är konfigurerad och försök igen."
          }
        }
      }
    },
    "notif_settings_register_error_distributor_selection": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بموزّع الإشعارات لديك. أغلق Rún تمامًا وأعد فتحه، ثم حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få forbindelse til din notifikationsdistributør. Luk Rún helt, åbn appen igen, og prøv en gang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu deinem Benachrichtigungs-Distributor ist fehlgeschlagen. Schließe Rún vollständig, öffne es erneut und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to your notification distributor. Close Rún fully and reopen it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con tu distribuidor de notificaciones. Cierra Rún del todo, vuelve a abrirlo e inténtalo otra vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال به توزیع‌کنندهٔ اعلان شما ممکن نشد. Rún را کاملاً ببندید و دوباره باز کنید، سپس دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välittäjäsovellukseen ei saatu yhteyttä. Sulje Rún kokonaan, avaa se uudelleen ja yritä sitten uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter à votre distributeur de notifications. Fermez complètement Rún et rouvrez-la, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успеа поврзувањето со вашиот дистрибутер за известувања. Затворете го Rún целосно и отворете го повторно, па обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke koble til varseldistributøren din. Lukk Rún helt, åpne appen på nytt, og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к дистрибьютору уведомлений. Полностью закройте Rún и откройте его снова, затем повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama xidhiidhi karin qaybiyaha ogeysiiskaaga. Si buuxda u xir Rún oo dib u fur, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte ansluta till din notisdistributör. Stäng Rún helt och öppna appen igen, och försök sedan på nytt."
          }
        }
      }
    },
    "notif_settings_register_error_generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التسجيل للإشعارات. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke registrere dig til notifikationer. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung für Benachrichtigungen ist fehlgeschlagen. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't register for notifications. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar el registro para las notificaciones. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت‌نام برای اعلان‌ها انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksia ei voitu rekisteröidä. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de s'inscrire aux notifications. Vérifiez votre connexion et réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не успеа регистрацијата за известувања. Проверете ја врската и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke registrere deg for varsler. Sjekk forbindelsen og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрироваться для получения уведомлений. Проверьте подключение и повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma diiwaan gelin karin ogeysiisyada. Hubi xidhiidhkaaga oo isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte registrera för notiser. Kontrollera din anslutning och försök igen."
          }
        }
      }
    },
    "notif_settings_register_error_no_distributor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُختَر أي موزّع إشعارات. ثبّت ntfy من F-Droid ثم حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke valgt nogen notifikationsdistributør. Installér ntfy fra F-Droid, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Benachrichtigungs-Distributor ausgewählt. Installiere ntfy aus F-Droid und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notification distributor was selected. Install ntfy from F-Droid, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha seleccionado ningún distribuidor de notificaciones. Instala ntfy desde F-Droid y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ توزیع‌کنندهٔ اعلانی انتخاب نشده است. ntfy را از F-Droid نصب کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välittäjäsovellusta ei ole valittu. Asenna ntfy F-Droidista ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun distributeur de notifications n'a été sélectionné. Installez ntfy depuis F-Droid, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е избран дистрибутер за известувања. Инсталирајте ntfy од F-Droid, па обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen varseldistributør ble valgt. Installer ntfy fra F-Droid, og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выбран дистрибьютор уведомлений. Установите ntfy из F-Droid и повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wax qaybiye ogeysiis ah lama dooran. F-Droid ka rakib ntfy, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen notisdistributör valdes. Installera ntfy från F-Droid och försök igen."
          }
        }
      }
    },
    "notif_settings_register_error_no_endpoint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب موزّع الإشعارات لديك في الوقت المناسب. افتحه وتأكد من أنه متصل ثم حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notifikationsdistributør svarede ikke i tide. Åbn den, sørg for at den er forbundet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Benachrichtigungs-Distributor hat nicht rechtzeitig geantwortet. Öffne ihn, stelle sicher, dass er verbunden ist, und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notification distributor didn't respond in time. Open it, make sure it's connected, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu distribuidor de notificaciones no ha respondido a tiempo. Ábrelo, asegúrate de que está conectado y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توزیع‌کنندهٔ اعلان شما به‌موقع پاسخ نداد. آن را باز کنید، مطمئن شوید متصل است و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välittäjäsovelluksesi ei vastannut ajoissa. Avaa se, varmista, että se on yhteydessä, ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre distributeur de notifications n'a pas répondu à temps. Ouvrez-le, assurez-vous qu'il est connecté, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот дистрибутер за известувања не одговори навреме. Отворете го, проверете дали е поврзан и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varseldistributøren din svarte ikke i tide. Åpne den, sjekk at den er tilkoblet, og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибьютор уведомлений не ответил вовремя. Откройте его, убедитесь, что он подключён, и повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaybiyaha ogeysiiskaagu wax kuma jawaabin waqtiga. Fur, hubi in uu xiriir la leeyahay, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notisdistributör svarade inte i tid. Öppna den, se till att den är ansluten och försök igen."
          }
        }
      }
    },
    "notif_settings_register_error_vapid_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم الإشعارات الفورية لهذا الموزّع غير مدعوم بعد — فهو يتطلب VAPID. يعمل ntfy جيدًا؛ ويمكنك تثبيته من F-Droid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne distributørs pushserver understøttes ikke endnu — den kræver VAPID. ntfy virker; du kan installere den fra F-Droid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Push-Server dieses Distributors wird noch nicht unterstützt — er benötigt VAPID. ntfy funktioniert; du kannst es aus F-Droid installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This distributor's push server isn't supported yet — it requires VAPID. ntfy works; you can install it from F-Droid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor push de este distribuidor todavía no es compatible: requiere VAPID. ntfy sí funciona; puedes instalarlo desde F-Droid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور پوش این توزیع‌کننده هنوز پشتیبانی نمی‌شود — به VAPID نیاز دارد. ntfy کار می‌کند؛ می‌توانید آن را از F-Droid نصب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän välittäjäsovelluksen push-palvelinta ei vielä tueta — se vaatii VAPIDin. ntfy toimii; voit asentaa sen F-Droidista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur push de ce distributeur n'est pas encore pris en charge — il exige VAPID. ntfy fonctionne ; vous pouvez l'installer depuis F-Droid."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-серверот на овој дистрибутер сè уште не е поддржан — бара VAPID. ntfy работи; можете да го инсталирате од F-Droid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-serveren til denne distributøren støttes ikke ennå – den krever VAPID. ntfy fungerer, og du kan installere den fra F-Droid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-сервер этого дистрибьютора пока не поддерживается — ему требуется VAPID. ntfy подходит; его можно установить из F-Droid."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Server-ka push-ka ee qaybiyahan weli lama taageero — waxa loo baahan yahay VAPID. ntfy wuu shaqeeyaa; waxaad ka rakibi kartaa F-Droid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributörens pushserver stöds inte än — den kräver VAPID. ntfy fungerar och kan installeras från F-Droid."
          }
        }
      }
    },
