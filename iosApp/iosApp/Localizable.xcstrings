    "about_e2e_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل رسالة مُحكمة الإغلاق بمفتاح لا يملكه سواك أنت وجهة اتصالك، ومع استمرار المحادثة يتقدّم هذا المفتاح خطوة بعد خطوة — فحتى لو انكشف مفتاح واحد تبقى البقية مُحكمة الإغلاق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver besked forsegles med en nøgle, som kun du og din kontakt har, og mens I skriver videre, drejer nøglen fremad — så selv hvis én nøgle skulle blive afsløret, forbliver resten forseglet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nachricht wird mit einem Schlüssel versiegelt, den nur du und dein Kontakt besitzen, und je länger ihr schreibt, desto weiter rückt dieser Schlüssel vor — wird also ein einzelner Schlüssel offengelegt, bleibt der Rest trotzdem versiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every message is sealed with a key only you and your contact hold, and as you keep chatting that key ratchets forward — so exposing a single key still leaves the rest sealed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mensaje se sella con una clave que solo tenéis tu contacto y tú, y a medida que seguís hablando esa clave avanza sin volver atrás, así que exponer una sola clave deja el resto igual de sellado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر پیام با کلیدی مهر و موم می‌شود که فقط شما و مخاطبتان دارید، و هر چه گفتگو ادامه پیدا کند این کلید گام‌به‌گام جلو می‌رود — پس حتی لو رفتن یک کلید، بقیه را همچنان مهر و موم‌شده باقی می‌گذارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen viesti sinetöidään avaimella, joka on vain sinulla ja kontaktillasi, ja keskustelun jatkuessa avain kiertyy eteenpäin — joten yhden avaimen paljastuminen jättää loput silti sinetöidyiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque message est scellé avec une clé que vous et votre contact êtes seuls à détenir, et, à mesure que la conversation avance, cette clé progresse d'un cran — de sorte que l'exposition d'une seule clé laisse tout le reste scellé."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секоја порака е заклучена со клуч што само вие и вашиот контакт го поседувате, а како што разговарате, тој клуч постојано напредува — така што откривањето само на еден клуч ги остава сите останати заклучени."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver melding forsegles med en nøkkel bare du og kontakten din har, og etter hvert som dere prater, skrus nøkkelen videre – så selv om én nøkkel skulle bli avslørt, forblir resten forseglet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое сообщение запечатано ключом, который есть только у вас и вашего собеседника, и по мере переписки этот ключ обновляется — поэтому даже если один ключ будет раскрыт, остальные останутся запечатанными."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fariin kasta waxaa lagu xidhaa fure aad adiga iyo xiriiriyahaaga uun haysataan, marka aad sii wadato sheekaysigana furahaasi ratchet ayuu ku sii gudbaa — sidaa darteed haddii fure keliya la ogaado, kuwa kale weli way sirsan yihiin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje meddelande förseglas med en nyckel som bara du och din kontakt har, och medan ni fortsätter chatta vrids den nyckeln framåt — så även om en enskild nyckel exponeras förblir resten förseglad."
          }
        }
      }
    },
