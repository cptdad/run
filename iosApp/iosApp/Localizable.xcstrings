    "pin_erase_start_over": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحو والبدء من جديد"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet, og start forfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen und neu beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase and start over"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar y empezar de cero"
          }
        },
        "fa": {
