    "settings_language_restart_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يُعيد Rún التشغيل لتغيير لغة التطبيق إلى %1$@. المتابعة؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún skal genstarte for at skifte appens sprog til %1$@. Fortsæt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún muss neu starten, um die App-Sprache auf %1$@ umzustellen. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún needs to restart to switch the app's language to %1$@. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún debe reiniciarse para cambiar el idioma de la app a %1$@. ¿Continuar?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر زبان برنامه به %1$@، لازم است Rún دوباره راه‌اندازی شود. ادامه می‌دهید؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún on käynnistettävä uudelleen, jotta sovelluksen kieleksi vaihtuu %1$@. Jatketaanko?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún doit redémarrer pour changer la langue de l'application en %1$@. Continuer ?"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún треба да се рестартира за да го смени јазикот на апликацијата на %1$@. Да продолжите?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún må starte på nytt for å bytte appens språk til %1$@. Fortsette?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún необходимо перезапустить, чтобы изменить язык приложения на %1$@. Продолжить?"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún waa inuu dib u bilaabo si uu luqadda app-ka ugu beddelo %1$@. Sii wad?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún måste startas om för att byta appens språk till %1$@. Fortsätta?"
          }
        }
      }
    },
