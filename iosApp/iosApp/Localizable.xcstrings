    "move_explain_moves_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهات اتصالك ومجموعاتك والمفاتيح التي تقوم عليها محادثاتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine kontakter, dine grupper og de nøgler, dine samtaler kører på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kontakte, deine Gruppen und die Schlüssel, auf denen deine Unterhaltungen laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts, your groups, and the keys your conversations run on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus contactos, tus grupos y las claves con las que funcionan tus conversaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخاطبان، گروه‌ها و کلیدهایی که گفت‌وگوهایتان بر پایهٔ آن‌ها کار می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteystietosi, ryhmäsi ja avaimet, joiden varassa keskustelusi toimivat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos contacts, vos groupes et les clés sur lesquelles reposent vos conversations."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите контакти, вашите групи и клучевите на кои се засноваат вашите разговори."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktene dine, gruppene dine og nøklene samtalene dine bygger på."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши контакты, группы и ключи, обеспечивающие работу ваших бесед."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiriirradaada, kooxahaaga, iyo furayaasha ay wadahadalladaadu ku shaqeeyaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina kontakter, dina grupper och nycklarna som dina konversationer bygger på."
          }
        }
      }
    },
    "move_explain_moves_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يُنقل"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad flytter med"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was übertragen wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se mueve"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چه چیزهایی منتقل می‌شود"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä siirtyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est transféré"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Што се преместува"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva som flyttes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что переносится"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxa la wareejinayo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad som flyttas"
          }
        }
      }
    },
    "move_explain_stays_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز الاسترداد، والحماية عبر %1$@، والإشعارات. أعِد إعدادها على الهاتف الجديد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gendannelseskode, %1$@ beskyttelse og notifikationer. Sæt dem op igen på den nye telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wiederherstellungscode, der %1$@-Schutz und Benachrichtigungen. Richte das auf dem neuen Handy erneut ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery code, %1$@ protection, and notifications. Set those up again on the new phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código de recuperación, la protección %1$@ y las notificaciones. Vuelve a configurarlos en el teléfono nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد بازیابی، حفاظت %1$@ و اعلان‌ها. آن‌ها را روی گوشی جدید دوباره تنظیم کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautuskoodisi, %1$@-suojaus ja ilmoitukset. Määritä ne uudelleen uudella puhelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre code de récupération, la protection %1$@ et les notifications. Reconfigurez-les sur le nouveau téléphone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот код за обновување, заштитата на ниво %1$@ и известувањата. Поставете ги повторно на новиот телефон."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettingskoden din, %1$@-beskyttelse og varsler. Sett disse opp på nytt på den nye telefonen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код восстановления, защита «%1$@» и уведомления. Настройте их заново на новом телефоне."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodhkaaga soo-celinta, ilaalinta %1$@, iyo ogeysiisyada. Kuwaas mar kale ka dejiso taleefanka cusub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din återställningskod, skyddsnivån %1$@ och aviseringar. Konfigurera dem igen på den nya telefonen."
          }
        }
      }
    },
    "move_explain_stays_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي لا يُنقل"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad flytter ikke med"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was nicht übertragen wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does not move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué no se mueve"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چه چیزهایی منتقل نمی‌شود"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä ei siirry"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui n'est pas transféré"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Што не се преместува"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva som ikke flyttes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что не переносится"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxa aan la wareejinayn"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad som inte flyttas"
          }
        }
      }
    },
    "move_explain_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل إلى هاتف جديد"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt til en ny telefon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein neues Handy übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to a new phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a un teléfono nuevo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقال به گوشی جدید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry uuteen puhelimeen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer vers un nouveau téléphone"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Преместување на нов телефон"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt til en ny telefon"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос на новый телефон"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "U wareeji taleefan cusub"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta till en ny telefon"
          }
        }
      }
    },
    "move_explain_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقّف هذا الهاتف عن الإرسال والاستقبال فور بدئك، ويبقى كذلك حتى تمحوه أو تُلغي النقل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefon holder op med at sende og modtage, så snart du starter, og forbliver sådan, indtil du sletter den eller annullerer flytningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy stellt Senden und Empfangen ein, sobald du startest, und bleibt so, bis du es löschst oder die Übertragung abbrichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone stops sending and receiving the moment you start, and stays that way until you wipe it or cancel the move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto empieces, este teléfono deja de enviar y recibir, y seguirá así hasta que lo borres o canceles el traslado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گوشی به‌محض شروع، ارسال و دریافت را متوقف می‌کند و تا زمانی که آن را پاک کنید یا انتقال را لغو کنید همین‌طور می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä puhelin lakkaa lähettämästä ja vastaanottamasta heti, kun aloitat, ja pysyy sellaisena, kunnes pyyhit sen tai peruutat siirron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone cesse d'envoyer et de recevoir dès que vous démarrez le transfert, et le reste jusqu'à ce que vous l'effaciez ou annuliez le transfert."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој телефон престанува да испраќа и да прима во моментот кога ќе почнете и останува така додека не го избришете или не го откажете преместувањето."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefonen slutter å sende og motta i det du starter, og forblir slik til du sletter den eller avbryter flyttingen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон перестаёт отправлять и получать сообщения, как только вы начнёте перенос, и остаётся в этом состоянии, пока вы не сотрёте его данные или не отмените перенос."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankani wuu joojinayaa dirista iyo helitaanka fariimaha isla markaad billowdo, sidaasna wuu ku sii ahaanayaa ilaa aad tirtirto ama aad joojiso wareejinta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här telefonen slutar skicka och ta emot i samma stund du börjar, och förblir så tills du raderar den eller avbryter flytten."
          }
        }
      }
    },
    "move_from_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الهاتف القديم، افتح قائمة الإعدادات، واضغط «النقل إلى جهاز جديد»، ثم امسح الرمز الذي يعرضه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn indstillingsmenuen på den gamle telefon, tryk på “Flyt til ny enhed”, og scan koden, den viser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf dem alten Handy das Einstellungsmenü, tippe auf „Auf neues Gerät übertragen“ und scanne den angezeigten Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the old phone, open the settings menu, tap “Move to new device”, and scan the code it shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teléfono antiguo, abre el menú de ajustes, toca “Mover a un dispositivo nuevo” y escanea el código que aparece."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی گوشی قدیمی، منوی تنظیمات را باز کنید، «انتقال به دستگاه جدید» را بزنید و کدی را که نشان می‌دهد اسکن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa vanhalla puhelimella asetusvalikko, napauta ”Siirrä uuteen laitteeseen” ja lue näytetty koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'ancien téléphone, ouvrez le menu des réglages, appuyez sur « Transférer vers un nouvel appareil », puis scannez le code affiché."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На стариот телефон отворете го менито Поставки, допрете „Премести на нов уред“ и скенирајте го кодот што го прикажува."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På den gamle telefonen åpner du innstillingsmenyen, trykker på «Flytt til ny enhet» og skanner koden som vises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На старом телефоне откройте меню настроек, нажмите «Перенести на новое устройство» и отсканируйте появившийся код."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefanka hore, fur liiska dejinta, taabo “U wareeji qalab cusub”, kadibna sawir garee koodhka uu ku tusayo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna inställningsmenyn på den gamla telefonen, tryck på ”Flytta till ny enhet” och skanna koden som visas."
          }
        }
      }
    },
    "move_from_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل من هاتف آخر"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt fra en anden telefon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einem anderen Handy übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move from another phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover desde otro teléfono"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقال از گوشی دیگر"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä toiselta puhelimelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer depuis un autre téléphone"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Премести од друг телефон"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt fra en annen telefon"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос с другого телефона"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka wareeji taleefan kale"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta från en annan telefon"
          }
        }
      }
    },
    "move_frozen_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ نقل من هنا، لذا لم يعد Rún يرسل أو يستقبل على هذا الهاتف. اعرض رمزًا جديدًا لإتمام النقل، أو ألغِ النقل لاستخدام هذا الهاتف مجددًا، أو امحُه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En flytning blev startet her, så Rún hverken sender eller modtager på denne telefon længere. Vis en ny kode for at fuldføre flytningen, annullér for at bruge denne telefon igen, eller slet den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wurde eine Übertragung gestartet, deshalb sendet und empfängt Rún auf diesem Handy nicht mehr. Zeig einen neuen Code, um die Übertragung abzuschließen, brich sie ab, um dieses Handy wieder zu nutzen, oder lösch es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A move was started here, so Rún no longer sends or receives on this phone. Show a fresh code to finish the move, cancel to use this phone again, or wipe it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se inició un traslado, así que Rún ya no envía ni recibe en este teléfono. Muestra un código nuevo para terminar el traslado, cancela para volver a usar este teléfono, o bórralo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقالی از اینجا شروع شده است، بنابراین Rún دیگر روی این گوشی چیزی ارسال یا دریافت نمی‌کند. برای تکمیل انتقال کد تازه‌ای نشان دهید، برای استفادهٔ دوباره از این گوشی آن را لغو کنید، یا گوشی را پاک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä aloitettiin siirto, joten Rún ei enää lähetä tai vastaanota tällä puhelimella. Näytä uusi koodi saattaaksesi siirron loppuun, peruuta käyttääksesi tätä puhelinta uudelleen, tai pyyhi se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un transfert a été démarré ici, donc Rún n'envoie ni ne reçoit plus rien sur ce téléphone. Affichez un nouveau code pour terminer le transfert, annulez pour réutiliser ce téléphone, ou effacez-le."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тука беше започнато преместување, па Rún повеќе не испраќа и не прима на овој телефон. Прикажете нов код за да го завршите преместувањето, откажете за да го користите телефонот повторно или избришете го."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En flytting ble startet her, så Rún sender eller mottar ikke lenger på denne telefonen. Vis en ny kode for å fullføre flyttingen, avbryt for å bruke denne telefonen igjen, eller slett den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь был начат перенос, поэтому Rún больше не отправляет и не получает сообщения на этом телефоне. Покажите новый код, чтобы завершить перенос, отмените его, чтобы снова пользоваться этим телефоном, или сотрите его."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wareejin ayaa halkan laga bilaabay, sidaas darteed Rún taleefankan hadda wax kama diro, waxna kama helo. Koodh cusub tus si aad wareejinta u dhammaystirto, jooji si aad taleefankan mar kale u isticmaasho, ama tirtir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En flytt påbörjades här, så Rún varken skickar eller tar emot på den här telefonen längre. Visa en ny kod för att slutföra flytten, avbryt för att använda den här telefonen igen, eller radera den."
          }
        }
      }
    },
    "move_frozen_show_again_label": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض الرمز مرة أخرى"
          }
        },
        "da": {
