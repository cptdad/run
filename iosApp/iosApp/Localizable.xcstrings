    "notif_settings_sound_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدر التنبيهات صوتًا مثل أي تطبيق مراسلة آخر. غيّرها أو أسكتها من إعدادات الإشعارات في iOS — لا يتجاوز Rún اختيارك أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer lyder som i enhver anden beskedapp. Du kan ændre dem eller slå lyden fra i notifikationsindstillingerne i iOS — Rún tilsidesætter aldrig dit valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise klingen wie bei jedem anderen Messenger. Du kannst sie in den Benachrichtigungseinstellungen von iOS ändern oder stummschalten — Rún überschreibt deine Wahl nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts sound like any other messenger. Change or silence them in iOS notification settings — Rún never overrides your choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas suenan como en cualquier otra app de mensajería. Cámbialas o siléncialas en los ajustes de notificaciones de iOS; Rún nunca anula tu elección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارها مثل هر پیام‌رسان دیگری صدا می‌دهند. می‌توانید آن‌ها را در تنظیمات اعلان iOS تغییر دهید یا بی‌صدا کنید — Rún هرگز انتخاب شما را نادیده نمی‌گیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset kuulostavat samalta kuin missä tahansa viestisovelluksessa. Muuta tai vaimenna ne iOS:n ilmoitusasetuksissa — Rún ei koskaan ohita valintaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sonnent comme celles de n'importe quelle messagerie. Modifiez-les ou coupez-les dans les réglages de notifications d'iOS — Rún ne remplace jamais votre choix."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Известувањата звучат како кај секоја друга апликација за пораки. Променете ги или исклучете ги во поставките за известувања на iOS — Rún никогаш не го менува вашиот избор."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler høres ut som i alle andre meldingsapper. Endre eller demp dem i varselinnstillingene i iOS – Rún overstyrer aldri valget ditt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения звучат так же, как в любом другом мессенджере. Измените или отключите их в настройках уведомлений iOS — Rún никогда не переопределяет ваш выбор."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Digniinuhu waxay u dhawaaqaan sida fariin-gudbiye kasta oo kale. Ka beddel ama ka aamusi dejinta ogeysiisyada ee iOS — Rún marnaba ma beddelo doorashadaada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiserna låter som i vilken meddelandeapp som helst. Ändra eller tysta dem i notisinställningarna i iOS — Rún åsidosätter aldrig ditt val."
          }
        }
      }
    },
