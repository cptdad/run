    "group_info_choose_admin_subtitle_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن من إضافة الأعضاء وإزالتهم بعد مغادرتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan tilføje og fjerne medlemmer, når du har forladt gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person kann nach deinem Weggang Mitglieder hinzufügen und entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll be able to add and remove members after you leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá añadir y quitar miembros cuando salgas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "او پس از رفتن شما می‌تواند عضو اضافه و حذف کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hän voi lisätä ja poistaa jäseniä sen jälkeen, kun olet poistunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne pourra ajouter et retirer des membres après votre départ."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тие ќе можат да додаваат и отстрануваат членови откако ќе заминете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedkommende kan legge til og fjerne medlemmer etter at du har forlatt gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый администратор сможет добавлять и удалять участников после того, как вы покинете группу."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Way awoodi doonaan inay ku daraan oo ka saaraan xubno ka dib markaad ka baxdo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen kan lägga till och ta bort medlemmar när du har lämnat gruppen."
          }
        }
      }
    },
    "group_info_choose_admin_subtitle_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من يصبح المشرف الجديد. سيتمكن من إضافة الأعضاء وإزالتهم بعد مغادرتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvem der skal være ny admin. De kan tilføje og fjerne medlemmer, når du har forladt gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wer neuer Admin wird. Diese Person kann nach deinem Weggang Mitglieder hinzufügen und entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose who becomes the new admin. They'll be able to add and remove members after you leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige quién será el administrador nuevo. Podrá añadir y quitar miembros cuando salgas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید چه کسی مدیر جدید شود. او پس از رفتن شما می‌تواند عضو اضافه و حذف کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, kenestä tulee uusi ylläpitäjä. Hän voi lisätä ja poistaa jäseniä sen jälkeen, kun olet poistunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez qui devient le nouvel administrateur. Cette personne pourra ajouter et retirer des membres après votre départ."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете кој ќе стане нов администратор. Тие ќе можат да додаваат и отстрануваат членови откако ќе заминете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvem som skal bli ny administrator. Vedkommende kan legge til og fjerne medlemmer etter at du har forlatt gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, кто станет новым администратором. Он сможет добавлять и удалять участников после того, как вы покинете группу."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro qofka noqonaya maamulaha cusub. Way awoodi doonaan inay ku daraan oo ka saaraan xubno ka dib markaad ka baxdo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vem som blir ny admin. Personen kan lägga till och ta bort medlemmar när du har lämnat gruppen."
          }
        }
      }
    },
