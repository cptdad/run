    "add_contact_choice_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبادل أنت وجهة اتصالك الرمزين. اختر كيف تبدأ — ستقوم بالأمرين معًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og din kontakt udveksler koder. Vælg, hvad du vil starte med — du skal gøre begge dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du und dein Kontakt tauschen Codes aus. Wähle, womit ihr anfangt — ihr macht beides."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and your contact swap codes. Pick how to start — you’ll do both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contacto y tú intercambiáis códigos. Elige por dónde empezar: haréis las dos cosas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما و مخاطبتان کدها را رد و بدل می‌کنید. انتخاب کنید از کجا شروع می‌کنید — هر دو کار را انجام خواهید داد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä ja kontaktisi vaihdatte koodit. Valitse, mistä aloitat — teette kummankin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous et votre contact échangez vos codes. Choisissez par où commencer — vous ferez les deux."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие и вашиот контакт разменувате кодови. Изберете како да започнете — ќе ги направите и двете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og kontakten din bytter koder. Velg hvordan du vil starte – dere gjør begge deler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и ваш контакт обмениваетесь кодами. Выберите, с чего начать, — вы сделаете и то, и другое."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiga iyo xiriiriyahaaga waxaad isweydaarsataan koodh. Dooro sida aad ku bilowdo — labadaba waad samayn doontaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du och din kontakt byter koder. Välj hur ni börjar — ni gör båda delarna."
          }
        }
      }
    },
