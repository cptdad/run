    "setup_choose_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتستخدم Rún بالفعل على هاتف آخر؟ انقله إلى هنا وستأتي معك جهات اتصالك ومجموعاتك ومحادثاتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger du allerede Rún på en anden telefon? Flyt den hertil, så følger dine kontakter, grupper og samtaler med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt du Rún schon auf einem anderen Handy? Übertrage es hierher, und deine Kontakte, Gruppen und Unterhaltungen kommen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already using Rún on another phone? Move it here and your contacts, groups and conversations come with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya usas Rún en otro teléfono? Muévelo aquí y tus contactos, grupos y conversaciones vendrán contigo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از قبل روی گوشی دیگری از Rún استفاده می‌کنید؟ آن را به اینجا منتقل کنید تا مخاطبان، گروه‌ها و گفت‌وگوهایتان همراهتان بیایند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytätkö jo Rún-sovellusta toisella puhelimella? Siirrä se tänne, niin yhteystietosi, ryhmäsi ja keskustelusi tulevat mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez déjà Rún sur un autre téléphone ? Transférez-le ici et vos contacts, groupes et conversations vous suivent."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веќе го користите Rún на друг телефон? Преместете го тука и вашите контакти, групи и разговори доаѓаат со вас."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker du allerede Rún på en annen telefon? Flytt den hit, så blir kontaktene, gruppene og samtalene dine med."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже используете Rún на другом телефоне? Перенесите его сюда — и ваши контакты, группы и беседы отправятся вместе с вами."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma waxaad Rún horey ugu isticmaalaysaa taleefan kale? Halkan u soo wareeji, xiriirradaada, kooxahaaga iyo wadahadalladaaduna way ku raaci doonaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder du redan Rún på en annan telefon? Flytta det hit så följer dina kontakter, grupper och konversationer med."
          }
        }
      }
    },
