          }
        }
      }
    },
    "add_contact_cancel_pairing_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جهة الاتصال غير المكتملة وإغلاق صناديق الوارد الخاصة بها. ستحتاجان إلى البدء من جديد برموز جديدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det sletter den halvfærdige kontakt og lukker dens indbakker. I skal begge starte forfra med nye koder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht den unvollständigen Kontakt und schließt seine Postfächer. Ihr müsst dann beide mit neuen Codes von vorn beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the half-finished contact and closes its inboxes. You’ll both have to start over with new codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el contacto a medio terminar y cierra sus buzones. Tendréis que volver a empezar los dos con códigos nuevos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار مخاطب نیمه‌تمام را حذف می‌کند و صندوق‌های ورودی آن را می‌بندد. هر دوی شما باید با کدهای جدید از نو شروع کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa puolivalmiin kontaktin ja sulkee sen postilaatikot. Teidän molempien täytyy aloittaa alusta uusilla koodeilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le contact à moitié terminé et ferme ses boîtes de réception. Vous devrez tous les deux recommencer avec de nouveaux codes."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова го брише наполовина завршениот контакт и ги затвора неговите сандачиња. Двајцата ќе треба да започнете одново со нови кодови."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter den halvferdige kontakten og lukker innboksene dens. Dere må begge starte på nytt med nye koder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит наполовину добавленный контакт и закроет его почтовые ящики. Вам обоим придётся начать заново с новыми кодами."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan waxay tirtirtaa xiriiriyaha aan la dhammaystirin waxayna xidhaa sanduuqyadiisa. Labadiinnuba waa inaad ku bilowdaan koodh cusub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här raderar den halvfärdiga kontakten och stänger dess inkorgar. Ni måste båda börja om med nya koder."
          }
        }
      }
    },
