    "contact_list_leave_group_admin_message_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت المشرف. بعد مغادرتك، لن يستطيع أحد تغيير قائمة الأعضاء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er admin. Når du har forladt gruppen, kan ingen ændre medlemslisten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Admin. Nachdem du gegangen bist, kann niemand mehr die Mitgliederliste ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the admin. After you leave, nobody can change the member list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el administrador. Cuando salgas, nadie podrá cambiar la lista de miembros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما مدیر هستید. پس از رفتن شما، هیچ‌کس نمی‌تواند فهرست اعضا را تغییر دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ylläpitäjä. Kun poistut, kukaan ei voi muuttaa jäsenluetteloa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes l'administrateur. Après votre départ, plus personne ne pourra modifier la liste des membres."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие сте администраторот. Откако ќе заминете, никој нема да може да ја промени листата на членови."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er administrator. Etter at du har forlatt gruppen, kan ingen endre medlemslisten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы администратор. После того как вы покинете группу, никто не сможет изменить список участников."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaad tahay maamulaha. Marka aad ka baxdo, qofna ma beddeli karo liiska xubnaha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är admin. När du lämnar gruppen kan ingen längre ändra medlemslistan."
          }
        }
      }
    },
    "contact_list_leave_group_admin_message_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت مشرف المجموعة. افتح المجموعة، وانقر على زر المعلومات، واختر مشرفًا جديدًا — بعدها يمكنك المغادرة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er gruppens admin. Åbn gruppen, tryk på info-knappen, og vælg en ny admin — så kan du forlade gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Gruppen-Admin. Öffne die Gruppe, tippe auf die Info-Schaltfläche und wähle einen neuen Admin — dann kannst du gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the group admin. Open the group, tap the info button, and choose a new admin — then you can leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el administrador del grupo. Abre el grupo, toca el botón de información y elige un administrador nuevo; después podrás salir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما مدیر گروه هستید. گروه را باز کنید، روی دکمهٔ اطلاعات ضربه بزنید و مدیر جدیدی انتخاب کنید — سپس می‌توانید بروید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ryhmän ylläpitäjä. Avaa ryhmä, napauta info-painiketta ja valitse uusi ylläpitäjä — sitten voit poistua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes l'administrateur du groupe. Ouvrez le groupe, touchez le bouton d'informations et choisissez un nouvel administrateur — vous pourrez ensuite partir."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие сте администраторот на групата. Отворете ја групата, допрете го копчето за информации и изберете нов администратор — потоа можете да излезете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er gruppeadministrator. Åpne gruppen, trykk på info-knappen og velg en ny administrator – da kan du forlate gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы администратор группы. Откройте группу, нажмите кнопку информации и выберите нового администратора — после этого вы сможете выйти."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaad tahay maamulaha kooxda. Fur kooxda, taabo badhanka macluumaadka, oo dooro maamule cusub — kadibna waad ka bixi kartaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är gruppens admin. Öppna gruppen, tryck på infoknappen och välj en ny admin — sedan kan du lämna."
          }
        }
      }
    },
    "contact_list_memory_dialog_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير خاص بهوية جهة الاتصال هذه. لا يراه أحد سواك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat påmindelse om, hvem denne kontakt er. Kun du kan se den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine private Notiz dazu, wer dieser Kontakt ist. Nur du kannst sie sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private reminder of who this contact is. Only you can see this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio privado de quién es este contacto. Solo tú puedes verlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآوری خصوصی از اینکه این مخاطب کیست. فقط شما آن را می‌بینید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityinen muistutus siitä, kuka tämä kontakti on. Vain sinä näet tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel privé de qui est ce contact. Vous seul pouvez le voir."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватен потсетник за тоа кој е овој контакт. Само вие можете да го видите ова."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat påminnelse om hvem denne kontakten er. Bare du kan se dette."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личное напоминание о том, кто этот контакт. Это видите только вы."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xusuusin gaar ah oo ku saabsan cidda uu xiriiriyahani yahay. Adiga kaliya ayaa arki kara tan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat påminnelse om vem kontakten är. Bara du kan se den."
          }
        }
      }
    },
