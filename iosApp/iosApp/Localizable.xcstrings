    "contact_list_block_contact_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تستلم رسائل من %1$@ بعد الآن، وستُزال جهة الاتصال هذه من قائمتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du modtager ikke længere beskeder fra %1$@, og de bliver fjernet fra din liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst keine Nachrichten mehr von %1$@, und der Kontakt wird aus deiner Liste entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer receive messages from %1$@, and they will be removed from your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarás de recibir mensajes de %1$@ y desaparecerá de tu lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر پیامی از %1$@ دریافت نمی‌کنید و او از فهرست شما حذف می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enää vastaanota viestejä henkilöltä %1$@, ja hänet poistetaan luettelostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez plus de messages de %1$@, et cette personne sera retirée de votre liste."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повеќе нема да примате пораки од %1$@, и тие ќе бидат отстранети од вашата листа."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke lenger motta meldinger fra %1$@, og vedkommende fjernes fra listen din."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не будете получать сообщения от %1$@, а этот контакт будет удалён из вашего списка."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Mar dambe kama heli doontid fariimo ka socda %1$@, waxaana laga saari doonaa liiskaaga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får inte längre meddelanden från %1$@, och personen tas bort från din lista."
          }
        }
      }
    },
