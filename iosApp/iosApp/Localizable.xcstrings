          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitsee ja pyyhkii itsensä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se verrouille et s'efface"
          }
        },
        "mk": {
          "stringUnit": {
