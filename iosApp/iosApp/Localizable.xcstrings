    "protection_recovery_entry_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز الاسترداد الذي حفظته مع %1$@. هذا يستعيد رسائلك. وإذا كان هذا الهاتف لا يزال قادرًا على استخدام قفل العتاد، فسيُعاد تشغيله بالرمز نفسه، لذا احتفظ بالرمز في مكان آمن."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den gendannelseskode, du gemte, sammen med din %1$@. Det gendanner dine beskeder. Hvis telefonen stadig kan bruge hardwarelåsen, slås den til igen med den samme kode, så pas godt på koden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den gespeicherten Wiederherstellungscode und deine %1$@ ein. Das stellt deine Nachrichten wieder her. Wenn dieses Telefon die Hardware-Sperre noch nutzen kann, wird sie mit genau diesem Code wieder eingeschaltet – bewahre den Code also sicher auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery code you saved plus your %1$@. This restores your messages. If this phone can still use the hardware lock, it switches back on with this same code, so keep the code safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de recuperación que guardaste y tu %1$@. Esto restaura tus mensajes. Si este teléfono todavía puede usar el bloqueo por hardware, se vuelve a activar con este mismo código, así que guárdalo en un lugar seguro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد بازیابی ذخیره‌شده را همراه با %1$@ خود وارد کنید. این کار پیام‌های شما را بازمی‌گرداند. اگر این گوشی هنوز بتواند از قفل سخت‌افزاری استفاده کند، این قفل با همین کد دوباره روشن می‌شود؛ پس کد را در جای امنی نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä tallentamasi palautuskoodi ja %1$@. Tämä palauttaa viestisi. Jos tämä puhelin voi yhä käyttää laitteistolukitusta, se otetaan uudelleen käyttöön samalla koodilla, joten säilytä koodi turvassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code de récupération que vous avez conservé ainsi que votre %1$@. Cela restaure vos messages. Si ce téléphone peut encore utiliser le verrou matériel, celui-ci se réactive avec ce même code : conservez-le donc en lieu sûr."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внесете го зачуваниот код за обновување заедно со %1$@. Ова ги враќа вашите пораки. Ако овој телефон сè уште може да го користи хардверското заклучување, тоа повторно се вклучува со истиот код, па чувајте го кодот на безбедно место."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn gjenopprettingskoden du lagret, sammen med %1$@. Dette gjenoppretter meldingene dine. Hvis telefonen fortsatt kan bruke maskinvarelåsen, slås den på igjen med den samme koden, så ta godt vare på koden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для восстановления потребуются сохранённый код восстановления и %1$@. Это восстановит ваши сообщения. Если этот телефон по-прежнему поддерживает аппаратную блокировку, она снова включится с тем же кодом, поэтому храните код в надёжном месте."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli koodhka soo-celinta ee aad kaydisay iyo %1$@ aad isticmaasho. Tani waxay soo celinaysaa fariimahaaga. Haddii taleefankani weli isticmaali karo qufulka qalabka, wuxuu dib u shidmayaa isla koodhkan, markaa koodhka meel ammaan ah ku hay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange återställningskoden du sparade plus din %1$@. Det återställer dina meddelanden. Om telefonen fortfarande kan använda hårdvarulåset slås det på igen med samma kod, så förvara koden säkert."
          }
        }
      }
    },
    "protection_recovery_entry_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسترداد برمزك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan med din kode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Code wiederherstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover with your code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera con tu código"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی با کد شما"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta koodillasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer avec votre code"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновете со вашиот код"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprett med koden din"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление по коду"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodhkaaga ku soo celi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ med din kod"
          }
        }
      }
    },
    "protection_recovery_generic_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاسترداد الآن — لا يوجد رمز استرداد محفوظ، أو مفتاح الجهاز مشغول. حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gendanne lige nu — der er ingen gendannelseskode registreret, eller enhedsnøglen er optaget. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung gerade nicht möglich — es ist kein Wiederherstellungscode hinterlegt, oder der Geräteschlüssel ist beschäftigt. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t recover right now — no recovery code on file, or the device key is busy. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se ha podido recuperar: no hay ningún código de recuperación guardado o la clave del dispositivo está ocupada. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی الان ممکن نیست — یا کد بازیابی‌ای ثبت نشده یا کلید دستگاه مشغول است. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautus ei onnistunut juuri nyt — palautuskoodia ei ole tallessa tai laiteavain on varattu. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération impossible pour le moment — aucun code de récupération enregistré, ou la clé de l'appareil est occupée. Réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Во моментов не можевме да обновиме — нема зачуван код за обновување, или клучот на уредот е зафатен. Обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenopprette nå – ingen gjenopprettingskode er lagret, eller enhetsnøkkelen er opptatt. Prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить восстановление сейчас — нет сохранённого кода восстановления, либо аппаратный ключ занят. Попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadda lama soo celin karin — ama koodh soo-celineed lama hayo, ama furaha qalabku wuu mashquulsan yahay. Isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte återställa just nu — ingen återställningskod finns sparad, eller så är enhetsnyckeln upptagen. Försök igen."
          }
        }
      }
    },
    "protection_recovery_wrong_credential": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز و%1$@ لم يتطابقا. تحقق من كليهما وحاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden og din %1$@ passede ikke sammen. Tjek begge dele, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code und diese %1$@ passen nicht zusammen. Prüfe beides und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code and %1$@ didn’t match. Check both and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coinciden. Revisa el código de recuperación y tu %1$@, y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد و این %1$@ با هم مطابقت نداشتند. هر دو را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ja %1$@ eivät täsmänneet. Tarkista molemmat ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code et votre %1$@ ne correspondent pas. Vérifiez les deux et réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тој код и %1$@ не се совпаднаа. Проверете ги двата и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden og %1$@ stemte ikke. Sjekk begge deler og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код и %1$@ не совпали. Проверьте оба значения и попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodhkaas iyo %1$@ ma saxna. Labadaba hubi oo isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden och din %1$@ stämde inte. Kontrollera båda och försök igen."
          }
        }
      }
    },
    "protection_stop_no_biometrics": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقاييس الحيوية غير متوفرة. أعدّ Face ID أو بصمة الإصبع."
          }
        },
        "da": {
          "stringUnit": {
