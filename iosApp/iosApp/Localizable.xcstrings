    "contact_list_reset_relay_failure": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى المُرحّل. سيكمل Rún هذا بنفسه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå relæet. Rún gør det færdigt af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay war nicht erreichbar. Rún schließt das von selbst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the relay. Rún will finish this on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido llegar al relay. Rún lo terminará por su cuenta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رله در دسترس نبود. Rún خودش این کار را کامل می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välityspalvelimeen ei saatu yhteyttä. Rún viimeistelee tämän itsekseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le relais. Rún terminera l'opération toute seule."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можеше да се стигне до релето. Rún ќе го заврши ова самостојно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke kontakt med relayet. Rún fullfører dette på egen hånd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с ретранслятором. Rún завершит это самостоятельно."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama gaari karin relay-ga. Rún ayaa iskeed u dhammaystiri doona tan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte nå reläet. Rún slutför det här på egen hand."
          }
        }
      }
    },
