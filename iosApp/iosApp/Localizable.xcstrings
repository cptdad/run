    "connect_tor_reboot_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يُجدِ الإغلاق وإعادة الفتح، أعد تشغيل iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det ikke hjælper at lukke og åbne igen, så genstart din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Schließen und erneutes Öffnen nicht geholfen hat, starte dein iPhone neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If closing and reopening hasn’t helped, restart your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cerrarlo y volver a abrirlo no ha servido, reinicia tu iPhone."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بستن و باز کردن دوباره کمکی نکرد، iPhone خود را دوباره راه‌اندازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sulkeminen ja uudelleen avaaminen ei ole auttanut, käynnistä iPhone uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si fermer et rouvrir l'appli n'a rien changé, redémarrez votre iPhone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако затворањето и повторното отворање не помогнаа, рестартирајте го вашиот iPhone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det ikke hjelper å lukke og åpne på nytt, start iPhone på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если закрытие и повторное открытие не помогло, перезагрузите iPhone."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Haddii aad Rún xidho oo aad mar kale furto ayan waxba tarin, dib u bilow iPhone-kaaga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det inte hjälpte att stänga och öppna appen, starta om din iPhone."
          }
        }
      }
    },
    "connect_tor_stalled_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الاتصال جاريًا…\nقد تكون هذه الشبكة تحجب الاتصال الخاص. جرّب شبكة Wi-Fi أخرى أو بيانات الهاتف — وسنواصل المحاولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbinder stadig…\nDette netværk blokerer måske den private forbindelse. Prøv et andet Wi-Fi eller mobildata — vi bliver ved med at forsøge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung läuft noch…\nDieses Netzwerk blockiert möglicherweise die private Verbindung. Versuch ein anderes WLAN oder mobile Daten — wir versuchen es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still connecting…\nThis network may be blocking the private connection. Try different Wi-Fi or mobile data — we’ll keep trying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos conectando…\nEs posible que esta red esté bloqueando la conexión privada. Prueba con otra red Wi-Fi o con datos móviles; seguiremos intentándolo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همچنان در حال اتصال…\nشاید این شبکه ارتباط خصوصی را مسدود می‌کند. یک وای‌فای دیگر یا اینترنت همراه را امتحان کنید — ما به تلاش ادامه می‌دهیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään yhä…\nTämä verkko saattaa estää yksityisen yhteyden. Kokeile toista Wi-Fi-verkkoa tai mobiilidataa — jatkamme yrittämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion toujours en cours…\nCe réseau bloque peut-être la connexion privée. Essayez un autre Wi-Fi ou les données mobiles — nous continuons d'essayer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште се поврзува…\nОваа мрежа можеби ја блокира приватната врска. Обидете се со друг Wi-Fi или мобилен интернет — ние ќе продолжиме да се обидуваме."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler fortsatt til…\nDette nettverket blokkerer kanskje den private forbindelsen. Prøv et annet Wi-Fi eller mobildata – vi fortsetter å prøve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё подключаемся…\nЭта сеть может блокировать приватное соединение. Попробуйте другой Wi-Fi или мобильный интернет — мы продолжим попытки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli waa la xidhiidhayaa…\nShabakaddan ayaa laga yaabaa inay xannibayso xidhiidhka gaarka ah. Isku day Wi-Fi kale ama datada mobilka — waxaannu sii isku dayi doonnaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter fortfarande…\nNätverket kan blockera den privata anslutningen. Prova ett annat Wi-Fi eller mobildata — vi fortsätter försöka."
          }
        }
      }
    },
    "connect_tor_stalled_long_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الاتصال متعذرًا.\nأغلق Rún تمامًا ثم افتحه من جديد — هذا يبدأ اتصالًا خاصًا جديدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stadig ikke forbinde.\nLuk Rún helt, og åbn appen igen — det starter en ny privat forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung klappt weiterhin nicht.\nSchließe Rún vollständig und öffne es erneut — das startet eine neue private Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still can’t connect.\nClose Rún completely and open it again — that starts a fresh private connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos sin conectar.\nCierra Rún del todo y ábrelo otra vez: eso inicia una conexión privada nueva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز اتصال برقرار نمی‌شود.\nRún را کاملاً ببندید و دوباره باز کنید — این کار یک ارتباط خصوصی تازه آغاز می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyttä ei edelleenkään saada.\nSulje Rún kokonaan ja avaa se uudelleen — se aloittaa uuden yksityisen yhteyden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion toujours impossible.\nFermez complètement Rún et rouvrez-la — cela lance une nouvelle connexion privée."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не можеме да се поврземе.\nЦелосно затворете го Rún и отворете го повторно — тоа започнува нова приватна врска."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får fortsatt ikke koblet til.\nLukk Rún helt og åpne appen på nytt – det starter en ny privat forbindelse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё не удаётся подключиться.\nПолностью закройте Rún и откройте его снова — это запустит новое приватное соединение."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli wax lama xidhiidhin karo.\nXir Rún gebi ahaanba oo mar kale fur — taasi waxay bilaabaysaa xidhiidh gaar ah oo cusub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan fortfarande inte ansluta.\nStäng Rún helt och öppna appen igen — det startar en ny privat anslutning."
          }
        }
      }
    },
