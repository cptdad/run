    "protection_forced_explainer_cta_body_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز PIN أو نمط أو كلمة مرور أو بصمة — كلها تفي بالغرض. تتاح كل مستويات الحماية متى صار لهاتفك واحد منها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En PIN, et mønster, en adgangskode eller et fingeraftryk tæller alt sammen. Alle beskyttelsesniveauer bliver tilgængelige, så snart din telefon har en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN, Muster, Passwort oder Fingerabdruck — alles zählt. Sobald dein Telefon eine hat, ist jede Schutzstufe verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PIN, pattern, password, or fingerprint all count. Any protection level is available once your phone has one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale un PIN, un patrón, una contraseña o una huella. Con cualquiera de ellos tendrás disponibles todos los niveles de protección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN، الگو، گذرواژه یا اثر انگشت — همه قبول است. به محض اینکه گوشی‌تان یکی داشته باشد، همهٔ سطح‌های حفاظت در دسترس‌اند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-koodi, kuvio, salasana tai sormenjälki — mikä tahansa käy. Kaikki suojaustasot ovat käytettävissä heti, kun puhelimessasi on jokin niistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code PIN, un schéma, un mot de passe ou une empreinte, tout convient. Tous les niveaux de protection deviennent disponibles dès que votre téléphone en a un."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN, шема, лозинка или отпечаток — сите важат. Секое ниво на заштита е достапно откако вашиот телефон ќе има заклучување на екранот."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN, mønster, passord eller fingeravtrykk – alt teller. Alle beskyttelsesnivåer blir tilgjengelige så snart telefonen har en."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подойдёт PIN-код, графический ключ, пароль или отпечаток пальца. Как только на телефоне будет установлена блокировка, станет доступен любой уровень защиты."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN, qaab, eray sir ah, ama far-raad — dhammaantood way ku filan yihiin. Heer ilaalineed kasta ayaa la heli karaa marka taleefankaagu leeyahay mid ka mid ah kuwaas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-kod, mönster, lösenord eller fingeravtryck räknas alla. Alla skyddsnivåer blir tillgängliga så snart telefonen har ett."
          }
        }
      }
    },
    "protection_forced_explainer_cta_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات ثم «Face ID ورمز الدخول» ثم «تشغيل رمز الدخول»، ثم عد إلى Rún. تتاح كل مستويات الحماية متى صار لهاتفك رمز دخول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Indstillinger → Face ID & kode → Slå kode til, og vend så tilbage til Rún. Alle beskyttelsesniveauer bliver tilgængelige, så snart din telefon har en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen → Face ID & Code → Code aktivieren und komm dann zu Rún zurück. Sobald dein Telefon einen hat, ist jede Schutzstufe verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Face ID & Passcode → Turn Passcode On, then come back to Rún. Any protection level is available once your phone has one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes → Face ID y código → Activar código y vuelve a Rún. Con un código tendrás disponibles todos los niveles de protección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات → Face ID و رمز دستگاه → فعال کردن رمز را باز کنید و سپس به Rún برگردید. به محض اینکه گوشی‌تان رمزی داشته باشد، همهٔ سطح‌های حفاظت در دسترس‌اند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Asetukset → Face ID ja pääsykoodi → Ota pääsykoodi käyttöön ja avaa sitten Rún uudelleen. Kaikki suojaustasot ovat käytettävissä heti, kun puhelimessasi on pääsykoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages → Face ID et code → Activer le code, puis revenez dans Rún. Tous les niveaux de protection deviennent disponibles dès que votre téléphone en a un."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Поставки → Face ID и код за пристап → Вклучи код за пристап, па вратете се во Rún. Секое ниво на заштита е достапно откако вашиот телефон ќе има код за пристап."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Innstillinger → Face ID og kode → Slå på kode, og kom tilbake til Rún. Alle beskyttelsesnivåer blir tilgjengelige så snart telefonen har en."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Настройки → Face ID и код-пароль → Включите код-пароль, затем вернитесь в Rún. Как только на телефоне будет установлен код-пароль, станет доступен любой уровень защиты."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur Settings → Face ID & Passcode → Turn Passcode On, kadibna ku soo noqo Rún. Heer ilaalineed kasta ayaa la heli karaa marka taleefankaagu leeyahay mid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Inställningar → Face ID och lösenkod → Slå på lösenkod, och kom sedan tillbaka till Rún. Alla skyddsnivåer blir tillgängliga så snart telefonen har en."
          }
        }
      }
    },
