          "stringUnit": {
            "state": "translated",
            "value": "گوشی قدیمی نسخهٔ جدیدتری از Rún را اجرا می‌کند. Rún را اینجا به‌روزرسانی کنید و بعد دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhalla puhelimella on uudempi Rún. Päivitä Rún tässä ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancien téléphone utilise une version plus récente de Rún. Mettez à jour Rún ici, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стариот телефон има понов Rún. Ажурирајте го Rún тука, па обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamle telefonen kjører en nyere versjon av Rún. Oppdater Rún her, og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На старом телефоне установлена более новая версия Rún. Обновите Rún здесь и повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefanka hore wuxuu ku shaqeeyaa Rún ka cusub. Halkan ku cusboonaysii Rún, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamla telefonen kör en nyare version av Rún. Uppdatera Rún här och försök igen."
          }
        }
      }
    },
    "move_error_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات هنا أكثر من أن تُنقل في عملية نقل واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er for meget her til at flytte i én overførsel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist zu viel für eine einzelne Übertragung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is too much here to move in one transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiado contenido para mover en una sola transferencia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم داده‌های اینجا برای یک انتقال بیش از حد است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä on liikaa siirrettävää yhteen siirtoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a trop de données ici pour un seul transfert."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тука има премногу за да се премести во еден пренос."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er for mye her til å flytte i én overføring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь слишком много данных, чтобы перенести их за одну передачу."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxyaabaha halkan yaalla aad ayay u badan yihiin in hal wareejin lagu wareejiyo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns för mycket här för att flytta i en enda överföring."
          }
        }
      }
    },
    "move_error_upload": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل رفع النقل. حاول مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overførslen blev ikke uploadet. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wurde nicht hochgeladen. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer did not upload. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia no se ha subido. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقال بارگذاری نشد. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtoa ei saatu lähetettyä. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi du transfert a échoué. Réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Преносот не се прикачи. Обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overføringen ble ikke lastet opp. Prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить передачу. Повторите попытку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wareejinta kor looma dirin. Isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överföringen kunde inte laddas upp. Försök igen."
          }
        }
      }
    },
    "move_expiry_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر النقل على المُرحّل 30 دقيقة. بعدها، اعرض الرمز مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overførslen venter på relæet i 30 minutter. Derefter skal du vise koden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wartet 30 Minuten auf dem Relay. Danach zeig den Code erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer waits on the relay for 30 minutes. After that, show the code again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia espera en el relay durante 30 minutos. Pasado ese tiempo, vuelve a mostrar el código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقال ۳۰ دقیقه روی رله می‌ماند. پس از آن، کد را دوباره نشان دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirto odottaa välityspalvelimella 30 minuuttia. Sen jälkeen näytä koodi uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert reste disponible sur le relais pendant 30 minutes. Passé ce délai, affichez de nouveau le code."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Преносот чека на релето 30 минути. По тоа, прикажете го кодот повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overføringen venter på relayet i 30 minutter. Etter det må du vise koden på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача хранится на ретрансляторе 30 минут. После этого покажите код снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wareejintu waxay relay-ga ku sugaysaa 30 daqiiqo. Kadib, koodhka mar kale tus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överföringen väntar på reläet i 30 minuter. Visa koden igen efter det."
          }
        }
      }
    },
    "move_explain_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحزم Rún كل شيء في عملية نقل واحدة مختومة ويعرض لك رمزًا. امسح ذلك الرمز على الهاتف الجديد أثناء إعداده."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún pakker det hele i én forseglet overførsel og viser dig en kode. Scan koden på den nye telefon, mens du sætter den op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún verpackt alles in eine versiegelte Übertragung und zeigt dir einen Code. Scanne diesen Code auf dem neuen Handy, während du es einrichtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún packs everything into one sealed transfer and shows you a code. Scan that code on the new phone while you set it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún empaqueta todo en una transferencia sellada y te muestra un código. Escanea ese código en el teléfono nuevo mientras lo configuras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún همه‌چیز را در یک انتقالِ مهروموم‌شده بسته‌بندی می‌کند و یک کد به شما نشان می‌دهد. هنگام راه‌اندازی گوشی جدید، آن کد را با آن اسکن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún pakkaa kaiken yhteen sinetöityyn siirtoon ja näyttää sinulle koodin. Lue se koodi uudella puhelimella, kun määrität sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún regroupe tout dans un transfert scellé unique et vous affiche un code. Scannez ce code sur le nouveau téléphone pendant sa configuration."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún пакува сè во еден запечатен пренос и ви покажува код. Скенирајте го тој код на новиот телефон додека го поставувате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún pakker alt inn i én forseglet overføring og viser deg en kode. Skann koden på den nye telefonen mens du setter den opp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún упаковывает всё в единую запечатанную передачу и показывает вам код. Отсканируйте этот код на новом телефоне во время его настройки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún wuxuu wax walba ku uruuriyaa hal wareejin oo shaabadaysan, wuxuuna ku tusayaa koodh. Koodhkaas ku sawir garee taleefanka cusub intaad dejinayso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún packar ihop allt i en förseglad överföring och visar dig en kod. Skanna koden på den nya telefonen medan du konfigurerar den."
          }
        }
      }
    },
    "move_explain_continue_label": {
      "extractionState": "manual",
      "localizations": {
