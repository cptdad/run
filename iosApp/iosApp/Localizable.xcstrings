    "move_error_already_imported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق أن تولّى هذا الهاتف عملية نقل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefon har allerede overtaget en flytning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy hat bereits eine Übertragung übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has already taken over a move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono ya se ha hecho cargo de un traslado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
