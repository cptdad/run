    "group_info_add_member_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا جهات اتصال مؤهلة — كل من اقترنت به موجود في المجموعة بالفعل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mulige kontakter — alle, du er parret med, er allerede i gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passenden Kontakte — alle, mit denen du gekoppelt bist, sind schon in der Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible contacts — everyone you've paired with is already in the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contactos elegibles: todas las personas con las que te has emparejado ya están en el grupo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخاطب واجد شرایطی نیست — همهٔ کسانی که با آن‌ها جفت‌سازی کرده‌اید همین حالا در گروه‌اند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei sopivia kontakteja — kaikki, joiden kanssa olet tehnyt parituksen, ovat jo ryhmässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contact éligible — toutes les personnes avec qui vous êtes appairé sont déjà dans le groupe."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема подобни контакти — сите со кои сте се спариле веќе се во групата."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktuelle kontakter – alle du har parkoblet med, er allerede i gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подходящих контактов — все, с кем вы сопряжены, уже в группе."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma jiraan xiriiriyayaal ku habboon — qof kasta oo aad la lammaanaysay horeyba ayuu kooxda ku jiraa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga möjliga kontakter — alla du har parkopplat med är redan med i gruppen."
          }
        }
      }
    },
    "group_info_add_member_precondition": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون قد اقترن شخصيًا مع كل عضو. وأنت تزكّي ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De skal være parret ansigt til ansigt med hvert eneste medlem. Det går du god for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person muss sich mit jedem Mitglied persönlich gekoppelt haben. Dafür bürgst du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They must have paired in person with every member. You are vouching for that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene que haberse emparejado en persona con todos los miembros. Tú lo estás avalando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "او باید با تک‌تک اعضا حضوری جفت‌سازی کرده باشد. شما ضامن این هستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänen on täytynyt tehdä paritus kasvokkain jokaisen jäsenen kanssa. Menet siitä takuuseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne doit s'être appairée en personne avec chaque membre. Vous vous en portez garant."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тие мора да се спарени лично со секој член. Вие гарантирате за тоа."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedkommende må ha parkoblet ansikt til ansikt med alle medlemmene. Du går god for det."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый участник должен лично выполнить сопряжение с каждым участником группы. Вы ручаетесь за это."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waa inay si toos ah ula lammaaneeyaan xubin kasta. Taas waxaad dammaanad u tahay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen måste ha parkopplat personligen med varje medlem. Du går i god för det."
          }
        }
      }
    },
