    "add_contact_show_hint_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من جهة اتصالك مسح هذا الرمز. بعدها ستمسح رمزه أنت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad dem scanne den. Bagefter scanner du deres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Kontakt das scannen. Danach scannst du den Code deines Kontakts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have them scan this. You’ll scan theirs next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele que lo escanee. Luego escanearás el suyo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بگذارید آن را اسکن کند. در گام بعد شما کد او را اسکن می‌کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä häntä lukemaan tämä. Luet hänen koodinsa seuraavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-lui scanner ce code. Vous scannerez le sien ensuite."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нека го скенираат ова. Потоа ќе го скенирате нивниот."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La dem skanne denne. Så skanner du deres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть контакт отсканирует код. Затем вы отсканируете его код."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka dhig inay tan sawir gareeyaan. Marka xigta waxaad sawir gareyn doontaa tooda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt kontakten skanna den. Sedan skannar du deras."
          }
        }
      }
    },
    "add_contact_show_hint_scanned": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من جهة اتصالك مسحه ضوئيًا، ثم أكمِل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad dem scanne den, og afslut så."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Kontakt das scannen und schließe dann ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have them scan this, then finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele que lo escanee y termina."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بگذارید آن را اسکن کند، سپس کار را تمام کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä häntä lukemaan tämä ja viimeistele sitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-lui scanner ce code, puis terminez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нека го скенираат ова, па завршете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La dem skanne denne, og fullfør."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть контакт отсканирует код, затем завершите."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka dhig inay tan sawir gareeyaan, kadibna dhammee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt kontakten skanna den, och slutför sedan."
          }
        }
      }
    },
