    "terms_contact_enforcement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُراجَع البلاغات ويُتَّخذ إجراء بشأنها خلال 24 ساعة: يُحذف المحتوى المخالف ويُمنَع المستخدمون المسيئون."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser bliver håndteret inden for 24 timer: anstødeligt indhold bliver fjernet, og brugere, der misbruger tjenesten, bliver udelukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen werden innerhalb von 24 Stunden bearbeitet: Anstößige Inhalte werden entfernt und missbräuchliche Nutzer werden gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are acted on within 24 hours: offending content is removed and abusive users are ejected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias se atienden en menos de 24 horas: el contenido objetable se elimina y los usuarios abusivos son expulsados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به گزارش‌ها ظرف ۲۴ ساعت رسیدگی می‌شود: محتوای نامناسب حذف و کاربران آزارگر محروم می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksiin reagoidaan 24 tunnin kuluessa: loukkaava sisältö poistetaan ja väärinkäyttäjät suljetaan pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont traités sous 24 heures : le contenu répréhensible est retiré et les utilisateurs abusifs sont exclus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се постапува по пријавите во рок од 24 часа: несоодветната содржина се отстранува, а злоупотребувачките корисници се блокираат."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter følges opp innen 24 timer: støtende innhold fjernes, og brukere som misbruker tjenesten, utestenges."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По жалобам принимаются меры в течение 24 часов: неприемлемый контент удаляется, а нарушители блокируются."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Warbixinnada waa laga qaadaa tallaabo 24 saacadood gudahood: waxyaabaha aan la aqbali karin waa laga saaraa, isticmaalayaasha xad-gudbayana waa la xannibaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmälningar åtgärdas inom 24 timmar: stötande innehåll tas bort och missbrukande användare stängs av."
          }
        }
      }
    },
    "terms_contact_report_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ عن محتوى مرفوض أو إساءة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeld anstødeligt indhold eller misbrug"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstößige Inhalte oder Missbrauch melden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report abuse or objectionable content"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Denunciar contenido objetable o abuso"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزارش آزار یا محتوای نامناسب"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoita väärinkäytöstä tai loukkaavasta sisällöstä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler un abus ou un contenu répréhensible"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријави несоодветна содржина или злоупотреба"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter støtende innhold eller misbruk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщить о неприемлемом контенте или злоупотреблении"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka warbixi waxyaabaha aan la aqbali karin ama xad-gudubka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapportera stötande innehåll eller kränkande beteende"
          }
        }
      }
    },
    "tip_appeal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إعلانات في Rún ولا مستثمرين، ولا يبيع بياناتك أبدًا. أي إكرامية — مهما كان حجمها — تساعد على إبقائه مجانيًا ومستقلًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har ingen reklamer, ingen investorer og sælger aldrig dine data. Et tip — uanset størrelsen — hjælper med at holde appen gratis og uafhængig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún hat keine Werbung, keine Investoren und verkauft niemals deine Daten. Ein Trinkgeld — in beliebiger Höhe — hilft, die App kostenlos und unabhängig zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún has no ads, no investors, and never sells your data. A tip — any size — helps keep it free and independent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún no tiene anuncios ni inversores, y nunca vende tus datos. Una propina, del tamaño que sea, ayuda a mantenerlo gratuito e independiente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún نه تبلیغ دارد، نه سرمایه‌گذار، و هرگز داده‌های شما را نمی‌فروشد. یک انعام — به هر اندازه — به رایگان و مستقل ماندن آن کمک می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ei näytä mainoksia eikä sillä ole sijoittajia, eikä se koskaan myy tietojasi. Tippi — minkä kokoinen tahansa — auttaa pitämään sen ilmaisena ja riippumattomana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún n'a ni publicité, ni investisseurs, et ne vend jamais vos données. Un pourboire — quel qu'il soit — aide à la garder gratuite et indépendante."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún нема реклами, нема инвеститори и никогаш не ги продава вашите податоци. Секој бакшиш — без разлика на износот — помага да остане бесплатен и независен."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har ingen annonser, ingen investorer, og selger aldri dataene dine. En driks – uansett størrelse – bidrar til å holde appen gratis og uavhengig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Rún нет ни рекламы, ни инвесторов, и он никогда не продаёт ваши данные. Чаевые — любого размера — помогают ему оставаться бесплатным и независимым."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ma laha xayaysiisyo, ma laha maalgashadayaal, mana iibiso xogtaada. Bakhshiish — cabbir kastaba ha ahaatee — waxay caawisaa inay sii ahaato mid bilaash ah oo madax-bannaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har inga annonser, inga investerare och säljer aldrig dina data. En dricks — hur stor som helst — hjälper till att hålla appen gratis och oberoende."
          }
        }
      }
    },
    "tip_error_checkout_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح الدفع عبر Google Play. حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åbne betaling i Google Play. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bezahlvorgang von Google Play ließ sich nicht öffnen. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Google Play checkout. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el pago de Google Play. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحهٔ پرداخت Google Play باز نشد. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play -kassaa ei voitu avata. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir le paiement Google Play. Réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можеше да се отвори наплатата на Google Play. Обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åpne betalingen i Google Play. Prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть оформление покупки Google Play. Попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama furi karin lacag-bixinta Google Play. Isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte öppna kassan i Google Play. Försök igen."
          }
        }
      }
    },
    "tip_error_load_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الإكراميات حاليًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke indlæse tips lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Trinkgeld-Optionen konnten gerade nicht geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
