    "about_info_clearnet_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح vgab.eu في متصفحك عبر الإنترنت العادي — لا عبر Tor. يمكن للموقع ولشبكتك رؤية عنوان IP لجهازك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu åbnes i din browser over det almindelige internet — ikke Tor. Websitet og dit netværk kan se din enheds IP-adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu öffnet sich in deinem Browser über das normale Internet — nicht über Tor. Die Website und dein Netzwerk sehen die IP-Adresse deines Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu opens in your browser over the normal internet — not Tor. The website and your network can see your device's IP address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu se abre en tu navegador por internet normal, no por Tor. La web y tu red pueden ver la dirección IP de tu dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu در مرورگر شما و از راه اینترنت معمولی باز می‌شود — نه Tor. وب‌سایت و شبکهٔ شما نشانی IP دستگاهتان را می‌بینند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu avautuu selaimessasi tavallisen internetin kautta — ei Tor-verkon kautta. Sivusto ja verkkosi näkevät laitteesi IP-osoitteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu s'ouvre dans votre navigateur, sur l'internet ordinaire — pas via Tor. Le site et votre réseau peuvent voir l'adresse IP de votre appareil."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu се отвора во вашиот прелистувач преку обичниот интернет — не преку Tor. Веб-страницата и вашата мрежа можат да ја видат IP-адресата на вашиот уред."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu åpnes i nettleseren din over vanlig internett – ikke Tor. Nettstedet og nettverket ditt kan se IP-adressen til enheten din."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu откроется в вашем браузере через обычный интернет — не через Tor. Сайт и ваша сеть смогут увидеть IP-адрес вашего устройства."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu wuxuu ku furmayaa browser-kaaga isagoo adeegsanaya internetka caadiga ah — ma aha Tor. Boggan iyo shabakaddaadu waxay arki karaan cinwaanka IP-ga qalabkaaga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "vgab.eu öppnas i din webbläsare över det vanliga internet — inte Tor. Webbplatsen och ditt nätverk kan se enhetens IP-adress."
          }
        }
      }
    },
