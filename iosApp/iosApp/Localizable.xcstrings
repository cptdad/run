    "contact_list_delete_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُدمَّر كل الرسائل نهائيًا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle beskeder bliver slettet permanent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nachrichten werden endgültig vernichtet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages will be permanently destroyed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mensajes se destruirán de forma permanente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ پیام‌ها برای همیشه از بین می‌روند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki viestit tuhotaan pysyvästi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages seront définitivement détruits"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сите пораки трајно ќе бидат уништени"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle meldinger blir slettet for godt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения будут безвозвратно удалены"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhammaan fariimaha si joogto ah ayaa loo baabbi'in doonaa"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla meddelanden förstörs permanent"
          }
        }
      }
    },
