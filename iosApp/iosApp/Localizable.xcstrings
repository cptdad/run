    "protection_lever_b_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد هاتفك مفتاح العتاد، لذا ضُبطت خزنتك على مستوى حماية أدنى مما اخترته. يمكنك المحاولة مجددًا من الإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon bekræftede ikke hardwarenøglen, så din boks er sat til et lavere beskyttelsesniveau, end du valgte. Du kan prøve igen i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon hat den Hardware-Schlüssel nicht bestätigt, deshalb steht dein Tresor auf einer niedrigeren Schutzstufe als der gewählten. Du kannst es in den Einstellungen erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone didn't confirm the hardware key, so your vault is set to a lower protection level than you chose. You can try again from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono no ha confirmado la clave de hardware, así que tu caja fuerte queda con un nivel de protección más bajo del que elegiste. Puedes volver a intentarlo desde Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی شما کلید سخت‌افزاری را تأیید نکرد، بنابراین گاوصندوق شما روی سطح حفاظتی پایین‌تر از انتخابتان قرار گرفته است. می‌توانید از تنظیمات دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimesi ei vahvistanut laitteistoavainta, joten holvisi on valitsemaasi matalammalla suojaustasolla. Voit yrittää uudelleen asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone n'a pas confirmé la clé matérielle : votre coffre-fort est donc réglé à un niveau de protection inférieur à celui que vous avez choisi. Vous pouvez réessayer depuis les Paramètres."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот телефон не го потврди хардверскиот клуч, па вашиот трезор е поставен на пониско ниво на заштита од она што го избравте. Можете да се обидете повторно од Поставки."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen bekreftet ikke maskinvarenøkkelen, så hvelvet ditt er satt til et lavere beskyttelsesnivå enn du valgte. Du kan prøve igjen fra Innstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон не подтвердил аппаратный ключ, поэтому для хранилища установлен более низкий уровень защиты, чем вы выбрали. Вы можете повторить попытку в настройках."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankaagu ma xaqiijin furaha qalabka, sidaas darteed khasnaddaadu waxay ku dhisan tahay heer ilaalin ka hooseeya kii aad dooratay. Mar kale waxaad ka isku dayi kartaa Dejinta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen bekräftade inte hårdvarunyckeln, så ditt valv ligger på en lägre skyddsnivå än den du valde. Du kan försöka igen från Inställningar."
          }
        }
      }
    },
    "protection_lever_b_reharden_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج مفتاح الحماية لديك إلى ترقية. أطفئ «آمن» ثم شغّله من جديد لإعادة تحصينه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beskyttelsesnøgle skal opdateres. Slå Sikker fra og til igen for at hærde den på ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schutzschlüssel muss aktualisiert werden. Schalte Sicher einmal aus und wieder ein, um ihn erneut zu härten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your protection key needs an upgrade. Turn the Secure tier off and on again to re-harden it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de protección necesita una actualización. Desactiva y vuelve a activar Seguro para reforzarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید حفاظتی شما نیاز به ارتقا دارد. «امن» را خاموش و دوباره روشن کنید تا دوباره تقویت شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojausavaimesi vaatii päivityksen. Kytke Turva pois päältä ja takaisin päälle koventaaksesi sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé de protection doit être mise à niveau. Désactivez puis réactivez Sécurisé pour la renforcer à nouveau."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот заштитен клуч треба надградба. Исклучете и повторно вклучете Безбедно, за да го зацврстите одново."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskyttelsesnøkkelen din må oppgraderes. Slå Sikker av og på igjen for å herde den på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ защиты нуждается в обновлении. Выключите и снова включите уровень «Защищённый», чтобы заново его укрепить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Furaha ilaalintaada wuxuu u baahan yahay horumarin. Dami oo mar kale shid Ammaan si aad mar kale u adkeyso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skyddsnyckel behöver uppgraderas. Stäng av och slå på Säker igen för att härda den på nytt."
          }
        }
      }
    },
    "protection_migration_almost_there_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوشكت على الانتهاء"
          }
        },
        "da": {
