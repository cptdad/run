    "contact_list_group_invite_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعاك %1$@ إلى المجموعة «%2$@»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har inviteret dig til gruppen “%2$@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat dich in die Gruppe „%2$@“ eingeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ invited you to the group “%2$@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ te ha invitado al grupo “%2$@”."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ شما را به گروه «%2$@» دعوت کرده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kutsui sinut ryhmään ”%2$@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vous invite à rejoindre le groupe « %2$@ »."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ве покани во групата „%2$@“."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inviterte deg til gruppen «%2$@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ приглашает вас в группу «%2$@»."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaad heshay casuumad ka timid %1$@ oo ah inaad ku biirto kooxda “%2$@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har bjudit in dig till gruppen ”%2$@”."
          }
        }
      }
    },
    "contact_list_group_invite_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ دعاك %1$@ إلى «%2$@»، لكن هذه المجموعة كانت لديك سابقًا تحت مشرف مختلف تمامًا. لا تنضم إلا إذا كنت تأتمن %1$@ على التحكم في عضوية هذه المجموعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ har inviteret dig til “%2$@”, men du har tidligere haft denne gruppe under en ANDEN administrator. Deltag kun, hvis du stoler på, at %1$@ styrer, hvem der er med i gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ hat dich zu „%2$@“ eingeladen, aber du hattest diese Gruppe zuvor unter einem ANDEREN Administrator. Tritt nur bei, wenn du darauf vertraust, dass %1$@ über die Mitglieder dieser Gruppe bestimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ invited you to “%2$@”, but you previously had this group under a DIFFERENT administrator. Only join if you trust %1$@ to control this group’s membership."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ te ha invitado a “%2$@”, pero antes tenías este grupo con OTRO administrador. Únete solo si confías en que %1$@ controle quién forma parte de este grupo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ شما را به «%2$@» دعوت کرده است، اما این گروه را قبلاً زیر نظر مدیر «دیگری» داشتید. فقط در صورتی بپیوندید که به %1$@ برای کنترل عضویت این گروه اعتماد دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ kutsui sinut ryhmään ”%2$@”, mutta sinulla oli tämä ryhmä aiemmin ERI ylläpitäjän alaisuudessa. Liity vain, jos luotat siihen, että %1$@ hallitsee tämän ryhmän jäsenyyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ vous invite à « %2$@ », mais vous aviez déjà ce groupe sous un administrateur DIFFÉRENT. Ne le rejoignez que si vous faites confiance à %1$@ pour gérer les membres de ce groupe."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ ве покани во „%2$@“, но претходно ја имавте оваа група под ДРУГ администратор. Приклучете се само ако имате доверба во %1$@ да го контролира членството во оваа група."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ inviterte deg til «%2$@», men denne gruppen hadde du tidligere under en ANNEN administrator. Bli bare med hvis du stoler på at %1$@ styrer medlemslisten i gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ приглашает вас в «%2$@», но ранее эта группа была у вас с ДРУГИМ администратором. Присоединяйтесь только в том случае, если доверяете %1$@ управлять составом этой группы."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Waxaad heshay casuumad ka timid %1$@ oo ah kooxda “%2$@”, laakiin hore ayaad kooxdan u haysay maamule KALE. Kaliya ku biir haddii aad kalsoonaan ku qabto maamulka %1$@ ee xubinnimada kooxdan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ %1$@ har bjudit in dig till ”%2$@”, men du hade tidigare den här gruppen under en ANNAN administratör. Gå bara med om du litar på att %1$@ styr vilka som är med i gruppen."
          }
        }
      }
    },
