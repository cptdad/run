    "group_info_transfer_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتغيّر شيء — ما زلت أنت المشرف، فالمجموعة تبقى قابلة للإدارة. حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev ændret — du er stadig admin, så gruppen kan stadig styres. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat sich nichts geändert — du bist weiterhin Admin, die Gruppe bleibt also verwaltbar. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changed — you’re still the admin, so the group stays manageable. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha cambiado nada: sigues siendo el administrador, así que el grupo se puede seguir gestionando. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی تغییر نکرد — شما همچنان مدیر هستید و گروه قابل مدیریت می‌ماند. دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei muuttunut — olet yhä ylläpitäjä, joten ryhmä pysyy hallittavissa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a changé — vous êtes toujours l'administrateur, le groupe reste donc gérable. Réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништо не се промени — сè уште сте администратор, па групата и понатаму може да се управува. Обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble endret – du er fortsatt administrator, så gruppen kan fortsatt styres. Prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменилось — вы всё ещё администратор, поэтому группой по-прежнему можно управлять. Попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxba isma beddelin — weli waxaad tahay maamulaha, sidaas darteed kooxda si fudud ayaa loo maamuli karaa. Mar kale isku day."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ändrades — du är fortfarande admin, så gruppen går att hantera. Försök igen."
          }
        }
      }
    },
    "group_info_transfer_failed_title": {
      "extractionState": "manual",
      "localizations": {
