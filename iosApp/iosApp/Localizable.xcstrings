    "pin_setup_passphrase_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ست كلمات عشوائية تقريبًا. تكتبها عند كل فتح للقفل — فلا رمز PIN ولا اختصار بالبصمة أو الوجه. وهذا هو المقصود تمامًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirka seks tilfældige ord. Den skal skrives ved hver oplåsning — der er ingen PIN og ingen biometrisk genvej. Det er hele pointen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa sechs zufällige Wörter. Bei jedem Entsperren einzutippen — es gibt keine PIN und keine biometrische Abkürzung. Genau das ist der Sinn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six or so random words. Typed at every unlock — there is no PIN and no biometric shortcut. That’s the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas seis palabras al azar. Se escribe en cada desbloqueo: no hay PIN ni atajo biométrico. De eso se trata."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حدود شش واژهٔ تصادفی. در هر بار باز کردن قفل باید تایپ شود — نه PIN در کار است و نه میان‌بر بیومتریک. نکته دقیقاً همین است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin kuusi satunnaista sanaa. Kirjoitat sen joka avauskerralla — PIN-koodia tai biometrista oikotietä ei ole. Juuri se on tarkoitus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ six mots pris au hasard. À saisir à chaque déverrouillage — pas de code PIN, pas de raccourci biométrique. C'est tout l'intérêt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Околу шест случајни зборови. Се впишуваат при секое отклучување — нема PIN и нема биометриска кратенка. Тоа е поентата."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundt seks tilfeldige ord. Skrives inn hver gang du låser opp – ingen PIN, ingen biometrisk snarvei. Det er hele poenget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около шести случайных слов. Вводится при каждой разблокировке — здесь нет ни PIN-кода, ни быстрого входа по биометрии. В этом и есть смысл."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lix eray oo random ah ama wax ku dhow. Waxaa lagu qoraa mar kasta oo la furayo — ma jiro PIN, mana jiro jid gaaban oo biometric ah. Taasi waa ujeeddada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär sex slumpmässiga ord. Skrivs in vid varje upplåsning — ingen PIN-kod och ingen biometrisk genväg. Det är hela poängen."
          }
        }
      }
    },
