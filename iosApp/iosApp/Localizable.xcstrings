    "move_qr_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الهاتف الجديد، افتح Rún واختر «النقل من هاتف آخر»، ثم امسح هذا الرمز."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Rún på den nye telefon, vælg “Flyt fra en anden telefon”, og scan denne kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf dem neuen Handy Rún, wähle „Von einem anderen Handy übertragen“ und scanne diesen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the new phone, open Rún, choose “Move from another phone”, and scan this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teléfono nuevo, abre Rún, elige “Mover desde otro teléfono” y escanea este código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی گوشی جدید، Rún را باز کنید، «انتقال از گوشی دیگر» را انتخاب کنید و این کد را اسکن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Rún uudella puhelimella, valitse ”Siirrä toiselta puhelimelta” ja lue tämä koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le nouveau téléphone, ouvrez Rún, choisissez « Transférer depuis un autre téléphone », puis scannez ce code."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На новиот телефон отворете го Rún, изберете „Премести од друг телефон“ и скенирајте го овој код."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På den nye telefonen åpner du Rún, velger «Flytt fra en annen telefon» og skanner denne koden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На новом телефоне откройте Rún, выберите «Перенести с другого телефона» и отсканируйте этот код."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefanka cusub, fur Rún, dooro “Ka wareeji taleefan kale”, kadibna koodhkan sawir garee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Rún på den nya telefonen, välj ”Flytta från en annan telefon” och skanna koden."
          }
        }
      }
    },
