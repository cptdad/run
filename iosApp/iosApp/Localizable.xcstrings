    "protection_recovery_code_body_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبه واحتفظ به في مكان آمن بعيدًا عن هاتفك. إذا تغيّرت بصمتك أو رمز دخول جهازك يومًا ومنعك ذلك من فتح الخزنة، فهذا الرمز مع رمز PIN يستعيد رسائلك. لا يمكننا عرضه مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den ned, og opbevar den et sikkert sted væk fra din telefon. Hvis dit fingeraftryk eller enhedens adgangskode en dag ændrer sig og låser dig ude, kan denne kode sammen med din PIN gendanne dine beskeder. Vi kan ikke vise den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib ihn auf und bewahre ihn sicher und getrennt von deinem Telefon auf. Falls sich dein Fingerabdruck oder dein Gerätecode jemals ändert und dich aussperrt, stellt dieser Code zusammen mit deiner PIN deine Nachrichten wieder her. Wir können ihn kein zweites Mal anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write this down and keep it somewhere safe and separate from your phone. If your fingerprint or device passcode ever changes and locks you out, this code plus your PIN restores your messages. We can't show it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apúntalo y guárdalo en un sitio seguro, lejos del teléfono. Si tu huella o el código de tu dispositivo cambian y te dejan fuera, este código junto con tu PIN restaura tus mensajes. No podemos volver a mostrártelo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن را بنویسید و در جایی امن و جدا از گوشی خود نگه دارید. اگر روزی اثر انگشت یا رمز دستگاهتان تغییر کند و پشت در بمانید، این کد به‌همراه PIN شما پیام‌هایتان را بازمی‌گرداند. نمی‌توانیم آن را دوباره نشان دهیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita tämä ylös ja säilytä se turvallisessa paikassa erillään puhelimestasi. Jos sormenjälkesi tai laitteen pääsykoodi joskus muuttuu ja lukitset itsesi ulos, tämä koodi ja PIN-koodisi palauttavat viestisi. Emme voi näyttää sitä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez-le et conservez-le en lieu sûr, séparé de votre téléphone. Si votre empreinte ou le code de votre appareil change un jour et vous bloque, ce code associé à votre code PIN restaure vos messages. Nous ne pourrons pas vous le remontrer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишете го ова и чувајте го на безбедно место, одвоено од вашиот телефон. Ако вашиот отпечаток или код за пристап на уредот некогаш се промени и останете без пристап, овој код заедно со вашиот PIN ги враќа вашите пораки. Не можеме повторно да го прикажеме."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den ned og oppbevar den trygt, atskilt fra telefonen. Hvis fingeravtrykket eller koden på enheten din endres og låser deg ute, gjenoppretter denne koden sammen med PIN-koden din meldingene dine. Vi kan ikke vise den igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите этот код и храните его в надёжном месте отдельно от телефона. Если ваш отпечаток пальца или код-пароль устройства когда-нибудь изменится и заблокирует вам доступ, этот код вместе с вашим PIN-кодом восстановит ваши сообщения. Мы не сможем показать его снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan qor, kaydina meel ammaan ah oo ka duwan taleefankaaga. Haddii far-raadkaaga ama passcode-ka qalabku isbeddelo oo kaa xidho, koodhkan iyo PIN-kaaga ayaa soo celinaya fariimahaaga. Mar dambe ma tusi karno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ner den och förvara den säkert, skilt från telefonen. Om ditt fingeravtryck eller enhetens lösenkod någon gång ändras och låser ute dig återställer den här koden plus din PIN-kod dina meddelanden. Vi kan inte visa den igen."
          }
        }
      }
    },
