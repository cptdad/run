            "state": "translated",
            "value": "اولین اتصال ممکن است چند دقیقه طول بکشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäinen yhteys voi kestää muutaman minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première connexion peut prendre quelques minutes."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Првото поврзување може да потрае неколку минути."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første tilkoblingen kan ta noen minutter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое подключение может занять несколько минут."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xidhiidhka ugu horreeya wuxuu qaadan karaa dhawr daqiiqadood."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den första anslutningen kan ta några minuter."
          }
        }
      }
