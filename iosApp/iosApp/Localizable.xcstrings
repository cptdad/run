    "move_handle_caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ هذا إلى الهاتف الجديد إذا لم تتعاون الكاميرا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér denne til den nye telefon, hvis kameraet ikke vil samarbejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere das ins neue Handy, wenn die Kamera nicht mitspielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this into the new phone if the camera will not cooperate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia esto en el teléfono nuevo si la cámara no coopera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر دوربین همکاری نکرد، این را در گوشی جدید کپی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi tämä uuteen puhelimeen, jos kameran lukeminen ei onnistu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez ceci sur le nouveau téléphone si l'appareil photo refuse de coopérer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирајте го ова во новиот телефон ако камерата не соработува."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér dette inn i den nye telefonen hvis kameraet ikke vil samarbeide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте это на новый телефон, если не получается воспользоваться камерой."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ku koobi taleefanka cusub haddii kamaraddu shaqayn weydo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera in den här på den nya telefonen om kameran krånglar."
          }
        }
