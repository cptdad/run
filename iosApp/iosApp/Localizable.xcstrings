            "value": "Presque terminé"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Речиси готово"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesten i mål"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти готово"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku dhawaad dhammaatay"
          }
        },
        "sv": {
