          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de tu dispositivo ha cambiado, así que la clave de hardware que protegía esta caja fuerte ya no existe. Tu código de recuperación todavía puede abrirla."
