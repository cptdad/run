    "debug_mode_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل سجلات تشخيصية مجهولة إلى المُرحّل للمساعدة في التطوير. لا تتضمّن السجلات أبدًا أي شيء يحدّد هويتك أو هوية هذا الجهاز: لا أسماء، ولا محتوى رسائل، ولا عناوين، ولا مفاتيح، ولا معرّفات صناديق وارد أو جهات اتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send anonyme diagnoselogge til relæet for at hjælpe udviklingen. Loggene indeholder aldrig noget, der identificerer dig eller denne enhed: ingen navne, intet beskedindhold, ingen adresser, ingen nøgler, ingen indbakke- eller kontakt-id'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende anonyme Diagnoseprotokolle an das Relay, um die Entwicklung zu unterstützen. Die Protokolle enthalten nie etwas, das dich oder dieses Gerät identifiziert: keine Namen, keine Nachrichteninhalte, keine Adressen, keine Schlüssel, keine Postfach- oder Kontakt-IDs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send anonymous diagnostic logs to the relay to help development. The logs never include anything that identifies you or this device: no names, no message content, no addresses, no keys, no inbox or contact ids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía registros de diagnóstico anónimos al relay para ayudar al desarrollo. Los registros nunca incluyen nada que te identifique a ti ni a este dispositivo: ni nombres, ni contenido de mensajes, ni direcciones, ni claves, ni identificadores de buzón o de contacto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای کمک به توسعه، گزارش‌های تشخیصی ناشناس را به رله بفرستید. این گزارش‌ها هرگز شامل چیزی نمی‌شوند که هویت شما یا این دستگاه را مشخص کند: نه نام، نه محتوای پیام، نه نشانی، نه کلید، نه شناسهٔ صندوق ورودی یا مخاطب."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä anonyymeja diagnostiikkalokeja välityspalvelimelle kehityksen tueksi. Lokit eivät koskaan sisällä mitään, mikä tunnistaa sinut tai tämän laitteen: ei nimiä, ei viestien sisältöä, ei osoitteita, ei avaimia, ei postilaatikko- tai kontaktitunnuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez des journaux de diagnostic anonymes au relais pour aider au développement. Les journaux ne contiennent jamais rien qui permette de vous identifier, vous ou cet appareil : aucun nom, aucun contenu de message, aucune adresse, aucune clé, aucun identifiant de boîte de réception ou de contact."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Испраќајте анонимни дијагностички дневници до релето за да помогнете во развојот. Дневниците никогаш не содржат ништо што ве идентификува вас или овој уред: ниту имиња, ниту содржина на пораки, ниту адреси, ниту клучеви, ниту идентификатори на сандачиња или контакти."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send anonyme diagnoselogger til relayet for å hjelpe utviklingen. Loggene inneholder aldri noe som identifiserer deg eller denne enheten: ingen navn, ikke noe meldingsinnhold, ingen adresser, ingen nøkler, ingen innboks- eller kontakt-ID-er."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте анонимные диагностические журналы на ретранслятор, чтобы помочь разработке. Журналы никогда не содержат ничего, что идентифицирует вас или это устройство: ни имён, ни содержимого сообщений, ни адресов, ни ключей, ни идентификаторов почтовых ящиков или контактов."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "U dir relay-ga diiwaanno baaritaan oo qarsoodi ah si aad u caawiso horumarinta. Diiwaannada waligood kuma jiro wax lagu aqoonsan karo adiga ama qalabkan: ma jiraan magacyo, ma jiro waxa ku jira farriimaha, ma jiraan cinwaanno, ma jiraan furayaal, mana jiraan aqoonsiyo sanduuq ama xiriiriye."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka anonyma diagnostikloggar till reläet för att hjälpa utvecklingen. Loggarna innehåller aldrig något som identifierar dig eller den här enheten: inga namn, inget meddelandeinnehåll, inga adresser, inga nycklar, inga inkorgs- eller kontakt-id."
          }
        }
      }
    },
    "debug_mode_message_off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع تصحيح الأخطاء مُفعَّل. عطّله لإيقاف إرسال السجلات التشخيصية المجهولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejlfindingstilstand er slået til. Slå den fra for at stoppe med at sende anonyme diagnoselogge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Debug-Modus ist an. Schalte ihn aus, um keine anonymen Diagnoseprotokolle mehr zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug mode is on. Turn it off to stop sending anonymous diagnostic logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de depuración está activado. Desactívalo para dejar de enviar registros de diagnóstico anónimos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت اشکال‌زدایی روشن است. برای توقف ارسال گزارش‌های تشخیصی ناشناس، آن را خاموش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virheenkorjaustila on käytössä. Poista se käytöstä, niin anonyymien diagnostiikkalokien lähettäminen loppuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode débogage est activé. Désactivez-le pour ne plus envoyer de journaux de diagnostic anonymes."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимот за дебагирање е вклучен. Исклучете го за да престанете да испраќате анонимни дијагностички дневници."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feilsøkingsmodus er på. Slå den av for å slutte å sende anonyme diagnoselogger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим отладки включён. Выключите его, чтобы перестать отправлять анонимные диагностические журналы."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Habka debug-ga waa shidan yahay. Dami si aad u joojiso dirista diiwaannada baaritaanka ee qarsoodiga ah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Felsökningsläget är på. Stäng av det för att sluta skicka anonyma diagnostikloggar."
          }
        }
      }
    },
