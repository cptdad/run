    "group_notice_not_delivered": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل رسالتك إلى %1$lld من الأعضاء: لا يمكن الوصول إليهم بعد من هذا الهاتف، أو رفض المُرحّل نسختهم. لا يحتفظ Rún بأي نسخة لإرسالها لاحقًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din besked nåede ikke frem til %1$lld af medlemmerne: de kan ikke nås endnu fra denne telefon, eller relæet afviste deres kopi. Rún gemmer ingen kopi til at sende senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht hat %1$lld der Mitglieder nicht erreicht: von diesem Handy aus noch nicht erreichbar, oder das Relay hat ihre Kopie abgelehnt. Rún behält keine Kopie, um sie später zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message did not reach %1$lld of the members: not yet reachable from this phone, or the relay refused their copy. Rún keeps no copy to send later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje no llegó a %1$lld de los miembros: aún fuera de alcance desde este teléfono, o el relay rechazó su copia. Rún no guarda ninguna copia para enviarla más tarde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام شما به %1$lld نفر از اعضا نرسید: هنوز از این گوشی در دسترس نیستند، یا رله نسخهٔ آن‌ها را رد کرد. Rún هیچ نسخه‌ای برای ارسال بعدی نگه نمی‌دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi ei tavoittanut %1$lld jäsenistä: ei vielä tavoitettavissa tästä puhelimesta, tai välityspalvelin hylkäsi heidän kopionsa. Rún ei säilytä kopiota myöhemmin lähetettäväksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message n'a pas atteint %1$lld des membres : pas encore joignables depuis ce téléphone, ou le relais a refusé leur copie. Rún ne garde aucune copie à envoyer plus tard."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашата порака не стигна до %1$lld од членовите: сè уште недостапни од овој телефон, или релето ја одби нивната копија. Rún не чува копија за подоцнежно испраќање."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen din nådde ikke %1$lld av medlemmene: de kan ikke nås ennå fra denne telefonen, eller relayet avviste kopien deres. Rún beholder ingen kopi for å sende den senere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение не дошло до некоторых участников (%1$lld): они пока недоступны с этого телефона, или ретранслятор отклонил их копию. Rún не хранит копию, чтобы отправить её позже."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fariintaadu ma gaarin %1$lld ka mid ah xubnaha: weli lama gaari karo, laga bilaabo taleefankan, ama relay-ga ayaa diiday nuqulkooda. Rún ma hayo nuqul uu mar dambe diro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt meddelande nådde inte %1$lld av medlemmarna: de går inte att nå än från den här telefonen, eller så nekade reläet deras kopia. Rún sparar ingen kopia att skicka senare."
          }
        }
      }
    },
