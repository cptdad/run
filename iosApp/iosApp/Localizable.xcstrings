    "pin_device_key_busy_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العتاد الآمن في هاتفك مشغول. اقفل هاتفك ثم افتح قفله وحاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonens sikre hardware er optaget. Lås din telefon, lås den op igen, og prøv en gang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sichere Hardware deines Telefons ist beschäftigt. Sperre dein Telefon, entsperre es und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone’s secure hardware is busy. Lock your phone, unlock it, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hardware seguro de tu teléfono está ocupado. Bloquea el teléfono, desbloquéalo y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سخت‌افزار امن گوشی شما مشغول است. گوشی را قفل کنید، قفل آن را باز کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimesi suojattu laitteisto on varattu. Lukitse puhelimesi, avaa se ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel sécurisé de votre téléphone est occupé. Verrouillez votre téléphone, déverrouillez-le, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безбедносниот хардвер на вашиот телефон е зафатен. Заклучете го телефонот, отклучете го и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetsmaskinvaren i telefonen er opptatt. Lås telefonen, lås den opp igjen, og prøv på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппаратный модуль безопасности вашего телефона занят. Заблокируйте телефон, разблокируйте его и попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalabka ammaanka ee taleefankaagu waa mashquul. Xir taleefankaaga, dib u fur, kadibna mar kale isku day."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonens säkra hårdvara är upptagen. Lås telefonen, lås upp den och försök igen."
          }
        }
      }
    },
