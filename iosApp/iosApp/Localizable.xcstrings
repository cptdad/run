            "state": "translated",
            "value": "بیومتریک در دسترس نیست. Face ID یا اثر انگشت را راه‌اندازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometristä tunnistusta ei ole käytettävissä. Ota Face ID tai sormenjälki käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La biométrie est absente. Configurez Face ID ou une empreinte."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометријата недостасува. Поставете Face ID или отпечаток."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometri mangler. Sett opp Face ID eller fingeravtrykk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометрия недоступна. Настройте Face ID или отпечаток пальца."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrics wuu maqan yahay. Deji Face ID ama far-raad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometri saknas. Ställ in Face ID eller fingeravtryck."
          }
        }
      }
