    "notif_settings_unregistered_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف موزّع الإشعارات لديك عن التسليم إلى Rún، لذا أُوقفت الإشعارات. شغّلها من جديد لإعادة الاتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notifikationsdistributør holdt op med at levere til Rún, så notifikationer blev slået fra. Slå dem til igen for at genoprette forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Benachrichtigungs-Distributor liefert nicht mehr an Rún, deshalb wurden Benachrichtigungen ausgeschaltet. Schalte sie wieder ein, um die Verbindung neu herzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notification distributor stopped delivering to Rún, so notifications were turned off. Turn them back on to reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu distribuidor de notificaciones dejó de entregar a Rún, así que las notificaciones se desactivaron. Vuelve a activarlas para reconectar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توزیع‌کنندهٔ اعلان شما دیگر به Rún تحویل نمی‌دهد، بنابراین اعلان‌ها خاموش شدند. برای اتصال دوباره، آن‌ها را دوباره روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välittäjäsovelluksesi lakkasi toimittamasta herätyksiä Rún-sovellukselle, joten ilmoitukset kytkettiin pois päältä. Ota ne takaisin käyttöön, niin yhteys muodostuu uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre distributeur de notifications a cessé de livrer à Rún : les notifications ont donc été désactivées. Réactivez-les pour vous reconnecter."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот дистрибутер за известувања престана да испорачува до Rún, па известувањата беа исклучени. Вклучете ги повторно за да се поврзете одново."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varseldistributøren din sluttet å levere til Rún, så varsler ble slått av. Slå dem på igjen for å koble til på nytt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибьютор уведомлений перестал доставлять их в Rún, поэтому уведомления были отключены. Включите их снова, чтобы восстановить соединение."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaybiyaha ogeysiiskaagu wuu joojiyay gaarsiinta Rún, sidaa darteed ogeysiisyada waa la damiyay. Mar kale shid si aad dib ula xiriirto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din notisdistributör slutade leverera till Rún, så notiserna stängdes av. Slå på dem igen för att återansluta."
          }
        }
      }
    },
