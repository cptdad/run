        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Turva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurisé"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безбедно"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённый"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ammaan"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säker"
          }
        }
      }
    },
    "protection_tier_tagline_casual": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز PIN من ستة أرقام لفتح Rún. يمكن لأدوات التحليل الجنائي كسره بالقوة الغاشمة خلال ساعات، لذا يعتمد Rún اعتمادًا كاملًا على حماية الهاتف. على Android، تبقى اقتراحات لوحة المفاتيح والرموز التعبيرية مفعّلة، لذا قد تتعلّم لوحة المفاتيح كلمات تكتبها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekscifret PIN-kode til at åbne Rún. Kan knækkes med brute force af forensiske værktøjer på få timer, så Rún læner sig fuldt og helt op ad telefonens egen beskyttelse. På Android forbliver tastaturets ordforslag og emoji slået til, så tastaturet kan lære ord, du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechsstelliger PIN-Code zum Öffnen von Rún. Forensische Werkzeuge knacken ihn per Brute Force in Stunden, deshalb verlässt sich Rún ganz auf den Schutz des Telefons. Unter Android bleiben Tastaturvorschläge und Emojis an, sodass die Tastatur Wörter lernen kann, die du tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six digit pin code for opening Rún. Can be brute forced by forensic tools in hours, so Rún relies fully on the phone protection. On Android, keyboard suggestions and emoji stay on, so the keyboard may learn words you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código PIN de seis dígitos para abrir Rún. Las herramientas forenses pueden romperlo por fuerza bruta en unas horas, así que Rún depende por completo de la protección del teléfono. En Android, las sugerencias del teclado y los emojis siguen activados, así que el teclado puede aprender palabras que escribes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN شش‌رقمی برای باز کردن Rún. ابزارهای فارنزیک می‌توانند آن را در چند ساعت با جستجوی فراگیر بشکنند، پس Rún کاملاً به حفاظت خود گوشی تکیه می‌کند. در Android، پیشنهادهای صفحه‌کلید و ایموجی روشن می‌مانند، پس ممکن است صفحه‌کلید واژه‌هایی را که می‌نویسید یاد بگیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuusinumeroinen PIN-koodi Rún-sovelluksen avaamiseen. Forensiset työkalut voivat murtaa sen brute force -hyökkäyksellä tunneissa, joten Rún nojaa täysin puhelimen omaan suojaukseen. Androidissa näppäimistön sanaehdotukset ja emojit pysyvät käytössä, joten näppäimistö voi oppia kirjoittamiasi sanoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code PIN à six chiffres pour ouvrir Rún. Des outils forensiques peuvent le casser par force brute en quelques heures ; Rún s'appuie donc entièrement sur la protection du téléphone. Sur Android, les suggestions et les emoji du clavier restent actifs, le clavier peut donc apprendre les mots que vous tapez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестцифрен PIN-код за отворање на Rún. Може да биде разбиен со груба сила од форензички алатки за неколку часа, па Rún целосно се потпира на заштитата на телефонот. На Android предлозите на тастатурата и емоџите остануваат вклучени, па тастатурата може да ги научи зборовите што ги пишувате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekssifret PIN-kode for å åpne Rún. Kan knekkes med brute force av etterforskningsverktøy i løpet av timer, så Rún hviler helt på beskyttelsen i telefonen. På Android er tastaturets ordforslag og emoji fortsatt slått på, så tastaturet kan lære ord du skriver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестизначный PIN-код для открытия Rún. Криминалистические инструменты могут подобрать его за несколько часов, поэтому Rún полностью полагается на защиту самого телефона. На Android подсказки клавиатуры и эмодзи остаются включёнными, поэтому клавиатура может запоминать слова, которые вы набираете."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN lix lambar ah oo lagu furo Rún. Qalabka forensic-ka ayaa saacado gudahood brute force ku jebin kara, sidaa darteed Rún wuxuu si buuxda ugu tiirsan yahay ilaalinta taleefanka. Android-ka, soo-jeedinta erayada iyo emoji-ga keyboard-ka way shidan yihiin, markaa keyboard-ku wuxuu baran karaa erayada aad qorto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexsiffrig PIN-kod för att öppna Rún. Kan knäckas med brute force av forensiska verktyg på några timmar, så Rún förlitar sig helt på telefonens eget skydd. På Android förblir tangentbordets ordförslag och emoji påslagna, så tangentbordet kan lära sig ord du skriver."
          }
        }
      }
    },
    "protection_tier_tagline_maximum": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارة مرور طويلة بدلًا من رمز PIN — قوية بما يكفي حتى لا تستطيع أي أداة تحليل جنائي كسرها بالقوة الغاشمة، حتى من هاتف غير مقفل. تعمل لوحة المفاتيح في وضع كلمة المرور: لا يُتعلَّم أي شيء مما تكتبه ولا يُقترح، وعلى Android لا يتوفّر مفتاح الرموز التعبيرية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lang adgangssætning i stedet for en PIN-kode — så stærk, at intet forensisk værktøj kan knække den med brute force, selv fra en oplåst telefon. Tastaturet kører i adgangskodetilstand: intet af det, du skriver, bliver lært eller foreslået, og på Android er emoji-tasten utilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lange Passphrase statt eines PIN-Codes — stark genug, dass kein forensisches Werkzeug sie per Brute Force knacken kann, selbst bei einem entsperrten Telefon. Die Tastatur läuft im Passwortmodus: Nichts, was du tippst, wird gelernt oder vorgeschlagen, und unter Android ist die Emoji-Taste nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long passphrase instead of a pin code — strong enough that no forensic tool can brute force it, even from an unlocked phone. The keyboard runs in password mode: nothing you type is learned or suggested, and on Android the emoji key is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase de contraseña larga en lugar de un código PIN, tan fuerte que ninguna herramienta forense puede romperla por fuerza bruta, ni siquiera desde un teléfono desbloqueado. El teclado funciona en modo contraseña: nada de lo que escribes se aprende ni se sugiere, y en Android la tecla de emojis no está disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌جای PIN، یک عبارت عبور بلند — آن‌قدر قوی که هیچ ابزار فارنزیکی نمی‌تواند آن را با جستجوی فراگیر بشکند، حتی از روی گوشی باز. صفحه‌کلید در حالت گذرواژه کار می‌کند: هیچ‌چیزی از آنچه می‌نویسید یاد گرفته یا پیشنهاد نمی‌شود، و در Android کلید ایموجی در دسترس نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkä salalause PIN-koodin sijaan — niin vahva, ettei mikään forensinen työkalu pysty murtamaan sitä brute force -hyökkäyksellä, ei edes avatusta puhelimesta. Näppäimistö toimii salasanatilassa: mitään kirjoittamaasi ei opita eikä ehdoteta, eikä Androidissa emoji-näppäin ole käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une longue phrase secrète à la place d'un code PIN — assez forte pour qu'aucun outil forensique ne puisse la casser par force brute, même depuis un téléphone déverrouillé. Le clavier passe en mode mot de passe : rien de ce que vous tapez n'est appris ni suggéré, et sur Android la touche emoji est indisponible."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Долга тајна фраза наместо PIN-код — доволно силна за да не може ниту една форензичка алатка да ја разбие со груба сила, дури и од отклучен телефон. Тастатурата работи во режим за лозинка: ништо од тоа што го пишувате не се учи ниту се предлага, а на Android копчето за емоџи е недостапно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lang passfrase i stedet for en PIN-kode – sterk nok til at ingen etterforskningsverktøy kan knekke den med brute force, selv fra en ulåst telefon. Tastaturet kjører i passordmodus: ingenting du skriver blir lært eller foreslått, og på Android er emoji-tasten utilgjengelig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинная парольная фраза вместо PIN-кода — достаточно надёжная, чтобы её не смог подобрать ни один криминалистический инструмент, даже с разблокированного телефона. Клавиатура работает в режиме пароля: ничего из набранного вами не запоминается и не подсказывается, а на Android клавиша эмодзи недоступна."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weedh sir ah oo dheer halkii PIN ahaan — mid xoog badan oo aan qalab forensic ah brute force ku jebin karin, xitaa haddii taleefanku furan yahay. Keyboard-ku wuxuu ku shaqeeyaa habka erayga sirta ah: waxa aad qorto lama barto lamana soo jeediyo, Android-kana badhanka emoji-ga lama heli karo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lång lösenfras i stället för en PIN-kod — så stark att inget forensiskt verktyg kan knäcka den med brute force, inte ens från en upplåst telefon. Tangentbordet körs i lösenordsläge: inget du skriver lärs in eller föreslås, och på Android är emoji-tangenten inte tillgänglig."
          }
        }
      }
    },
    "protection_tier_tagline_private": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز PIN من ستة أرقام، لكن مفتاح الخزنة مختوم داخل شريحة الأمان في الهاتف ولا يُطلَق إلا ببصمتك أو وجهك. الهاتف المُصادَر يقاوم هجمات القوة الغاشمة الجنائية حتى لو كُسر رمز دخوله. على Android، تبقى اقتراحات لوحة المفاتيح والرموز التعبيرية مفعّلة، لذا قد تتعلّم لوحة المفاتيح كلمات تكتبها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekscifret PIN-kode, men boksens nøgle er forseglet i telefonens sikkerhedschip og frigives kun af dit fingeraftryk eller ansigt. En beslaglagt telefon står imod forensisk brute force, selv hvis dens adgangskode bliver knækket. På Android forbliver tastaturets ordforslag og emoji slået til, så tastaturet kan lære ord, du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechsstelliger PIN-Code, aber der Tresorschlüssel liegt versiegelt im Sicherheitschip des Telefons und wird nur durch deinen Fingerabdruck oder dein Gesicht freigegeben. Ein beschlagnahmtes Telefon widersteht forensischen Brute-Force-Angriffen, selbst wenn sein Gerätecode geknackt wird. Unter Android bleiben Tastaturvorschläge und Emojis an, sodass die Tastatur Wörter lernen kann, die du tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six digit pin code, but the vault key is sealed in the phone's security chip and released only by your fingerprint or face. A seized phone resists forensic brute-forcing even if its passcode is cracked. On Android, keyboard suggestions and emoji stay on, so the keyboard may learn words you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código PIN de seis dígitos, pero la clave de la caja fuerte queda sellada en el chip de seguridad del teléfono y solo la libera tu huella o tu cara. Un teléfono incautado resiste la fuerza bruta forense aunque le rompan el código. En Android, las sugerencias del teclado y los emojis siguen activados, así que el teclado puede aprender palabras que escribes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN شش‌رقمی، اما کلید گاوصندوق در تراشهٔ امنیتی گوشی مهر و موم شده و فقط با اثر انگشت یا چهرهٔ شما آزاد می‌شود. گوشی ضبط‌شده در برابر جستجوی فراگیرِ فارنزیک مقاومت می‌کند، حتی اگر رمز خود گوشی شکسته شود. در Android، پیشنهادهای صفحه‌کلید و ایموجی روشن می‌مانند، پس ممکن است صفحه‌کلید واژه‌هایی را که می‌نویسید یاد بگیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuusinumeroinen PIN-koodi, mutta holvin avain on sinetöity puhelimen turvasiruun ja vapautuu vain sormenjäljelläsi tai kasvoillasi. Takavarikoitu puhelin kestää forensiset brute force -hyökkäykset, vaikka sen pääsykoodi murrettaisiin. Androidissa näppäimistön sanaehdotukset ja emojit pysyvät käytössä, joten näppäimistö voi oppia kirjoittamiasi sanoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code PIN à six chiffres, mais la clé du coffre-fort est scellée dans la puce de sécurité du téléphone et libérée uniquement par votre empreinte ou votre visage. Un téléphone saisi résiste aux attaques par force brute des outils forensiques, même si son code est cassé. Sur Android, les suggestions et les emoji du clavier restent actifs, le clavier peut donc apprendre les mots que vous tapez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестцифрен PIN-код, но клучот на трезорот е заклучен во безбедносниот чип на телефонот и се ослободува само со вашиот отпечаток или лице. Заплениот телефон одолева на форензичко разбивање со груба сила дури и ако неговиот код за пристап биде откриен. На Android предлозите на тастатурата и емоџите остануваат вклучени, па тастатурата може да ги научи зборовите што ги пишувате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekssifret PIN-kode, men nøkkelen til hvelvet forsegles i sikkerhetsbrikken i telefonen og frigis bare av fingeravtrykket eller ansiktet ditt. En beslaglagt telefon står imot brute force fra etterforskningsverktøy selv om koden til telefonen blir knekt. På Android er tastaturets ordforslag og emoji fortsatt slått på, så tastaturet kan lære ord du skriver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестизначный PIN-код, но ключ хранилища запечатан в чипе безопасности телефона и раскрывается только по отпечатку пальца или лицу. Изъятый телефон противостоит криминалистическому перебору, даже если его код-пароль будет взломан. На Android подсказки клавиатуры и эмодзи остаются включёнными, поэтому клавиатура может запоминать слова, которые вы набираете."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN lix lambar ah, laakiin furaha khasnadda waxaa lagu xidhaa chip-ka ammaanka ee taleefanka, waxaana kaliya sii daaya far-raadkaaga ama wejigaaga. Taleefan la qabsaday wuu iska caabbiyaa brute force-ka forensic-ka xitaa haddii passcode-kiisa la jebiyo. Android-ka, soo-jeedinta erayada iyo emoji-ga keyboard-ka way shidan yihiin, markaa keyboard-ku wuxuu baran karaa erayada aad qorto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexsiffrig PIN-kod, men valvnyckeln är förseglad i telefonens säkerhetschip och släpps bara av ditt fingeravtryck eller ansikte. En beslagtagen telefon står emot forensiska brute force-attacker även om dess lösenkod knäcks. På Android förblir tangentbordets ordförslag och emoji påslagna, så tangentbordet kan lära sig ord du skriver."
          }
        }
      }
    },
    "protection_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستوى الحماية ضد هجمات التحليل الجنائي"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg beskyttelsesniveau mod forensiske angreb"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Schutzstufe gegen forensische Angriffe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose protection level against forensic attacks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el nivel de protección frente a ataques forenses"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سطح حفاظت در برابر حملات فارنزیک را انتخاب کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse suojaustaso forensisia hyökkäyksiä vastaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre niveau de protection contre les attaques forensiques"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете ниво на заштита против форензички напади"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg beskyttelsesnivå mot dataetterforskning"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите уровень защиты от криминалистических атак"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro heerka ilaalinta ee ka hortagga weerarrada forensic-ka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj skyddsnivå mot forensiska attacker"
          }
        }
      }
    },
    "push_prompt_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تفعيل الإشعارات الفورية؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slå push-notifikationer til?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du Push-Benachrichtigungen aktivieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to enable push notifications?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres activar las notificaciones push?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌خواهید اعلان‌های فوری را فعال کنید؟"
          }
        },
        "fi": {
