    "connect_relay_relaunch_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر على الاتصال الآمن التعافي في هذه الجلسة.\nأغلق Rún وأعد فتحه لإعادة الاتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sikre forbindelse kan ikke genoprettes i denne session.\nLuk Rún, og åbn appen igen for at forbinde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sichere Verbindung lässt sich in dieser Sitzung nicht wiederherstellen.\nSchließe Rún und öffne es erneut, um dich neu zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secure connection can’t recover in this session.\nClose and reopen Rún to reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión segura no puede recuperarse en esta sesión.\nCierra Rún y vuelve a abrirlo para reconectar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال امن در این نشست دیگر ترمیم نمی‌شود.\nRún را ببندید و دوباره باز کنید تا اتصال برقرار شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu yhteys ei voi palautua tässä istunnossa.\nSulje Rún ja avaa se uudelleen, niin yhteys muodostuu uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion sécurisée ne peut pas se rétablir dans cette session.\nFermez et rouvrez Rún pour vous reconnecter."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безбедната врска не може да се обнови во оваа сесија.\nЗатворете го и повторно отворете го Rún за да се поврзете."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sikre forbindelsen kan ikke gjenopprettes i denne økten.\nLukk Rún og åpne appen på nytt for å koble til igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённое соединение не может восстановиться в этой сессии.\nЗакройте и снова откройте Rún, чтобы переподключиться."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xidhiidhka ammaanka ah kuma soo noqon karo fadhigan.\nXir oo mar kale fur Rún si aad dib ugu xidhiidho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den säkra anslutningen kan inte återhämta sig i den här sessionen.\nStäng och öppna Rún igen för att ansluta på nytt."
          }
        }
      }
    },
    "connect_relay_slow_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون شبكة Tor بطيئة أحيانًا — وهذا هو ثمن إخفاء الهوية الكامل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor-netværket kan nogle gange være langsomt — det er prisen for total anonymitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tor-Netzwerk kann manchmal langsam sein — das ist der Preis für vollständige Anonymität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor network can sometimes be slow, this is the price for total anonymity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red Tor a veces puede ser lenta; es el precio del anonimato total."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شبکه Tor گاهی ممکن است کند باشد — این بهای گمنامی کامل است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor-verkko voi joskus olla hidas — se on täyden anonymiteetin hinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau Tor peut parfois être lent — c'est le prix de l'anonymat total."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежата Tor понекогаш може да биде спора — тоа е цената за целосна анонимност."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor-nettverket kan noen ganger være tregt – det er prisen for total anonymitet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть Tor иногда может работать медленно — это цена полной анонимности."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Shabakadda Tor mararka qaarkood way gaabsan kartaa — taasi waa qiimaha qarsoodiga buuxa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor-nätverket kan ibland vara långsamt — det är priset för total anonymitet."
          }
        }
      }
    },
    "connect_relay_stalled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الوصول إلى المُرحّل متعذرًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stadig ikke nå relæet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay ist weiterhin nicht erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still can’t reach the relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos sin poder llegar al relay."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز نمی‌توانیم به رله برسیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välityspalvelimeen ei edelleenkään saada yhteyttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais reste inaccessible."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не можеме да стигнеме до релето."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får fortsatt ikke kontakt med relayet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё не удаётся связаться с ретранслятором."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli lama gaari karo relay-ga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Når fortfarande inte reläet."
          }
        }
      }
    },
    "connect_relay_stalled_reopen_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الوصول إلى المُرحّل متعذرًا.\nأعد فتح Rún إذا تكرر هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stadig ikke nå relæet.\nÅbn Rún igen, hvis det bliver ved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay ist weiterhin nicht erreichbar.\nÖffne Rún neu, wenn das öfter passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still can’t reach the relay.\nReopen Rún if this keeps happening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos sin poder llegar al relay.\nVuelve a abrir Rún si esto continúa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز نمی‌توانیم به رله برسیم.\nاگر این وضعیت ادامه داشت، Rún را دوباره باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välityspalvelimeen ei edelleenkään saada yhteyttä.\nAvaa Rún uudelleen, jos tämä jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais reste inaccessible.\nRouvrez Rún si cela persiste."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не можеме да стигнеме до релето.\nОтворете го Rún повторно ако ова продолжи да се случува."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får fortsatt ikke kontakt med relayet.\nÅpne Rún på nytt hvis dette fortsetter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё не удаётся связаться с ретранслятором.\nЕсли это повторяется, откройте Rún заново."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli lama gaari karo relay-ga.\nHaddii ay sii socoto, mar kale fur Rún."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Når fortfarande inte reläet.\nÖppna Rún igen om det här fortsätter."
          }
        }
      }
    },
