    },
    "ext_proxy_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل كل حركة بيانات المُرحّل عبر بروكسي SOCKS5 تديره بنفسك، مثل Orbot أو Tor على شبكتك الخاصة، بدلًا من Tor المدمج في Rún. ما دام هذا الخيار مفعّلًا، لا يبدأ Tor المدمج أبدًا. وإذا تعذّر الوصول إلى البروكسي، يبقى Rún غير متصل. ولا يوجد أي مسار بديل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send al relætrafik gennem en SOCKS5-proxy, som du selv driver, for eksempel Orbot eller Tor på dit eget netværk, i stedet for den indbyggede Tor i Rún. Mens dette er slået til, starter den indbyggede Tor aldrig. Hvis proxyen ikke kan nås, forbliver Rún offline. Der er ingen reserveløsning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leite den gesamten Relay-Datenverkehr über einen SOCKS5-Proxy, den du selbst betreibst, etwa Orbot oder Tor in deinem eigenen Netzwerk, statt über das eingebaute Tor von Rún. Solange diese Option aktiv ist, startet das eingebaute Tor nie. Ist der Proxy nicht erreichbar, bleibt Rún offline. Es gibt keinen Ausweichweg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send all relay traffic through a SOCKS5 proxy you run, such as Orbot or Tor on your own network, instead of Rún's built-in Tor. While this is on, the built-in Tor never starts. If the proxy can't be reached, Rún stays offline. It never falls back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía todo el tráfico del relay a través de un proxy SOCKS5 que gestiones tú, como Orbot o Tor en tu propia red, en lugar del Tor integrado de Rún. Mientras esté activado, el Tor integrado nunca se inicia. Si no se puede acceder al proxy, Rún se queda sin conexión. Nunca recurre a otra vía."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام ترافیک رله را از طریق یک پروکسی SOCKS5 که خودتان اجرا می‌کنید، مانند Orbot یا Tor در شبکهٔ خودتان، به‌جای Tor داخلی Rún ارسال کنید. تا وقتی این گزینه روشن است، Tor داخلی هرگز راه‌اندازی نمی‌شود. اگر پروکسی در دسترس نباشد، Rún آفلاین می‌ماند. هیچ مسیر جایگزینی وجود ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä kaikki välityspalvelimen liikenne itse ylläpitämäsi SOCKS5-proxyn kautta, esimerkiksi Orbot tai oma Tor omassa verkossasi, Rún-sovelluksen sisäänrakennetun Torin sijaan. Kun tämä on päällä, sisäänrakennettu Tor ei käynnisty koskaan. Jos proxyyn ei saada yhteyttä, Rún pysyy offline-tilassa. Varareittiä ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites passer tout le trafic du relais par un proxy SOCKS5 que vous gérez, comme Orbot ou Tor sur votre propre réseau, au lieu du Tor intégré de Rún. Tant que cette option est activée, le Tor intégré ne démarre jamais. Si le proxy est injoignable, Rún reste hors ligne. Il n'y a aucun repli."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Испраќајте го целиот сообраќај на релето преку SOCKS5 прокси што сами го водите, на пример Orbot или Tor во вашата мрежа, наместо вградениот Tor во Rún. Додека ова е вклучено, вградениот Tor никогаш не се стартува. Ако прокситото е недостапно, Rún останува офлајн. Нема резервен пат."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send all relay-trafikk gjennom en SOCKS5-proxy du selv driver, for eksempel Orbot eller Tor på ditt eget nettverk, i stedet for den innebygde Tor-en i Rún. Så lenge dette er på, starter den innebygde Tor aldri. Hvis proxyen ikke kan nås, forblir Rún frakoblet. Det finnes ingen reserveløsning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляйте весь трафик ретранслятора через SOCKS5-прокси, который вы запускаете сами, например Orbot или Tor в вашей собственной сети, вместо встроенного Tor в Rún. Пока эта функция включена, встроенный Tor не запускается. Если прокси недоступен, Rún остаётся офлайн. Резервного пути нет."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku dir dhammaan taraafikada relay-ga SOCKS5 proxy aad adigu maamusho, sida Orbot ama Tor shabakaddaada, halkii aad ka isticmaali lahayd Tor-ka ku dhex jira Rún. Marka tan shidan tahay, Tor-ka ku dhex jira weligiis ma bilaabmo. Haddii proxy-ga lagu gaari waayo, Rún wuxuu ku sii jiraa offline. Wax beddel ah ma jiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka all relätrafik via en SOCKS5-proxy som du själv driver, till exempel Orbot eller Tor i ditt eget nätverk, i stället för den inbyggda Tor-funktionen i Rún. Så länge detta är på startar den inbyggda Tor aldrig. Går det inte att nå proxyn förblir Rún offline. Det finns ingen reservväg."
          }
        }
      }
    },
    "ext_proxy_error_host": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان IP على هذا الهاتف أو على شبكتك المحلية: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x أو 169.254.x.x. أسماء المضيف غير مسموح بها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv en IP-adresse på denne telefon eller dit lokale netværk: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x eller 169.254.x.x. Værtsnavne er ikke tilladt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine IP-Adresse auf diesem Telefon oder in deinem lokalen Netzwerk ein: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x oder 169.254.x.x. Hostnamen sind nicht erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an IP address on this phone or your local network: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x or 169.254.x.x. Host names aren't allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección IP de este teléfono o de tu red local: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x o 169.254.x.x. No se permiten nombres de host."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک نشانی IP روی این تلفن یا شبکهٔ محلی خود وارد کنید: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x یا 169.254.x.x. نام میزبان مجاز نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna IP-osoite tästä puhelimesta tai paikallisverkostasi: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x tai 169.254.x.x. Isäntänimet eivät ole sallittuja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse IP de ce téléphone ou de votre réseau local : 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x ou 169.254.x.x. Les noms d'hôte ne sont pas autorisés."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внесете IP-адреса на овој телефон или во вашата локална мрежа: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x или 169.254.x.x. Имињата на хостови не се дозволени."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en IP-adresse på denne telefonen eller ditt lokale nettverk: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x eller 169.254.x.x. Vertsnavn er ikke tillatt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите IP-адрес на этом телефоне или в вашей локальной сети: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x или 169.254.x.x. Имена хостов не допускаются."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli cinwaan IP ah oo taleefankan ama shabakaddaada gudaha ah ku yaal: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x ama 169.254.x.x. Magacyada host-ka lama ogola."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en IP-adress på den här telefonen eller i ditt lokala nätverk: 127.x.x.x, ::1, 10.x.x.x, 172.16–31.x.x, 192.168.x.x eller 169.254.x.x. Värdnamn är inte tillåtna."
          }
        }
      }
    },
