    "group_info_leave_unread_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أرسلته ولم يقرأه الآخرون بعد قد لا يُعرض عليهم أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du har sendt, og som de andre ikke har læst endnu, bliver måske aldrig vist for dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du gesendet hast und die anderen noch nicht gelesen haben, wird ihnen womöglich nie angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you sent that the others have not read yet may never be shown to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que nunca se les muestre a los demás lo que hayas enviado y aún no hayan leído."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر چیزی که فرستاده‌اید و دیگران هنوز نخوانده‌اند ممکن است هرگز به آن‌ها نشان داده نشود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkea lähettämääsi, mitä muut eivät ole vielä lukeneet, ei ehkä koskaan näytetä heille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez envoyé et que les autres n'ont pas encore lu risque de ne jamais leur être affiché."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Она што сте го испратиле, а другите сè уште не го прочитале, можеби никогаш нема да им биде прикажано."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du har sendt som de andre ikke har lest ennå, blir kanskje aldri vist for dem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы отправили и что остальные ещё не прочитали, может так и не быть им показано."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wixii aad dirtay ee kuwa kale aanay weli akhrin, waxaa laga yaabaa in aan weligood loo muujin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du har skickat som de andra inte har läst än kanske aldrig visas för dem."
          }
        }
      }
    },
    "group_info_make_admin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين كمشرف"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør til admin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Admin machen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make admin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer administrador"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدیر کردن"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee ylläpitäjäksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommer admin"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи администратор"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør til admin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначить администратором"
          }
        },
