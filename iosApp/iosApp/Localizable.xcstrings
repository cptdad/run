    "conversation_screenshot_warning_banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ حُفظت لقطة الشاشة في «الصور» — هذه الصورة غير مشفّرة إطلاقًا وقد تتزامن مع iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Skærmbilledet er gemt i Fotos — billedet er IKKE krypteret og kan blive synkroniseret til iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Screenshot in „Fotos“ gespeichert — dieses Bild ist NICHT verschlüsselt und kann mit iCloud synchronisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Screenshot saved to Photos — that image is NOT encrypted and can sync to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Captura guardada en Fotos: esa imagen NO está cifrada y puede sincronizarse con iCloud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ اسکرین‌شات در «عکس‌ها» ذخیره شد — آن تصویر رمزگذاری نشده است و می‌تواند با iCloud همگام شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Kuvakaappaus tallennettiin Kuviin — se EI ole salattu ja voi synkronoitua iCloudiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Capture d'écran enregistrée dans Photos — cette image n'est PAS chiffrée et peut se synchroniser avec iCloud."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Снимката од екранот е зачувана во Photos — таа слика НЕ Е шифрирана и може да се синхронизира со iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Skjermbildet er lagret i Bilder – det bildet er IKKE kryptert og kan synkroniseres til iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Снимок экрана сохранён в Фото — это изображение НЕ зашифровано и может синхронизироваться с iCloud."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Sawirka shaashadda waxaa lagu kaydiyay Sawirrada — sawirkaasi MA AHA mid sirsiiman, wuxuuna iCloud la sync gareyn karaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Skärmdumpen sparades i Bilder — den bilden är INTE krypterad och kan synkas till iCloud."
          }
        }
      }
    },
