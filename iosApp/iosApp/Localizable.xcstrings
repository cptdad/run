    "notif_edu_timing_deep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطلق إشارة إيقاظ في كل مرة تصلك فيها رسالة، فترى %1$@ نمطًا متواصلًا — كم مرة، وفي أي ساعات — مرتبطًا بتثبيت Rún على هذا الهاتف. يخفي Tor هذا التوقيت عادةً؛ وتشغيل الإشعارات يقايض جزءًا منه بالتسليم الفوري."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der udløses en vækning, hver gang en besked når frem til dig, så %1$@ ser et løbende mønster — hvor ofte, på hvilke tidspunkter — knyttet til Rún-installationen på denne telefon. Tor skjuler normalt den timing; slår du notifikationer til, bytter du noget af den for øjeblikkelig levering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jeder Nachricht, die dich erreicht, wird ein Wecksignal ausgelöst, also sieht %1$@ ein fortlaufendes Muster — wie oft, zu welchen Stunden — verknüpft mit der Rún-Installation auf diesem Telefon. Tor verbirgt dieses Timing normalerweise; Benachrichtigungen einzuschalten tauscht einen Teil davon gegen sofortige Zustellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wake fires each time a message reaches you, so %1$@ sees a running pattern — how often, at what hours — tied to this phone’s Rún install. Tor normally hides that timing; turning notifications on trades some of it for instant delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta una activación cada vez que te llega un mensaje, así que %1$@ ve un patrón continuo —con qué frecuencia, a qué horas— ligado a la instalación de Rún de este teléfono. Tor normalmente oculta ese patrón; activar las notificaciones cambia parte de él por entrega instantánea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بار پیامی به شما می‌رسد یک بیدارباش شلیک می‌شود، پس %1$@ الگویی جاری می‌بیند — چند بار، در چه ساعت‌هایی — گره‌خورده به نصب Rún روی این گوشی. Tor معمولاً این زمان‌بندی را می‌پوشاند؛ روشن کردن اعلان‌ها بخشی از آن را با تحویل آنی معامله می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herätys laukeaa aina, kun viesti saapuu sinulle, joten %1$@ näkee jatkuvan kuvion — kuinka usein, mihin kellonaikoihin — sidottuna tämän puhelimen Rún-asennukseen. Tor peittää tämän ajoituksen normaalisti; ilmoitusten käyttöönotto vaihtaa osan siitä välittömään toimitukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un réveil se déclenche à chaque message qui vous parvient : %1$@ voit donc un motif continu — à quelle fréquence, à quelles heures — rattaché à l'installation de Rún sur ce téléphone. Tor masque normalement ce rythme ; activer les notifications en dévoile une partie en échange d'une livraison instantanée."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал за будење се активира секогаш кога ќе ви пристигне порака, па %1$@ гледа постојан образец — колку често, во кои часови — поврзан со инсталацијата на Rún на овој телефон. Tor вообичаено го маскира тоа темпирање; вклучувањето на известувањата разменува дел од него за моментална испорака."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et vekkesignal utløses hver gang en melding når deg, så %1$@ ser et løpende mønster – hvor ofte, til hvilke tider – knyttet til Rún-installasjonen på denne telefonen. Tor skjuler normalt slike tidsspor; å slå på varsler bytter bort noe av dem mot umiddelbar levering."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал пробуждения срабатывает каждый раз, когда до вас доходит сообщение, поэтому %1$@ видит постоянную картину — как часто, в какие часы, — привязанную к установке Rún на этом телефоне. Обычно Tor скрывает эти временные закономерности; включение уведомлений частично жертвует ими ради мгновенной доставки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Calaamad toosin ayaa dhacda mar kasta oo fariin kuu timaado, sidaas darteed %1$@ wuxuu arkaa qaab joogto ah — inta jeer, saacadaha — oo ku xidhan rakibaadda Rún ee taleefankan. Tor caadi ahaan wuu qariyaa waqtigaas; shidista ogeysiisyadu waxay qayb ka mid ah ku beddeshaa gaarsiin degdeg ah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En väckning skickas varje gång ett meddelande når dig, så %1$@ ser ett löpande mönster — hur ofta, vid vilka tider — knutet till Rún-installationen på den här telefonen. Tor döljer normalt det tidsmönstret; att slå på notiser byter bort en del av det mot omedelbar leverans."
          }
        }
      }
    },
    "notif_edu_timing_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعرف %1$@ سوى وقت وصول الرسائل إليك — لا من أرسلها ولا ما تقوله. ومع الوقت، تكفي هذه الطوابع الزمنية وحدها لتبيّن متى تتواصل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ får kun at vide, hvornår beskeder når frem til dig — aldrig hvem der sendte dem, eller hvad der står. Med tiden kan de tidsstempler alene vise, hvornår du kommunikerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ erfährt nur, wann Nachrichten dich erreichen — nie, wer sie geschickt hat oder was darin steht. Mit der Zeit zeigen allein diese Zeitstempel, wann du kommunizierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ only learns when messages reach you — never who sent them or what they say. Over time, those timestamps alone can show when you communicate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ solo sabe cuándo te llegan los mensajes, nunca quién los envió ni qué dicen. Con el tiempo, esas marcas de tiempo por sí solas revelan cuándo te comunicas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ فقط می‌فهمد پیام‌ها چه زمانی به شما می‌رسند — هرگز نمی‌داند چه کسی آن‌ها را فرستاده یا چه نوشته است. به مرور، همین زمان‌ها به‌تنهایی نشان می‌دهند چه وقت در ارتباط هستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saa tietää vain, milloin viestit saapuvat sinulle — ei koskaan kuka ne lähetti tai mitä niissä lukee. Ajan myötä jo pelkät aikaleimat voivat paljastaa, milloin olet yhteydessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apprend seulement quand les messages vous parviennent — jamais qui les a envoyés ni ce qu'ils disent. À la longue, ces horodatages suffisent à montrer quand vous communiquez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дознава само кога пораките пристигнуваат кај вас — никогаш кој ги испратил ниту што пишува во нив. Со текот на времето, само тие временски ознаки покажуваат кога комуницирате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ får bare vite når meldinger når fram til deg – aldri hvem som sendte dem eller hva de sier. Over tid kan disse tidspunktene alene vise når du kommuniserer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ узнаёт только то, когда сообщения доходят до вас, — никогда кто их отправил и что в них. Со временем одни эти временные метки показывают, когда вы общаетесь."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wuxuu kaliya ogaadaa marka fariimuhu kugu soo gaadhaan — marnaba ma oga cidda dirtay ama waxa ay leeyihiin. Muddo ka dib, waqtiyadaas kaligood way muujin karaan marka aad xidhiidhayso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ får bara veta när meddelanden når dig — aldrig vem som skickade dem eller vad de innehåller. Med tiden kan enbart de tidsstämplarna visa när du kommunicerar."
          }
        }
      }
    },
    "notif_edu_up_content_safe_deep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إشارة إيقاظ مشفّرة إلى زوج مفاتيح لا يغادر هذا الهاتف أبدًا (Web Push، وفق RFC 8291)، فمن يعرف عنوان نقطة النهاية الخاصة بك لا يستطيع تزوير تنبيه جديد — ومع أن خادم الإشعارات الفورية قد يعيد إرسال إشارة سبق أن استلمتها، فإن Rún يحدّ من عدد المرات التي يمكن فيها لإشارة مكرّرة أن تُظهر الإشعار — وكل إشارة بالحجم الثابت نفسه. تبقى رسائلك مشفّرة على المُرحّل حتى تفتح Rún، فيجلبها عبر Tor ويفكّ تشفيرها محليًا بالمفتاح المشتق من رمز PIN أو عبارة مرورك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver vækning er krypteret til et nøglepar, der aldrig forlader denne telefon (Web Push, RFC 8291), så en, der får fat i din endpoint-adresse, ikke kan forfalske en ny notifikation — din pushserver kan til gengæld gensende en, du allerede har modtaget, så Rún begrænser, hvor ofte en gentagelse kan udløse notifikationen — og hver vækning har præcis samme faste størrelse. Dine beskeder ligger krypteret på relæet, indtil du åbner Rún, som henter dem over Tor og dekrypterer dem lokalt med nøglen udledt af din PIN eller adgangssætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Wecksignal ist an ein Schlüsselpaar verschlüsselt, das dieses Telefon nie verlässt (Web Push, RFC 8291) — wer deine Endpunktadresse kennt, kann damit zwar keinen neuen Hinweis fälschen, doch dein Push-Server könnte einen bereits empfangenen erneut senden, weshalb Rún begrenzt, wie oft eine Wiederholung den Hinweis auslösen kann — und jedes Wecksignal hat dieselbe feste Größe. Deine Nachrichten liegen verschlüsselt auf dem Relay, bis du Rún öffnest; die App holt sie über Tor und entschlüsselt sie lokal mit dem Schlüssel, der aus deiner PIN oder Passphrase abgeleitet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every wake is encrypted to a key pair that never leaves this phone (Web Push, RFC 8291), so nobody who learns your endpoint can forge a new alert — though your push server could replay one you already received, Rún limits how often a repeat can trigger the banner — and every wake is the same fixed size. Your messages wait encrypted on the relay until you open Rún, which fetches them over Tor and decrypts them locally with the key derived from your PIN or passphrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada activación va cifrada para un par de claves que nunca sale de este teléfono (Web Push, RFC 8291), así que quien averigüe la dirección de tu endpoint no puede falsificar un aviso nuevo — aunque tu servidor push sí podría reenviar uno que ya has recibido, Rún limita la frecuencia con la que una repetición puede activar el aviso — y todas las activaciones tienen el mismo tamaño fijo. Tus mensajes esperan cifrados en el relay hasta que abres Rún, que los descarga por Tor y los descifra en el propio teléfono con la clave derivada de tu PIN o tu frase de contraseña."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بیدارباش با جفت‌کلیدی رمزگذاری می‌شود که هرگز از این گوشی بیرون نمی‌رود (Web Push، RFC 8291)، پس کسی که نشانی endpoint شما را بداند نمی‌تواند هشدار تازه‌ای جعل کند — هرچند سرور پوش شما می‌تواند بیدارباشی را که پیش‌تر دریافت کرده‌اید دوباره بفرستد، Rún تعداد دفعاتی را که یک بیدارباش تکراری می‌تواند اعلان نشان دهد محدود می‌کند — و همهٔ بیدارباش‌ها همان اندازهٔ ثابت را دارند. پیام‌های شما رمزگذاری‌شده روی رله می‌مانند تا Rún را باز کنید؛ آنگاه برنامه آن‌ها را از راه Tor می‌گیرد و به‌صورت محلی با کلید مشتق‌شده از PIN یا عبارت عبور شما رمزگشایی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen herätys salataan avainparille, joka ei koskaan poistu tästä puhelimesta (Web Push, RFC 8291), joten se, joka saa selville päätepisteosoitteesi, ei voi väärentää uutta hälytystä — push-palvelimesi voisi kuitenkin lähettää jo vastaanottamasi herätyksen uudelleen, joten Rún rajoittaa, kuinka usein toisto voi laukaista hälytyksen — ja jokainen herätys on samaa kiinteää kokoa. Viestisi odottavat salattuina välityspalvelimella, kunnes avaat Rún-sovelluksen, joka hakee ne Tor-verkon kautta ja purkaa ne paikallisesti PIN-koodistasi tai salalauseestasi johdetulla avaimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réveil est chiffré à destination d'une paire de clés qui ne quitte jamais ce téléphone (Web Push, RFC 8291) : quelqu'un qui découvrirait l'adresse de votre point de terminaison ne peut donc pas forger une nouvelle alerte — même si votre serveur push pouvait rejouer une alerte que vous avez déjà reçue, Rún limite la fréquence à laquelle une répétition peut déclencher l'alerte — et tous les réveils ont exactement la même taille. Vos messages restent chiffrés sur le relais jusqu'à ce que vous ouvriez Rún, qui les récupère via Tor et les déchiffre localement avec la clé dérivée de votre code PIN ou de votre phrase secrète."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секој сигнал за будење е шифриран со пар клучеви што никогаш не го напуштаат овој телефон (Web Push, RFC 8291), па некој што ќе ја дознае вашата endpoint-адреса не може да фалсификува ново известување — иако вашиот push-сервер може да повтори сигнал што веќе сте го примиле, Rún ограничува колку често повторен сигнал може да предизвика известување — а секој сигнал има иста фиксна големина. Вашите пораки чекаат шифрирани на релето сè додека не го отворите Rún, кој ги презема преку Tor и ги дешифрира локално со клуч изведен од вашиот PIN или тајна фраза."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert vekkesignal krypteres til et nøkkelpar som aldri forlater denne telefonen (Web Push, RFC 8291), så noen som får tak i endepunktadressen din, kan ikke forfalske et nytt varsel — men push-serveren din kan sende det samme vekkesignalet på nytt, så Rún begrenser hvor ofte en gjentakelse kan utløse varselet — og hvert vekkesignal har samme faste størrelse. Meldingene dine ligger krypterte på relayet til du åpner Rún, som henter dem over Tor og dekrypterer dem lokalt med nøkkelen som utledes fra PIN-koden eller passfrasen din."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый сигнал пробуждения шифруется для пары ключей, которая никогда не покидает этот телефон (Web Push, RFC 8291), поэтому тот, кто узнает адрес вашей конечной точки, не сможет подделать новое оповещение — хотя ваш push-сервер мог бы повторно отправить уже полученное оповещение, Rún ограничивает, как часто повтор может вызвать оповещение — и все сигналы имеют одинаковый фиксированный размер. Ваши сообщения ждут зашифрованными на ретрансляторе, пока вы не откроете Rún, который загружает их через Tor и расшифровывает локально ключом, полученным из вашего PIN-кода или парольной фразы."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Toosin kasta waxaa loogu sirsiiyaa lammaane fure oo aan weligiis ka bixin taleefankan (Web Push, RFC 8291), sidaas darteed qofka ogaada cinwaanka endpoint-kaaga digniin cusub oo been ah ma abuuri karo — inkastoo server-kaaga push-ku uu dib u soo celin karo toosin aad hore u heshay, Rún wuxuu xaddidaa inta jeer ee toosin la soo celiyay ogeysiis soo bandhigi karto — toosin kastaana waa isla cabbirka go'an. Fariimahaagu sirsiiman ayay ku sugayaan relay-ga ilaa aad furto Rún, oo ka soo qaada isagoo maraya Tor kadibna si maxalli ah ugu sii furaa furaha laga soo saaray PIN-kaaga ama weedhdaada sirta ah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje väckning krypteras till ett nyckelpar som aldrig lämnar den här telefonen (Web Push, RFC 8291), så den som får reda på din endpoint-adress kan inte förfalska en ny notis — även om din pushserver skulle kunna skicka om en väckning du redan har fått, begränsar Rún hur ofta en upprepning kan utlösa notisen — och varje väckning har samma fasta storlek. Dina meddelanden ligger krypterade på reläet tills du öppnar Rún, som hämtar dem via Tor och dekrypterar dem lokalt med nyckeln som härleds ur din PIN-kod eller lösenfras."
          }
        }
      }
    },
    "notif_edu_up_content_safe_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تصل رسائلك إلى الموزّع ولا إلى خادمه أبدًا. كل إشارة إيقاظ مشفّرة لهذا الهاتف ولا تحمل شيئًا؛ يجلب Rún رسائلك عبر Tor ويفكّ تشفيرها بعد أن تفتح القفل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine beskeder når aldrig frem til distributøren eller dens server. Hver vækning er krypteret til denne telefon og bærer intet med sig; Rún henter dine beskeder over Tor og dekrypterer dem, efter du har låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachrichten erreichen weder den Distributor noch seinen Server. Jedes Wecksignal ist für dieses Telefon verschlüsselt und trägt nichts in sich; Rún holt deine Nachrichten über Tor und entschlüsselt sie, nachdem du entsperrt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages never reach the distributor or its server. Each wake is encrypted to this phone and carries nothing; Rún fetches your messages over Tor and decrypts them after you unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mensajes nunca llegan al distribuidor ni a su servidor. Cada activación va cifrada para este teléfono y no lleva nada; Rún descarga tus mensajes por Tor y los descifra después de que desbloquees."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام‌های شما هرگز به توزیع‌کننده یا سرور آن نمی‌رسند. هر بیدارباش برای همین گوشی رمزگذاری شده و چیزی با خود ندارد؛ Rún پیام‌های شما را از راه Tor می‌گیرد و پس از باز کردن قفل رمزگشایی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi eivät koskaan päädy välittäjäsovellukselle eivätkä sen palvelimelle. Jokainen herätys on salattu tälle puhelimelle eikä kanna mitään; Rún hakee viestisi Tor-verkon kautta ja purkaa ne, kun olet avannut lukituksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos messages n'atteignent jamais le distributeur ni son serveur. Chaque réveil est chiffré pour ce téléphone et ne transporte rien ; Rún récupère vos messages via Tor et les déchiffre après votre déverrouillage."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите пораки никогаш не стигнуваат до дистрибутерот или неговиот сервер. Секој сигнал за будење е шифриран за овој телефон и не носи ништо; Rún ги презема вашите пораки преку Tor и ги дешифрира откако ќе отклучите."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingene dine når aldri fram til distributøren eller serveren dens. Hvert vekkesignal er kryptert til denne telefonen og bærer ingenting; Rún henter meldingene dine over Tor og dekrypterer dem etter at du har låst opp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши сообщения никогда не попадают ни к дистрибьютору, ни к его серверу. Каждый сигнал пробуждения зашифрован для этого телефона и ничего не несёт; Rún загружает ваши сообщения через Tor и расшифровывает их после разблокировки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fariimahaagu weligood ma gaadhaan qaybiyaha ama server-kiisa. Toosin kasta waxaa loo sirsiiyay taleefankan waxbana ma sido; Rún wuxuu fariimahaaga ka soo qaadaa Tor, kadibna wuu sii furaa markaad qufulka furto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina meddelanden når aldrig distributören eller dess server. Varje väckning är krypterad till den här telefonen och bär ingenting; Rún hämtar dina meddelanden via Tor och dekrypterar dem efter att du har låst upp."
          }
        }
      }
    },
    "notif_edu_up_distributor_deep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي تطبيق الموزّع اتصالًا واحدًا مفتوحًا بخادم إشعارات ويسلّم كل إشارة إيقاظ إلى Rún. ولا يتغيّر شيء في رسائلك: الإشارة لا تحمل أي رسالة، وما زال Rún يجلب كل شيء ويفكّ تشفيره عبر Tor بعد أن تفتح القفل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributørappen holder én forbindelse åben til en pushserver og giver hver vækning videre til Rún. Intet ved dine beskeder ændrer sig: vækningen indeholder ingen besked, og Rún henter og dekrypterer stadig alt over Tor, efter du har låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Distributor-App hält eine Verbindung zu einem Push-Server offen und reicht jedes Wecksignal an Rún weiter. An deinen Nachrichten ändert das nichts: Das Wecksignal enthält keine Nachricht, und Rún holt und entschlüsselt weiterhin alles über Tor, nachdem du entsperrt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distributor app keeps one connection open to a push server and hands each wake to Rún. Nothing about your messages changes: the wake carries no message, and Rún still fetches and decrypts everything over Tor after you unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app distribuidora mantiene una conexión abierta con un servidor push y le pasa cada activación a Rún. Nada cambia en tus mensajes: la activación no contiene ningún mensaje, y Rún sigue descargando y descifrando todo por Tor después de que desbloquees."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ توزیع‌کننده یک اتصال باز به یک سرور پوش نگه می‌دارد و هر بیدارباش را به Rún می‌رساند. در پیام‌های شما هیچ چیزی عوض نمی‌شود: بیدارباش هیچ پیامی در بر ندارد و Rún همچنان همه چیز را پس از باز کردن قفل، از راه Tor می‌گیرد و رمزگشایی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välittäjäsovellus pitää yhden yhteyden auki push-palvelimeen ja luovuttaa jokaisen herätyksen Rún-sovellukselle. Viesteissäsi ei muutu mikään: herätys ei sisällä viestiä, ja Rún hakee ja purkaa edelleen kaiken Tor-verkon kautta sen jälkeen, kun olet avannut lukituksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application distributrice garde une connexion ouverte vers un serveur push et transmet chaque réveil à Rún. Rien ne change pour vos messages : le réveil ne contient aucun message, et Rún récupère et déchiffre toujours tout via Tor après votre déverrouillage."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апликацијата-дистрибутер одржува една отворена врска со push-сервер и му го предава секој сигнал за будење на Rún. Кај вашите пораки ништо не се менува: сигналот не носи порака, а Rún сепак сè презема и дешифрира преку Tor откако ќе отклучите."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributørappen holder én forbindelse åpen til en push-server og gir hvert vekkesignal videre til Rún. Ingenting endres for meldingene dine: vekkesignalet inneholder ingen melding, og Rún henter og dekrypterer fortsatt alt over Tor etter at du har låst opp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение-дистрибьютор держит одно открытое соединение с push-сервером и передаёт каждый сигнал пробуждения в Rún. Для ваших сообщений ничего не меняется: сигнал не несёт сообщения, а Rún по-прежнему загружает и расшифровывает всё через Tor после разблокировки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "App-ka qaybiyuhu wuxuu hal xidhiidh oo furan kula sii jiraa server push ah, toosin kastana wuxuu u gudbiyaa Rún. Waxba kama beddelmayaan fariimahaaga: toosintu fariin ma sido, Rún weli wax walba wuxuu ka soo qaadaa oo sii furaa isagoo maraya Tor, ka dib markaad qufulka furto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributörsappen håller en anslutning öppen mot en pushserver och lämnar över varje väckning till Rún. Inget kring dina meddelanden ändras: väckningen innehåller inget meddelande, och Rún hämtar och dekrypterar fortfarande allt via Tor efter att du har låst upp."
          }
        }
      }
    },
    "notif_edu_up_distributor_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الهاتف على خدمات Google، لذا يسلّم إشارة الإيقاظ تطبيق منفصل تختاره بنفسك — موزّع UnifiedPush مثل ntfy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefon har ingen Google-tjenester, så vækkesignalet leveres af en separat app, du selv vælger — en UnifiedPush-distributør som ntfy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat keine Google-Dienste, deshalb liefert eine separate App deiner Wahl das Wecksignal aus — ein UnifiedPush-Distributor wie ntfy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Google services, so a separate app you choose — a UnifiedPush distributor such as ntfy — delivers the wake signal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no lleva servicios de Google, así que la señal de activación la entrega una app aparte que eliges tú: un distribuidor de UnifiedPush como ntfy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گوشی سرویس‌های Google را ندارد، پس سیگنال بیدارباش را برنامه‌ای جداگانه که خودتان انتخاب می‌کنید تحویل می‌دهد — یک توزیع‌کنندهٔ UnifiedPush مانند ntfy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä puhelimessa ei ole Google-palveluita, joten herätesignaalin toimittaa erillinen valitsemasi sovellus — UnifiedPush-välittäjäsovellus, kuten ntfy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a aucun service Google : c'est donc une application distincte que vous choisissez — un distributeur UnifiedPush comme ntfy — qui délivre le signal de réveil."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој телефон нема Google-услуги, па сигналот за будење го испорачува посебна апликација што ја избирате вие — дистрибутер за UnifiedPush како ntfy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefonen har ingen Google-tjenester, så vekkesignalet leveres av en egen app du velger selv – en UnifiedPush-distributør som ntfy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет сервисов Google, поэтому сигнал пробуждения доставляет отдельное приложение на ваш выбор — дистрибьютор UnifiedPush, например ntfy."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankan ma laha adeegyada Google, sidaa darteed calaamadda toosinta waxaa keena app kale oo aad doorato — qaybiye UnifiedPush ah sida ntfy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här telefonen har inga Google-tjänster, så väckningssignalen levereras av en separat app som du väljer — en UnifiedPush-distributör som ntfy."
          }
        }
      }
    },
    "notif_edu_up_parties_deep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا طرف إضافي واحد مقارنة بنسخة Google. يرى الموزّع كل إشارة إيقاظ لأنه هو من يسلّمها؛ ويراها خادم الإشعارات لأنه يمرّرها، وعلى خادم عام يرى أيضًا عنوان IP لهذا الهاتف. ولا يرى أي منهما مرسلًا أو رسالة أو عددًا. يخفي Tor هذا التوقيت عادةً؛ والإشعارات تقايض جزءًا منه بالتسليم الفوري. وإذا شغّلت خادم إشعارات خاصًا بك، فالطرف الثاني هو أنت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er én part mere end i Google-versionen. Distributøren ser hver vækning, fordi den leverer dem; dens pushserver ser dem, fordi den sender dem videre, og på en offentlig server ser den også denne telefons IP-adresse. Ingen af dem ser en afsender, en besked eller et antal. Tor skjuler normalt den timing; notifikationer bytter noget af den for øjeblikkelig levering. Kører du din egen pushserver, er den anden part dig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Beteiligter mehr als beim Google-Build. Der Distributor sieht jedes Wecksignal, weil er es zustellt; sein Push-Server sieht es, weil er es weiterleitet, und bei einem öffentlichen Server sieht er zusätzlich die IP-Adresse dieses Telefons. Keiner von beiden sieht einen Absender, eine Nachricht oder eine Anzahl. Tor verbirgt dieses Timing normalerweise; Benachrichtigungen tauschen einen Teil davon gegen sofortige Zustellung. Betreibst du deinen eigenen Push-Server, bist der zweite Beteiligte du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is one party more than the Google build has. The distributor sees every wake because it delivers them; its push server sees them because it forwards them and, on a public server, also sees this phone’s IP address. Neither sees a sender, a message or a count. Tor normally hides that timing; notifications trade some of it for instant delivery. Run your own push server and the second party is you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una parte más que en la versión con Google. El distribuidor ve todas las activaciones porque es quien las entrega; su servidor push las ve porque las reenvía y, en un servidor público, ve además la dirección IP de este teléfono. Ninguno ve un remitente, un mensaje ni un recuento. Tor normalmente oculta ese patrón; las notificaciones cambian parte de él por entrega instantánea. Si tienes tu propio servidor push, la segunda parte eres tú."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یک طرف بیشتر از نسخهٔ Google است. توزیع‌کننده هر بیدارباش را می‌بیند، چون خودش آن را تحویل می‌دهد؛ سرور پوش آن‌ها را می‌بیند، چون آن‌ها را جلو می‌فرستد و روی یک سرور عمومی نشانی IP این گوشی را هم می‌بیند. هیچ‌کدام فرستنده، پیام یا تعدادی نمی‌بینند. Tor معمولاً این زمان‌بندی را می‌پوشاند؛ اعلان‌ها بخشی از آن را با تحویل آنی معامله می‌کنند. اگر سرور پوش خودتان را اداره کنید، طرف دوم خود شما هستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on yksi osapuoli enemmän kuin Google-versiossa. Välittäjäsovellus näkee jokaisen herätyksen, koska se toimittaa ne; sen push-palvelin näkee ne, koska se välittää ne, ja julkisella palvelimella se näkee myös tämän puhelimen IP-osoitteen. Kumpikaan ei näe lähettäjää, viestiä eikä määrää. Tor peittää tämän ajoituksen normaalisti; ilmoitukset vaihtavat osan siitä välittömään toimitukseen. Jos ylläpidät omaa push-palvelinta, toinen osapuoli olet sinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait une partie de plus que dans la version Google. Le distributeur voit chaque réveil puisqu'il les délivre ; son serveur push les voit puisqu'il les transmet et, sur un serveur public, il voit aussi l'adresse IP de ce téléphone. Ni l'un ni l'autre ne voit d'expéditeur, de message ou de décompte. Tor masque normalement ce rythme ; les notifications en échangent une partie contre une livraison instantanée. Hébergez votre propre serveur push et la seconde partie, c'est vous."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоа е една страна повеќе отколку кај верзијата со Google. Дистрибутерот ги гледа сите сигнали бидејќи тој ги испорачува; неговиот push-сервер ги гледа бидејќи ги пренесува, а на јавен сервер ја гледа и IP-адресата на овој телефон. Ниту еден од нив не гледа испраќач, порака или број. Tor вообичаено го маскира тоа темпирање; известувањата разменуваат дел од него за моментална испорака. Ако управувате со свој push-сервер, втората страна сте вие."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er én part mer enn i Google-versjonen. Distributøren ser hvert vekkesignal fordi den leverer dem; push-serveren dens ser dem fordi den videresender dem, og på en offentlig server ser den også IP-adressen til denne telefonen. Ingen av dem ser avsender, melding eller antall. Tor skjuler normalt slike tidsspor; varsler bytter bort noe av dem mot umiddelbar levering. Kjører du din egen push-server, er den andre parten deg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на одну сторону больше, чем в сборке с сервисами Google. Дистрибьютор видит каждый сигнал, потому что доставляет его; его push-сервер видит сигналы, потому что пересылает их, а на публичном сервере видит ещё и IP-адрес этого телефона. Ни один из них не видит ни отправителя, ни сообщение, ни их количество. Обычно Tor скрывает эти временные закономерности; уведомления частично жертвуют ими ради мгновенной доставки. Если вы держите собственный push-сервер, второй стороной становитесь вы сами."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taasi waa hal dhinac oo ka badan nooca Google. Qaybiyuhu wuxuu arkaa toosin kasta sababtoo ah isaga ayaa geeya; server-kiisa push-ku wuu arkaa sababtoo ah wuu sii diraa, haddii uu yahay server dadweyne, wuxuu sidoo kale arkaa cinwaanka IP-ga taleefankan. Midna ma arko diriye, fariin, ama tiro. Tor caadi ahaan wuu qariyaa waqtigaas; ogeysiisyaduna qayb ka mid ah way ku beddelaan gaarsiin degdeg ah. Haddii aad iskaa u maamusho server-kaaga push-ka, dhinaca labaad waa adiga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en part mer än i Google-versionen. Distributören ser varje väckning eftersom den levererar dem; dess pushserver ser dem eftersom den vidarebefordrar dem och, på en publik server, ser den dessutom telefonens IP-adress. Ingen av dem ser avsändare, meddelande eller antal. Tor döljer normalt det tidsmönstret; notiser byter bort en del av det mot omedelbar leverans. Kör du en egen pushserver är den andra parten du själv."
          }
        }
      }
    },
    "notif_edu_up_parties_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طرفان يعرفان متى يجري التواصل معك — تطبيق الموزّع وخادم الإشعارات التابع له — دون أن يعرفا من كتب ولا ماذا كتب. وتكفي هذه الطوابع الزمنية وحدها لتبيّن متى تتواصل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To parter får at vide, hvornår du bliver kontaktet — distributørappen og dens pushserver — aldrig hvem der skrev, eller hvad. De tidsstempler alene kan vise, hvornår du kommunikerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Beteiligte erfahren, wann du kontaktiert wirst — die Distributor-App und ihr Push-Server — nie, wer geschrieben hat oder was. Allein diese Zeitstempel zeigen, wann du kommunizierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two parties learn when you are contacted — the distributor app and its push server — never who wrote or what. Those timestamps alone can show when you communicate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos partes saben cuándo te contactan —la app distribuidora y su servidor push—, nunca quién escribió ni qué. Esas marcas de tiempo por sí solas revelan cuándo te comunicas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دو طرف می‌فهمند چه زمانی با شما تماس گرفته می‌شود — برنامهٔ توزیع‌کننده و سرور پوش آن — اما هرگز نمی‌دانند چه کسی نوشته یا چه نوشته است. همین زمان‌ها به‌تنهایی نشان می‌دهند چه وقت در ارتباط هستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi osapuolta saa tietää, milloin sinuun otetaan yhteyttä — välittäjäsovellus ja sen push-palvelin — ei koskaan kuka kirjoitti tai mitä. Jo pelkät aikaleimat voivat paljastaa, milloin olet yhteydessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux parties apprennent quand on vous contacte — l'application distributrice et son serveur push — jamais qui a écrit ni quoi. Ces horodatages suffisent à montrer quand vous communiquez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Две страни дознаваат кога сте контактирани — апликацијата-дистрибутер и нејзиниот push-сервер — но никогаш кој напишал ниту што. Само тие временски ознаки покажуваат кога комуницирате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To parter får vite når du blir kontaktet – distributørappen og push-serveren dens – aldri hvem som skrev eller hva. Disse tidspunktene alene kan vise når du kommuniserer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О том, когда с вами связываются, узнают две стороны — приложение-дистрибьютор и его push-сервер, — но никогда кто написал и что. Одни эти временные метки показывают, когда вы общаетесь."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Laba dhinac ayaa ogaada markii lagula xidhiidho — app-ka qaybiyaha iyo server-kiisa push-ka — laakiin marnaba ma oga cidda qortay ama waxa ay qortay. Waqtiyadaas kaligood way muujin karaan marka aad xidhiidhayso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två parter får veta när någon kontaktar dig — distributörsappen och dess pushserver — aldrig vem som skrev eller vad. Enbart de tidsstämplarna kan visa när du kommunicerar."
          }
        }
      }
    },
    "notif_edu_vendor_deep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل المُرحّل إشارة إيقاظ بلا محتوى عبر %1$@ — بلا مرسل ولا نص ولا عدد — ولا يعرض Rún سوى تنبيه عام بعنوان «إشعار». ولا يُجلب شيء ولا يُفك تشفيره حتى تفتح Rún وتفتح القفل. وتعمل %3$@ بالطريقة نفسها؛ ولا أحد من المزوّدَين أكثر خصوصية من الآخر.\n\nويعرف المُرحّل شيئًا أيضًا: تُسجَّل كل صناديق واردك تحت عنوان الإشعارات الفورية الوحيد الذي أصدرته %2$@ لهذا الهاتف، فيستطيع المُرحّل معرفة المحادثات التي تتشارك جهازًا واحدًا. ومن يستطيع إجبار كل من %2$@ والمُرحّل على الإفصاح قد يربطك بمحادثاتك. ولهذا يظل هذا الخيار متوقفًا حتى تُفعّله بنفسك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Relæet sender en indholdsløs vækning gennem %1$@ — ingen afsender, ingen tekst, intet antal — og Rún viser bare en generisk “Notifikation”. Der hentes og dekrypteres intet, før du åbner Rún og låser op. %3$@ fungerer på samme måde; ingen af leverandørerne er mere privat end den anden.\n\nRelæet lærer også noget: alle dine indbakker registreres under den ene push-adresse, som %2$@ har udstedt til denne telefon, så relæet kan se, hvilke samtaler der deler en enhed. Nogen, der kan tvinge oplysninger ud af både %2$@ og relæet, ville kunne knytte dig til dine samtaler. Derfor er denne indstilling slået fra, indtil du selv slår den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay schickt ein inhaltsloses Wecksignal über %1$@ — kein Absender, kein Text, keine Anzahl — und Rún zeigt nur einen allgemeinen Hinweis „Benachrichtigung“. Es wird nichts geladen und nichts entschlüsselt, bis du Rún öffnest und entsperrst. %3$@ funktioniert genauso; kein Anbieter ist privater als der andere.\n\nAuch das Relay erfährt etwas: Alle deine Postfächer werden unter der einen Push-Adresse registriert, die %2$@ diesem Telefon ausgestellt hat, sodass das Relay erkennen kann, welche Unterhaltungen sich ein Gerät teilen. Wer sowohl %2$@ als auch das Relay zur Herausgabe zwingen kann, könnte dich mit deinen Unterhaltungen verknüpfen. Deshalb ist dieser Schalter aus, bis du ihn einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay sends a contentless wake through %1$@ — no sender, no text, no count — and Rún shows a generic “Notification”. Nothing is fetched or decrypted until you open Rún and unlock. %3$@ works the same way; neither vendor is more private.\n\nThe relay learns something too: all your inboxes register under the one push address %2$@ issued to this phone, so the relay can tell which conversations share a device. Someone able to compel both %2$@ and the relay could link you to your conversations. That is why this switch is off until you turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay envía una activación sin contenido a través de %1$@ —sin remitente, sin texto, sin recuento— y Rún solo muestra un aviso genérico de “Notificación”. No se descarga ni se descifra nada hasta que abres Rún y lo desbloqueas. %3$@ funciona igual; ninguno de los dos proveedores es más privado.\n\nEl relay también aprende algo: todos tus buzones se registran bajo la única dirección push que %2$@ ha emitido para este teléfono, así que el relay puede saber qué conversaciones comparten dispositivo. Alguien capaz de obligar tanto a %2$@ como al relay podría vincularte con tus conversaciones. Por eso este interruptor está apagado hasta que lo actives tú."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رله یک بیدارباش بدون محتوا از راه %1$@ می‌فرستد — بدون فرستنده، بدون متن، بدون تعداد — و Rún فقط یک هشدار عمومی «اعلان» نشان می‌دهد. تا وقتی Rún را باز نکنید و قفل را نگشایید، چیزی دریافت یا رمزگشایی نمی‌شود. %3$@ هم به همین شکل کار می‌کند؛ هیچ‌کدام از دو شرکت خصوصی‌تر از دیگری نیست.\n\nرله هم چیزی می‌فهمد: همهٔ صندوق‌های ورودی شما زیر همان یک نشانی پوش ثبت می‌شوند که %2$@ برای این گوشی صادر کرده است، بنابراین رله می‌تواند بفهمد کدام گفتگوها روی یک دستگاه هستند. کسی که بتواند هم %2$@ و هم رله را وادار به افشا کند، می‌تواند شما را به گفتگوهایتان پیوند بزند. به همین دلیل این گزینه تا وقتی خودتان روشنش نکنید خاموش می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välityspalvelin lähettää sisällöttömän herätyksen palvelun %1$@ kautta — ei lähettäjää, ei tekstiä, ei määrää — ja Rún näyttää vain yleisen ”Ilmoitus”-hälytyksen. Mitään ei haeta eikä pureta, ennen kuin avaat Rún-sovelluksen ja sen lukituksen. %3$@ toimii samalla tavalla; kumpikaan palveluntarjoaja ei ole toistaan yksityisempi.\n\nMyös välityspalvelin oppii jotain: kaikki postilaatikkosi rekisteröidään sen yhden push-osoitteen alle, jonka %2$@ on myöntänyt tälle puhelimelle, joten välityspalvelin näkee, mitkä keskustelut ovat samalla laitteella. Se, joka pystyy pakottamaan sekä %2$@:n että välityspalvelimen luovuttamaan tietoja, voisi yhdistää sinut keskusteluihisi. Siksi tämä kytkin on pois päältä, kunnes kytket sen itse päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais envoie un réveil sans contenu via %1$@ — sans expéditeur, sans texte, sans décompte — et Rún affiche seulement une alerte générique « Notification ». Rien n'est récupéré ni déchiffré tant que vous n'avez pas ouvert Rún et déverrouillé. %3$@ fonctionne de la même façon ; aucun des deux fournisseurs n'est plus respectueux de la vie privée.\n\nLe relais apprend lui aussi quelque chose : toutes vos boîtes de réception sont enregistrées sous l'unique adresse push que %2$@ a délivrée à ce téléphone, si bien que le relais peut savoir quelles conversations partagent un appareil. Quelqu'un capable de contraindre à la fois %2$@ et le relais pourrait vous relier à vos conversations. C'est pourquoi cette option reste désactivée tant que vous ne l'activez pas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Релето испраќа сигнал за будење без содржина преку %1$@ — без испраќач, без текст, без број — а Rún прикажува само општо известување „Известување“. Ништо не се презема и не се дешифрира додека не го отворите Rún и не го отклучите. %3$@ работи на ист начин; ниту еден добавувач не е поприватен од другиот.\n\nИ релето дознава нешто: сите ваши сандачиња се регистрираат под единствената push-адреса што %2$@ ја издал за овој телефон, па релето може да утврди кои разговори делат уред. Некој што може да ги присили и %2$@ и релето да откријат податоци, би можел да ве поврзе со вашите разговори. Затоа овој прекинувач е исклучен сè додека самите не го вклучите."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayet sender et innholdsløst vekkesignal gjennom %1$@ – ingen avsender, ingen tekst, intet antall – og Rún viser bare et generisk «Varsel». Ingenting hentes eller dekrypteres før du åpner Rún og låser opp. %3$@ fungerer på samme måte; ingen av leverandørene er mer privat enn den andre.\n\nRelayet lærer også noe: alle innboksene dine registreres under den ene push-adressen som %2$@ har utstedt til denne telefonen, så relayet kan se hvilke samtaler som deler en enhet. Noen som klarer å tvinge fram informasjon fra både %2$@ og relayet, kan koble deg til samtalene dine. Derfor er denne bryteren av helt til du slår den på."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор отправляет сигнал пробуждения без содержимого через %1$@ — без отправителя, без текста, без количества, — а Rún показывает лишь общее оповещение «Уведомление». Ничего не загружается и не расшифровывается, пока вы не откроете Rún и не разблокируете его. То же самое верно для %3$@; ни один из поставщиков не приватнее другого.\n\nРетранслятор тоже кое-что узнаёт: все ваши почтовые ящики регистрируются под одним push-адресом, который %2$@ выдал этому телефону, поэтому ретранслятор может определить, какие беседы принадлежат одному устройству. Тот, кто способен принудить к раскрытию данных и %2$@, и ретранслятор, сможет связать вас с вашими беседами. Именно поэтому этот переключатель выключен, пока вы сами его не включите."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay-gu wuxuu diraa calaamad toosin oo aan waxba ku jirin oo maraysa %1$@ — diriye ma leh, qoraal ma leh, tiro ma leh — Rún wuxuuna muujiyaa digniin guud oo ah “Ogeysiis”. Waxba lama soo qaado, waxbana lama sii furo ilaa aad furto Rún oo aad qufulka furto. %3$@ si la mid ah ayuu u shaqeeyaa; midna kama sir badna kan kale.\n\nRelay-guna wax buu bartaa: dhammaan sanduuqyadaada waxaa lagu diiwaan geliyaa isla cinwaanka push ee kaliya ee %2$@ u soo saartay taleefankan, sidaas darteed relay-gu wuxuu ogaan karaa wadahadallada isku qalab wadaaga. Qofka awooda inuu ku qasbo %2$@ iyo relay-ga labadaba inay wax shaaciyaan, wuxuu adiga kugu xidhi karaa wadahadalladaada. Taasi waa sababta switch-kani u damanyahay ilaa aad shiddo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reläet skickar en innehållslös väckning via %1$@ — ingen avsändare, ingen text, inget antal — och Rún visar bara en generisk notis med texten ”Notis”. Ingenting hämtas eller dekrypteras förrän du öppnar Rún och låser upp. %3$@ fungerar likadant; ingen av leverantörerna är mer privat än den andra.\n\nReläet får också veta något: alla dina inkorgar registreras under den enda push-adress som %2$@ har utfärdat till den här telefonen, så reläet kan se vilka konversationer som delar enhet. Någon som kan tvinga fram uppgifter från både %2$@ och reläet skulle kunna koppla dig till dina konversationer. Därför är den här brytaren avstängd tills du slår på den."
          }
        }
      }
    },
    "notif_edu_vendor_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل الإشعارات عبر خوادم %1$@. وهي لا تحتوي أبدًا على رسائلك — بل فقط على أن رسالة جديدة بانتظارك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer går gennem servere hos %1$@. De indeholder aldrig dine beskeder — kun at der ligger en ny til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen laufen über die Server von %1$@. Sie enthalten nie deine Nachrichten — nur, dass eine neue für dich bereitliegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications travel through %1$@’s servers. They never contain your messages — only that a new one is waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones viajan por los servidores de %1$@. Nunca contienen tus mensajes, solo que hay uno nuevo esperándote."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها از سرورهای %1$@ عبور می‌کنند. آن‌ها هرگز پیام‌های شما را در بر ندارند — فقط این را که پیام تازه‌ای در انتظار شماست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset kulkevat %1$@:n palvelinten kautta. Ne eivät koskaan sisällä viestejäsi — vain tiedon siitä, että sinulle on uusi viesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications transitent par les serveurs de %1$@. Elles ne contiennent jamais vos messages — seulement le fait qu'un nouveau vous attend."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Известувањата патуваат преку серверите на %1$@. Тие никогаш не ги содржат вашите пораки — само дека ве чека нова."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler går via serverne til %1$@. De inneholder aldri meldingene dine – bare at det ligger en ny til deg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления проходят через серверы %1$@. Они никогда не содержат ваших сообщений — только то, что вас ждёт новое."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogeysiisyadu waxay maraan server-yada %1$@. Marnaba kuma jiraan fariimahaaga — waxa kaliya ah in mid cusub kuu sugayo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser går via servrar hos %1$@. De innehåller aldrig dina meddelanden — bara att det finns ett nytt till dig."
          }
        }
      }
    },
