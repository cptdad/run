    "donate_play_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعالَج عبر Google Play · مرتبطة بحساب Google الخاص بك · لا طرف ثالث آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandles af Google Play · knyttes til din Google-konto · ingen anden tredjepart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgewickelt über Google Play · verknüpft mit deinem Google-Konto · keine weiteren Dritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed by Google Play · ties to your Google account · no other third party."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo procesa Google Play · queda ligado a tu cuenta de Google · ningún otro tercero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرداخت از راه Google Play · متصل به حساب Google شما · بدون هیچ شخص ثالث دیگری."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsittelijänä Google Play · yhdistyy Google-tiliisi · ei muita kolmansia osapuolia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traité par Google Play · lié à votre compte Google · aucun autre tiers."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработено од Google Play · поврзано со вашата Google-сметка · нема друга трета страна."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandles av Google Play · knyttes til Google-kontoen din · ingen andre tredjeparter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывается Google Play · привязано к вашему аккаунту Google · никаких других третьих лиц."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaa maareeya Google Play · waxay la xidhiidhaa akoonkaaga Google · lama wadaagno cid kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanteras av Google Play · kopplas till ditt Google-konto · ingen annan tredje part."
          }
        }
      }
    },
