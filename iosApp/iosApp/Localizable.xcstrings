    "create_group_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء المجموعة. تحقق من الاتصال وحاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen kunne ikke oprettes. Tjek forbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe konnte nicht erstellt werden. Prüfe die Verbindung und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create the group. Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido crear el grupo. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجاد گروه ممکن نشد. اتصال را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryhmän luonti epäonnistui. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le groupe. Vérifiez la connexion et réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групата не можеше да се креира. Проверете ја врската и обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opprette gruppen. Sjekk forbindelsen og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать группу. Проверьте соединение и попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama abuuri karin kooxda. Hubi xidhiidhka kadibna mar kale isku day."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte skapa gruppen. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
