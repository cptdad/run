    "add_contact_scan_back_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من جهة اتصالك الآن مسح رمزك. ستتمكنان من مراسلة بعضكما بمجرد أن يفعل ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad dem scanne din kode nu. I kan skrive til hinanden, så snart de gør det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Kontakt jetzt deinen Code scannen. Sobald er das tut, könnt ihr einander schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now let them scan your code. You’ll be able to message each other the moment they do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora pídele a tu contacto que escanee tu código. Podréis escribiros en cuanto lo haga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالا بگذارید مخاطبتان کد شما را اسکن کند. به‌محض این‌که این کار را انجام دهد، می‌توانید به هم پیام بدهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna hänen nyt lukea koodisi. Voitte lähettää viestejä toisillenne heti, kun hän tekee niin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-lui scanner votre code maintenant. Vous pourrez vous écrire dès qu'il le fera."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сега нека вашиот контакт го скенира вашиот код. Ќе можете да си пишувате веднаш штом тоа го стори."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La dem skanne koden din nå. Dere kan sende meldinger til hverandre så snart de gjør det."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть теперь ваш контакт отсканирует ваш код. Вы сможете переписываться друг с другом, как только он это сделает."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadda ka dhig xiriiriyahaaga inay sawir gareeyaan koodhkaaga. Waxaad awoodi doontaan inaad fariimo isu soo dirtaan isla marka ay sameeyaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt dem skanna din kod nu. Ni kan skriva till varandra så snart de gör det."
          }
        }
      }
    },
    "add_contact_scan_back_title": {
