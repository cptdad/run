    "add_contact_inbox_in_use": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إضافة جهة الاتصال هذه — أحد صناديق الوارد في رمزها مستخدم هنا بالفعل. إذا كنت تعيد إضافة شخص لديك أصلًا، فاحذف جهة الاتصال القديمة أولًا ثم حاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke tilføje denne kontakt — en af indbakkerne i deres kode er allerede i brug her. Hvis du tilføjer en, du allerede har, så slet den gamle kontakt først, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kontakt konnte nicht hinzugefügt werden — eines der Postfächer in seinem Code ist hier schon in Gebrauch. Wenn du jemanden erneut hinzufügst, den du bereits hast, lösche zuerst den alten Kontakt und versuch es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't add this contact — one of the inboxes in their code is already in use here. If you're re-adding someone you already have, delete the old contact first, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido añadir este contacto: uno de los buzones de su código ya está en uso aquí. Si estás volviendo a añadir a alguien que ya tienes, elimina primero el contacto antiguo y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مخاطب اضافه نشد — یکی از صندوق‌های ورودی در کد او همین حالا اینجا در استفاده است. اگر کسی را که از قبل دارید دوباره اضافه می‌کنید، اول مخاطب قدیمی را حذف کنید و بعد دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktia ei voitu lisätä — yksi hänen koodinsa postilaatikoista on jo käytössä täällä. Jos lisäät uudelleen jonkun, joka sinulla jo on, poista ensin vanha kontakti ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ajouter ce contact — l'une des boîtes de réception de son code est déjà utilisée ici. Si vous rajoutez quelqu'un que vous avez déjà, supprimez d'abord l'ancien contact, puis réessayez."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контактот не можеше да се додаде — едно од сандачињата во нивниот код веќе се користи тука. Ако повторно додавате некого што веќе го имате, прво избришете го стариот контакт, па обидете се повторно."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke legge til denne kontakten – en av innboksene i koden deres er allerede i bruk her. Hvis du legger til noen du allerede har på nytt, slett den gamle kontakten først, og prøv så igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить этот контакт — один из почтовых ящиков в коде этого контакта уже используется здесь. Если вы повторно добавляете уже существующий контакт, сначала удалите старый контакт, а затем попробуйте снова."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiriiriyahan lama darin karin — mid ka mid ah sanduuqyada ku jira koodhkooda ayaa hore loogu isticmaalayaa halkan. Haddii aad dib u darayso qof aad hore u haysay, marka hore tirtir xiriiriyihii hore, kadibna isku day mar kale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte lägga till kontakten — en av inkorgarna i deras kod används redan här. Om du lägger till någon du redan har på nytt, radera den gamla kontakten först och försök sedan igen."
          }
        }
      }
    },
