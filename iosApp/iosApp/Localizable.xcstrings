    "referral_relayed_first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق %1$@ على التقديم إلى %2$@. وقد مُرِّرت تفاصيل الاتصال. وبمجرد موافقة %2$@ أيضًا، يمكنهما مراسلة بعضهما."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har godkendt, at du introducerer vedkommende for %2$@. Forbindelsesoplysningerne er sendt videre. Når %2$@ også godkender, kan de skrive sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat bestätigt, %2$@ vorgestellt zu werden. Die Verbindungsdaten wurden weitergegeben. Sobald %2$@ ebenfalls bestätigt, können die beiden einander schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ approved your introduction to %2$@. Their connection details have been passed on. Once %2$@ approves too, they can message each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha aprobado tu presentación a %2$@. Sus datos de conexión ya se han enviado. En cuanto %2$@ la apruebe también, podrán escribirse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ معرفی به %2$@ را تأیید کرد. اطلاعات اتصال او ارسال شد. به‌محض اینکه %2$@ هم تأیید کند، می‌توانند به هم پیام بدهند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hyväksyi esittelysi henkilölle %2$@. Yhteyden muodostamiseen tarvittavat tiedot on välitetty eteenpäin. Kun myös %2$@ hyväksyy, he voivat viestiä keskenään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a approuvé votre présentation à %2$@. Ses informations de connexion ont été transmises. Dès que %2$@ l'approuvera à son tour, ils pourront s'écrire."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ го одобри вашето претставување на %2$@. Податоците за поврзување се проследени. Штом и %2$@ одобри, ќе можат да си пишуваат."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har godkjent at du introduserer vedkommende for %2$@. Tilkoblingsdetaljene er sendt videre. Når %2$@ også godkjenner, kan de sende meldinger til hverandre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ принимает ваше предложение познакомиться с %2$@. Данные для связи переданы дальше. Как только %2$@ тоже подтвердит, они смогут переписываться."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isbarashada aad %2$@ u samaysay waxaa ansixiyay %1$@. Faahfaahinta xidhiidhka waa la gudbiyay. Marka %2$@ isna ansixiyo, waxay fariimo isu diri karaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ godkände din introduktion till %2$@. Anslutningsuppgifterna har skickats vidare. När %2$@ också godkänner kan de skicka meddelanden till varandra."
          }
        }
      }
    },
    "referral_relayed_queued": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق %1$@ على التقديم إلى %2$@. تعذّر على Rún الوصول إلى المُرحّل الآن، وسيمرّر التفاصيل تلقائيًا في المرة القادمة التي تفتح فيها التطبيق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har godkendt, at du introducerer vedkommende for %2$@. Rún kunne ikke nå relæet lige nu og sender oplysningerne videre automatisk, næste gang du åbner appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat bestätigt, %2$@ vorgestellt zu werden. Rún konnte das Relay gerade nicht erreichen und gibt die Verbindungsdaten automatisch weiter, wenn du die App das nächste Mal öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ approved your introduction to %2$@. Rún could not reach the relay just now and will pass their details on automatically next time you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha aprobado tu presentación a %2$@. Rún no ha podido llegar al relay ahora mismo y enviará sus datos automáticamente la próxima vez que abras la app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ معرفی به %2$@ را تأیید کرد. Rún همین حالا نتوانست به رله برسد و دفعهٔ بعد که برنامه را باز کنید، اطلاعات را به‌طور خودکار می‌فرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hyväksyi esittelysi henkilölle %2$@. Rún ei juuri nyt saanut yhteyttä välityspalvelimeen ja välittää tiedot eteenpäin automaattisesti, kun seuraavan kerran avaat sovelluksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a approuvé votre présentation à %2$@. Rún n'a pas pu joindre le relais à l'instant et transmettra ses informations automatiquement à la prochaine ouverture de l'appli."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ го одобри вашето претставување на %2$@. Rún не можеше да стигне до релето сега и ќе ги проследи податоците автоматски следниот пат кога ќе ја отворите апликацијата."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har godkjent at du introduserer vedkommende for %2$@. Rún fikk ikke kontakt med relayet akkurat nå og sender detaljene videre automatisk neste gang du åpner appen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ принимает ваше предложение познакомиться с %2$@. Rún сейчас не может связаться с ретранслятором и передаст данные автоматически при следующем открытии приложения."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isbarashada aad %2$@ u samaysay waxaa ansixiyay %1$@. Rún hadda ma gaari karin relay-ga, faahfaahintana si toos ah ayuu u gudbin doonaa marka xigta ee aad app-ka furto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ godkände din introduktion till %2$@. Rún kunde inte nå reläet just nu och skickar vidare uppgifterna automatiskt nästa gång du öppnar appen."
          }
        }
      }
    },
