    "referral_introduce_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لمن تريد تقديم %1$@. لا تقدّم إلا أشخاصًا تعرفهم وتثق بهم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvem %1$@ skal introduceres for. Introducér kun folk, du kender og stoler på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wem du %1$@ vorstellen möchtest. Stelle nur Menschen vor, die du kennst und denen du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select who to introduce %1$@ to. Only introduce people you know and trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige a quién le presentas a %1$@. Presenta solo a personas que conozcas y en las que confíes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید %1$@ را به چه کسانی معرفی کنید. فقط کسانی را معرفی کنید که می‌شناسید و به آن‌ها اعتماد دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, kenelle esittelet henkilön %1$@. Esittele vain ihmisiä, jotka tunnet ja joihin luotat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez à qui présenter %1$@. Ne présentez que des personnes que vous connaissez et en qui vous avez confiance."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете на кого да претставите %1$@. Претставувајте само луѓе што ги познавате и им верувате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvem du vil introdusere %1$@ for. Introduser bare folk du kjenner og stoler på."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, с кем познакомить %1$@. Знакомьте только тех, кого вы знаете и кому доверяете."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro qofka aad %1$@ isu barayso. Kaliya isu bar dadka aad taqaanid oo aad kalsoonaan ku qabto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vem du vill introducera %1$@ för. Introducera bara personer du känner och litar på."
          }
        }
      }
    },
