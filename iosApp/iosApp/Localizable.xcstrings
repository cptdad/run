    "group_info_leave_confirm_admin_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت المشرف. انقل الدور أولًا، وإلا فلن يستطيع أحد تغيير قائمة الأعضاء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er admin. Overdrag rollen først, ellers kan ingen ændre medlemslisten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Admin. Übertrage die Rolle zuerst, sonst kann niemand mehr die Mitgliederliste ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the admin. Transfer the role first, or nobody will be able to change the member list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el administrador. Cede el cargo primero o nadie podrá cambiar la lista de miembros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما مدیر هستید. اول نقش را واگذار کنید، وگرنه هیچ‌کس نمی‌تواند فهرست اعضا را تغییر دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ylläpitäjä. Siirrä rooli ensin, tai kukaan ei voi enää muuttaa jäsenluetteloa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes l'administrateur. Transférez d'abord ce rôle, sinon plus personne ne pourra modifier la liste des membres."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие сте администраторот. Прво пренесете ја улогата, инаку никој нема да може да ја менува листата на членови."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er administrator. Overfør rollen først, ellers kan ingen endre medlemslisten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы администратор. Сначала передайте эту роль, иначе никто не сможет изменять список участников."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaad tahay maamulaha. Marka hore u wareeji doorkan, haddii kalese qofna ma awoodi doono inuu beddelo liiska xubnaha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är admin. Överlämna rollen först, annars kan ingen ändra medlemslistan."
          }
        }
      }
    },
    "group_info_leave_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُبلَّغ بقية الأعضاء بأنك غادرت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De andre medlemmer får besked om, at du har forladt gruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anderen Mitgliedern wird mitgeteilt, dass du die Gruppe verlassen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other members will be told you left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisará a los demás miembros de que has salido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به دیگر اعضا گفته می‌شود که شما رفته‌اید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muille jäsenille kerrotaan, että poistuit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres membres seront informés de votre départ."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Другите членови ќе бидат известени дека заминавте."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De andre medlemmene får beskjed om at du har forlatt gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные участники узнают, что вы покинули группу."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xubnaha kale waa loo sheegi doonaa inaad ka baxday."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De andra medlemmarna får veta att du lämnade gruppen."
          }
        }
      }
    },
