    "pin_orphaned_vault_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد على هذا الجهاز خزنة، لكن لا يوجد رمز PIN ولا عبارة مرور محفوظة لها، فلا شيء يستطيع فتحها. لا يمكن استرداد محتوياتها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har en boks, men der er hverken en PIN eller en adgangssætning gemt til den, så intet kan åbne den. Indholdet kan ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät liegt ein Tresor, aber es ist weder eine PIN noch eine Passphrase dafür gespeichert — nichts kann ihn öffnen. Sein Inhalt lässt sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has a vault, but no PIN or passphrase is stored for it, so nothing can open it. Its contents cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo tiene una caja fuerte, pero no hay ningún PIN ni frase de contraseña guardados para ella, así que nada puede abrirla. Su contenido no se puede recuperar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی این دستگاه گاوصندوقی هست، اما نه PIN برای آن ذخیره شده و نه عبارت عبور؛ پس هیچ چیز نمی‌تواند آن را باز کند. محتوای آن قابل بازیابی نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä laitteella on holvi, mutta sille ei ole tallennettu PIN-koodia eikä salalausetta, joten mikään ei voi avata sitä. Sen sisältöä ei voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil contient un coffre-fort, mais aucun code PIN ni phrase secrète n'est enregistré pour lui : rien ne peut l'ouvrir. Son contenu est irrécupérable."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој уред има трезор, но за него не е зачуван PIN или тајна фраза, па ништо не може да го отклучи. Неговата содржина не може да се обнови."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten har et hvelv, men ingen PIN eller passfrase er lagret for det, så ingenting kan åpne det. Innholdet kan ikke gjenopprettes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве есть хранилище, но для него не сохранён ни PIN, ни парольная фраза, поэтому открыть его нечем. Его содержимое невозможно восстановить."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalabkan wuxuu leeyahay khasnad, laakiin PIN ama weedh sir ah lama kaydin, sidaas darteed waxba ma furi karo. Waxa ku jira lama soo celin karo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten har ett valv, men ingen PIN-kod och ingen lösenfras finns sparad för det, så inget kan öppna det. Innehållet går inte att få tillbaka."
          }
        }
      }
    },
