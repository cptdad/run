    "move_qr_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شخص يصوّر هذا الرمز يمكنه الاستيلاء على عملية النقل. لا تعرضه إلا على الهاتف الجديد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, der fotograferer denne kode, kan overtage overførslen. Vis den kun til den nye telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Code fotografiert, kann die Übertragung übernehmen. Zeig ihn nur dem neuen Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who photographs this code can take the transfer. Show it only to the new phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que fotografíe este código puede apropiarse de la transferencia. Muéstraselo solo al teléfono nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کسی که از این کد عکس بگیرد می‌تواند انتقال را بردارد. آن را فقط به گوشی جدید نشان دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa, joka kuvaa tämän koodin, voi kaapata siirron. Näytä se vain uudelle puhelimelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque photographie ce code peut s'approprier le transfert. Ne le montrez qu'au nouveau téléphone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секој што ќе го фотографира овој код може да го преземе преносот. Покажете го само на новиот телефон."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle som fotograferer denne koden, kan overta overføringen. Vis den bare til den nye telefonen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, кто сфотографирует этот код, сможет перехватить передачу. Показывайте его только новому телефону."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qof kasta oo koodhkan sawirta wuu qaadan karaa wareejinta. Kaliya taleefanka cusub tus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den som fotograferar den här koden kan ta över överföringen. Visa den bara för den nya telefonen."
          }
        }
      }
    },
