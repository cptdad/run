          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qufulka shaashadda ee qalabkaaga ayaa isbeddelay, sidaas darteed furaha qalabka ee ilaalinayay khasnaddan wuu lumay. Haddii aan jirin koodh soo-celin, khasnaddan lama furi karo."
          }
        },
        "sv": {
