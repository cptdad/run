    "pin_erase_vault_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فتح الخزنة الموجودة على هذا الجهاز — فلا يوجد رمز PIN ولا عبارة مرور محفوظة لها. المحو يحذفها نهائيًا ويبدأ إعدادًا جديدًا. لا يمكن التراجع عن هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen på denne enhed kan ikke åbnes — der er hverken en PIN eller en adgangssætning gemt til den. Sletter du den, forsvinder den permanent, og en ny opsætning begynder. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor auf diesem Gerät lässt sich nicht öffnen — es ist weder eine PIN noch eine Passphrase dafür gespeichert. Beim Löschen wird er endgültig entfernt und eine neue Einrichtung gestartet. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault on this device cannot be opened — no PIN or passphrase is stored for it. Erasing deletes it permanently and starts a new setup. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte de este dispositivo no se puede abrir: no hay ningún PIN ni frase de contraseña guardados para ella. Al borrarla se elimina de forma permanente y empieza una configuración nueva. Esto no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاوصندوق روی این دستگاه باز نمی‌شود — نه PIN برای آن ذخیره شده و نه عبارت عبور. با پاک کردن، برای همیشه حذف می‌شود و یک راه‌اندازی تازه آغاز می‌گردد. این کار قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän laitteen holvia ei voi avata — sille ei ole tallennettu PIN-koodia eikä salalausetta. Pyyhkiminen poistaa sen pysyvästi ja aloittaa uuden käyttöönoton. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort de cet appareil ne peut pas être ouvert — aucun code PIN ni phrase secrète n'est enregistré pour lui. L'effacer le supprime définitivement et lance une nouvelle configuration. Cette action est irréversible."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трезорот на овој уред не може да се отвори — за него не е зачуван PIN или тајна фраза. Бришењето трајно го отстранува и започнува ново поставување. Ова не може да се поништи."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvelvet på denne enheten kan ikke åpnes – ingen PIN eller passfrase er lagret for det. Sletting fjerner det permanent og starter et nytt oppsett. Dette kan ikke angres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище на этом устройстве невозможно открыть — для него не сохранён ни PIN, ни парольная фраза. Удаление сотрёт его навсегда и запустит новую настройку. Это действие необратимо."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Khasnadda taleefankan lama furi karo — PIN ama weedh sir ah lama kaydin. Tirtiriddu si joogto ah ayay u baabbi'inaysaa, waxayna bilaabaysaa dejin cusub. Tan lama soo celin karo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valvet på den här enheten går inte att öppna — ingen PIN-kod och ingen lösenfras finns sparad för det. Att radera tar bort det permanent och startar en ny konfiguration. Det går inte att ångra."
          }
        }
      }
    },
    "pin_erase_vault_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد محو هذه الخزنة؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet denne boks?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tresor löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase this vault?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar esta caja fuerte?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گاوصندوق پاک شود؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhitäänkö tämä holvi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer ce coffre-fort ?"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се избрише овој трезор?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette dette hvelvet?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить это хранилище?"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirtir khasnaddan?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera det här valvet?"
          }
        }
      }
    },
    "pin_hardware_lock_not_enabled_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد هاتفك مفتاح العتاد، لذا أُعدّت خزنتك على مستوى حماية أدنى. يمكنك تفعيله لاحقًا من الإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon bekræftede ikke hardwarenøglen, så din boks er sat op på et lavere beskyttelsesniveau. Du kan slå den til senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon hat den Hardware-Schlüssel nicht bestätigt, deshalb wurde dein Tresor mit einer niedrigeren Schutzstufe eingerichtet. Du kannst sie später in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone didn’t confirm the hardware key, so your vault is set up at a lower protection level. You can turn it on later from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono no ha confirmado la clave de hardware, así que tu caja fuerte se configura con un nivel de protección más bajo. Puedes activarlo más tarde desde Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی شما کلید سخت‌افزاری را تأیید نکرد، بنابراین گاوصندوق شما با سطح حفاظت پایین‌تری راه‌اندازی شد. می‌توانید بعداً از تنظیمات آن را روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimesi ei vahvistanut laitteistoavainta, joten holvisi otettiin käyttöön matalammalla suojaustasolla. Voit ottaa sen käyttöön myöhemmin asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone n'a pas confirmé la clé matérielle : votre coffre-fort est donc configuré à un niveau de protection inférieur. Vous pourrez l'activer plus tard depuis les Paramètres."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот телефон не го потврди хардверскиот клуч, па вашиот трезор е поставен на пониско ниво на заштита. Можете да го вклучите подоцна од Поставки."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen bekreftet ikke maskinvarenøkkelen, så hvelvet ditt er satt opp med et lavere beskyttelsesnivå. Du kan slå det på senere i Innstillinger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон не подтвердил аппаратный ключ, поэтому хранилище настроено на более низком уровне защиты. Включить аппаратную блокировку можно позже в настройках."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankaagu ma xaqiijin furaha qalabka, sidaas darteed khasnaddaadu waxay ku dhisan tahay heer ilaalin oo hooseeya. Waxaad mar dambe ka shidi kartaa Dejinta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen bekräftade inte hårdvarunyckeln, så ditt valv sattes upp på en lägre skyddsnivå. Du kan slå på den senare i Inställningar."
          }
        }
      }
    },
