          "stringUnit": {
            "state": "translated",
            "value": "Villkor och kontakt"
          }
        }
      }
    },
    "move_cancel_label": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء النقل"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullér flytningen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragung abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar el traslado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو انتقال"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuta siirto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler le transfert"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Откажи го преместувањето"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt flyttingen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить перенос"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Jooji wareejinta"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt flytten"
          }
        }
      }
    },
    "move_cancel_refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فات أوان الإلغاء — فقد استُلم النقل بالفعل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent at annullere — overførslen er allerede blevet hentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu spät zum Abbrechen — die Übertragung wurde bereits abgeholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too late to cancel — the transfer has already been picked up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya es demasiado tarde para cancelar: la transferencia ya se ha recogido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای لغو دیر شده است — انتقال از قبل برداشته شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian myöhäistä peruuttaa — siirto on jo noudettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop tard pour annuler — le transfert a déjà été récupéré."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоцна е за откажување — преносот е веќе преземен."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent å avbryte — overføringen er allerede hentet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить уже нельзя — передача уже получена."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waa goor dambe in la joojiyo — wareejinta horey ayaa loo qaatay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För sent att avbryta — överföringen har redan hämtats."
          }
        }
      }
    },
    "move_cancel_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق مما إذا كان الهاتف الجديد قد استلم النقل بعد. حاول مرة أخرى بعد قليل، أو امحُ هذا الهاتف بمجرد أن يعمل الجديد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke tjekke, om den nye telefon har hentet overførslen endnu. Prøv igen om lidt, eller slet denne telefon, når den nye virker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht prüfen, ob das neue Handy die Übertragung schon hat. Versuch es gleich noch mal, oder lösche dieses Handy, sobald das neue funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check whether the new phone has the transfer yet. Try again in a moment, or wipe this phone once the new one is working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar si el teléfono nuevo ya tiene la transferencia. Inténtalo de nuevo dentro de un momento, o borra este teléfono en cuanto el nuevo esté funcionando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی اینکه گوشی جدید انتقال را گرفته است یا نه ممکن نشد. کمی بعد دوباره تلاش کنید، یا وقتی گوشی جدید کار کرد این گوشی را پاک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voitu tarkistaa, onko uusi puhelin jo saanut siirron. Yritä hetken kuluttua uudelleen, tai pyyhi tämä puhelin, kun uusi toimii."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier si le nouveau téléphone a déjà récupéré le transfert. Réessayez dans un instant, ou effacez ce téléphone une fois que le nouveau fonctionne."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можеше да се провери дали новиот телефон веќе го има преносот. Обидете се повторно за момент или избришете го овој телефон штом новиот проработи."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sjekke om den nye telefonen har hentet overføringen ennå. Prøv igjen om litt, eller slett denne telefonen når den nye fungerer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить, получил ли новый телефон передачу. Повторите попытку через некоторое время или сотрите данные этого телефона, когда новый заработает."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Lama xaqiijin karin in taleefanka cusub uu wareejinta helay iyo in kale. Daqiiqad kadib isku day mar kale, ama tirtir taleefankan marka kan cusub uu shaqeynayo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att kontrollera om den nya telefonen har hämtat överföringen än. Försök igen om en stund, eller radera den här telefonen när den nya fungerar."
          }
        }
      }
    },
    "move_done_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من الهاتف الجديد أولًا: يجب أن يعرض جهات اتصالك. وعندها، محو هذا الهاتف هو ما يجعل النقل آمنًا — لن يمكن قراءة أي شيء هنا بعد ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek først den nye telefon: den bør vise dine kontakter. Når den gør det, er det sletning af denne telefon, der gør flytningen sikker — intet her kan læses bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe zuerst das neue Handy: Es sollte deine Kontakte zeigen. Sobald das der Fall ist, macht das Löschen dieses Handys die Übertragung sicher — danach lässt sich hier nichts mehr lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the new phone first: it should show your contacts. Once it does, wiping this phone is what makes the move safe — nothing here can be read afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba primero el teléfono nuevo: debería mostrar tus contactos. Cuando lo haga, borrar este teléfono es lo que hace que el traslado sea seguro; después no se podrá leer nada de lo que hay aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اول گوشی جدید را بررسی کنید: باید مخاطبان شما را نشان دهد. وقتی نشان داد، پاک کردن این گوشی است که انتقال را امن می‌کند — پس از آن هیچ‌چیزی اینجا قابل خواندن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista ensin uusi puhelin: sen pitäisi näyttää yhteystietosi. Kun se näyttää, tämän puhelimen pyyhkiminen tekee siirrosta turvallisen — mitään täältä ei voi enää lukea sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez d'abord le nouveau téléphone : il doit afficher vos contacts. Une fois que c'est le cas, effacer ce téléphone est ce qui rend le transfert sûr — plus rien ici ne pourra être lu ensuite."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво проверете го новиот телефон: треба да ги прикажува вашите контакти. Штом ги прикаже, бришењето на овој телефон е тоа што го прави преместувањето безбедно — потоа ништо тука не може да се прочита."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk den nye telefonen først: den skal vise kontaktene dine. Når den gjør det, er det å slette denne telefonen som gjør flyttingen trygg — ingenting her kan leses etterpå."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала проверьте новый телефон: на нём должны появиться ваши контакты. Как только это произойдёт, сотрите данные этого телефона — именно стирание делает перенос безопасным: после него здесь ничего нельзя будет прочитать."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Marka hore hubi taleefanka cusub: waa inuu tusayaa xiriirradaada. Marka uu sidaas yeelo, tirtiridda taleefankan ayaa wareejinta ka dhigaysa mid ammaan ah — waxba halkan kadib lagama akhrin karo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera den nya telefonen först: den ska visa dina kontakter. När den gör det är det raderingen av den här telefonen som gör flytten säker — inget här går att läsa efteråt."
          }
        }
      }
    },
    "move_done_expired_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يستلمه الهاتف الجديد إطلاقًا، فربما انتهت صلاحية الرمز ببساطة. أبقِ هذا الهاتف متوقّفًا واعرض رمزًا جديدًا بدلًا من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den nye telefon aldrig fik den, er koden måske simpelthen løbet ud. Lad denne telefon være slukket, og vis en ny kode i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls das neue Handy es nie bekommen hat, ist der Code vielleicht einfach abgelaufen. Lass dieses Handy aus und zeig stattdessen einen neuen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the new phone never got it, the code may simply have run out. Keep this phone off and show a fresh code instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el teléfono nuevo nunca lo recibió, es posible que el código simplemente haya caducado. Mantén este teléfono desactivado y muestra un código nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر گوشی جدید هرگز آن را نگرفت، شاید فقط اعتبار کد تمام شده باشد. این گوشی را غیرفعال نگه دارید و به‌جایش کد تازه‌ای نشان دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos uusi puhelin ei koskaan saanut sitä, koodi on saattanut yksinkertaisesti vanhentua. Pidä tämä puhelin pois käytöstä ja näytä sen sijaan uusi koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le nouveau téléphone ne l'a jamais reçu, il se peut simplement que le code ait expiré. Gardez ce téléphone inactif et affichez plutôt un nouveau code."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако новиот телефон никогаш не го добил, кодот можеби едноставно истекол. Оставете го овој телефон неактивен и прикажете нов код."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den nye telefonen aldri fikk den, kan koden rett og slett ha gått ut. La denne telefonen være av, og vis en ny kode i stedet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если новый телефон так и не получил передачу, возможно, срок действия кода просто истёк. Держите этот телефон выключенным и покажите новый код."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Haddii taleefanka cusub uusan weligiis helin, koodhku wuxuu laga yaabaa inuu dhacay. Taleefankan damsan u daa oo koodh cusub tus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om den nya telefonen aldrig fick den kan koden helt enkelt ha gått ut. Låt den här telefonen vara avstängd och visa en ny kod istället."
          }
        }
      }
    },
