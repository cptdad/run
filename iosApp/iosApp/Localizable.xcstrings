        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaa loo mariyaa Tor"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigerad via Tor"
          }
        }
      }
    },
    "about_tor_runestone_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راقب حجر الرونات — اللون الأحمر يعني أنك على Tor. تنبض حلقته بقوة أكبر كلما اقتربت، وتثبت حمراء بمجرد أن يردّ المُرحّل، ثم يضيء حرف R."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold øje med runestenen — rød betyder, at du er på Tor. Ringen pulserer kraftigere, jo tættere du kommer, lyser konstant rød i det øjeblik relæet svarer, og så tændes R'et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf den Runenstein — Rot heißt, du bist über Tor unterwegs. Sein Ring pulsiert stärker, je näher du kommst, leuchtet durchgehend rot, sobald das Relay antwortet, und dann leuchtet das R auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the runestone — red means you're on Tor. Its ring pulses harder the closer you get, holds solid red the moment the relay answers, and then the R lights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fíjate en la piedra rúnica: el rojo significa que estás en Tor. Su anillo late con más fuerza cuanto más cerca estás, se queda en rojo fijo en cuanto responde el relay y luego se enciende la R."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سنگ رونی نگاه کنید — قرمز یعنی روی Tor هستید. حلقه‌اش هرچه نزدیک‌تر شوید تندتر می‌تپد، همین‌که رله پاسخ دهد قرمز ثابت می‌ماند و بعد حرف R روشن می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkkaile riimukiveä — punainen tarkoittaa, että olet Tor-verkossa. Sen rengas sykkii sitä voimakkaammin, mitä lähempänä olet, palaa tasaisen punaisena heti kun välityspalvelin vastaa, ja sitten R-kirjain syttyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observez la pierre runique — le rouge signifie que vous passez par Tor. Plus vous approchez, plus son anneau palpite fort ; il reste rouge fixe dès que le relais répond, puis le R s'allume."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набљудувајте го рунскиот камен — црвено значи дека сте на Tor. Неговиот прстен пулсира посилно колку што сте поблиску, свети постојано црвено штом релето ќе одговори, а потоа се пали буквата R."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg med på runesteinen – rødt betyr at du er på Tor. Ringen pulserer kraftigere jo nærmere du kommer, lyser jevnt rødt i det øyeblikket relayet svarer, og så tennes R-en."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за руническим камнем — красный цвет означает, что вы подключены через Tor. Его кольцо пульсирует тем сильнее, чем ближе подключение, а как только ретранслятор ответит, горит ровным красным — и затем загорается буква R."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiiri dhagaxa runaha — guduudku wuxuu ka dhigan yahay inaad ku jirto Tor. Giraantiisu si xoog badan ayay u garaacdaa marka aad u soo dhowaanayso, waxayna noqotaa guduud joogto ah marka relay-gu jawaabo, kadibna xarafka R wuu iftiimaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ögonen på runstenen — rött betyder att du är på Tor. Ringen pulserar starkare ju närmare du kommer, lyser stadigt röd i samma stund som reläet svarar, och sedan tänds R:et."
          }
        }
      }
    },
