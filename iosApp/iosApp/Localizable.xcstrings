    "gate_compromised_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن هذا الجهاز يعمل بصلاحيات الروت. لا يستطيع Rún ضمان أمان رسائلك على جهاز مُخترَق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed ser ud til at være rootet. Rún kan ikke garantere sikkerheden for dine beskeder på en kompromitteret enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät scheint gerootet zu sein. Rún kann die Sicherheit deiner Nachrichten auf einem kompromittierten Gerät nicht garantieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device appears to be rooted. Rún cannot guarantee the security of your messages on a compromised device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo parece tener acceso root. Rún no puede garantizar la seguridad de tus mensajes en un dispositivo comprometido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد این دستگاه روت شده است. Rún نمی‌تواند امنیت پیام‌های شما را روی یک دستگاه به‌خطرافتاده تضمین کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite näyttää olevan rootattu. Rún ei voi taata viestiesi turvallisuutta vaarantuneella laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil semble rooté. Rún ne peut pas garantir la sécurité de vos messages sur un appareil compromis."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгледа дека на овој уред е направен root. Rún не може да ја гарантира безбедноста на вашите пораки на компромитиран уред."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten ser ut til å være rootet. Rún kan ikke garantere sikkerheten til meldingene dine på en kompromittert enhet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, на этом устройстве получены root-права. Rún не может гарантировать безопасность ваших сообщений на скомпрометированном устройстве."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalabkani wuxuu u muuqdaa mid la root gareeyay. Rún ma dammaanad qaadi karto ammaanka fariimahaaga marka qalabku uu yahay mid la jebiyey."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten verkar vara rootad. Rún kan inte garantera säkerheten för dina meddelanden på en komprometterad enhet."
          }
        }
      }
    },
