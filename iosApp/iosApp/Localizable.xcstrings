    "referral_relayed_complete": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق كلٌّ من %1$@ و%2$@. ولدى كلٍّ منهما الآن ما يلزم للوصول إلى الآخر. لا دخل لك في محادثتهما ولا يمكنك قراءتها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Både %1$@ og %2$@ har godkendt. Nu har de hver især det, der skal til for at nå hinanden. Du er ikke en del af deres samtale og kan ikke læse den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ haben beide bestätigt. Jede Seite hat jetzt, was sie braucht, um die andere zu erreichen. Du bist an ihrem Gespräch nicht beteiligt und kannst es nicht mitlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both %1$@ and %2$@ approved. Each now has what they need to reach the other. You have no part in their conversation and cannot read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto %1$@ como %2$@ han aprobado. Cada uno tiene ya lo que necesita para llegar al otro. Tú no formas parte de su conversación y no puedes leerla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هم %1$@ و هم %2$@ تأیید کردند. حالا هرکدام آنچه را برای رسیدن به دیگری لازم دارند در اختیار دارند. شما در گفت‌وگوی آن‌ها نقشی ندارید و نمی‌توانید آن را بخوانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekä %1$@ että %2$@ hyväksyivät. Kummallakin on nyt se, mitä toisen tavoittamiseen tarvitaan. Sinä et ole osa heidän keskusteluaan etkä voi lukea sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ ont tous les deux approuvé. Chacun a maintenant ce qu'il faut pour joindre l'autre. Vous ne faites pas partie de leur conversation et vous ne pouvez pas la lire."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "И %1$@ и %2$@ одобрија. Сега секој има сè што му треба за да стигне до другиот. Вие не сте дел од нивниот разговор и не можете да го читате."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Både %1$@ og %2$@ har godkjent. Nå har hver av dem det som skal til for å nå den andre. Du er ikke en del av samtalen deres og kan ikke lese den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И %1$@, и %2$@ подтвердили. Теперь у каждого есть всё нужное, чтобы связаться с другим. Вы не участвуете в их переписке и не можете её прочитать."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ iyo %2$@ labadooduba way ansixiyeen. Mid kastaa hadda wuxuu haystaa waxa uu ugu baahan yahay si uu kan kale u soo gaaro. Adigu wax qayb ah kama lihid wada-hadalkooda, mana akhriyi kartid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Både %1$@ och %2$@ har godkänt. Nu har var och en det som behövs för att nå den andra. Du har ingen del i deras samtal och kan inte läsa det."
          }
        }
      }
    },
