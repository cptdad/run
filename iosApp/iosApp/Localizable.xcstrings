    "donate_appeal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إعلانات في Rún ولا مستثمرين، ولا يبيع بياناتك أبدًا. كل تبرع — كبيرًا كان أم صغيرًا — يساعد على إبقائه مجانيًا للجميع، إلى الأبد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har ingen reklamer, ingen investorer og sælger aldrig dine data. Hver donation — stor eller lille — hjælper med at holde appen gratis for alle, for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún hat keine Werbung, keine Investoren und verkauft niemals deine Daten. Jede Spende — groß oder klein — hilft, die App für alle kostenlos zu halten, für immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún has no ads, no investors, and never sells your data. Every donation — large or small — helps keep it free for everyone, forever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún no tiene anuncios ni inversores, y nunca vende tus datos. Cada donación, grande o pequeña, ayuda a mantenerlo gratuito para todo el mundo, para siempre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún نه تبلیغ دارد، نه سرمایه‌گذار، و هرگز داده‌های شما را نمی‌فروشد. هر کمکی — بزرگ یا کوچک — به رایگان ماندن آن برای همه کمک می‌کند، برای همیشه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ei näytä mainoksia eikä sillä ole sijoittajia, eikä se koskaan myy tietojasi. Jokainen lahjoitus — suuri tai pieni — auttaa pitämään sen ilmaisena kaikille, ikuisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún n'a ni publicité, ni investisseurs, et ne vend jamais vos données. Chaque don — grand ou petit — aide à la garder gratuite pour tous, pour toujours."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún нема реклами, нема инвеститори и никогаш не ги продава вашите податоци. Секоја донација — голема или мала — помага да остане бесплатен за сите, засекогаш."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har ingen annonser, ingen investorer, og selger aldri dataene dine. Hver donasjon – stor eller liten – bidrar til å holde appen gratis for alle, for alltid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Rún нет ни рекламы, ни инвесторов, и он никогда не продаёт ваши данные. Каждое пожертвование — большое или маленькое — помогает сохранять его бесплатным для всех и навсегда."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún ma laha xayaysiisyo, ma laha maalgashadayaal, marnaba xogtaadana ma iibiyo. Deeq kasta — tan weyn ama tan yar — waxay caawisaa in loo sii daayo bilaash qof kasta, weligiis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rún har inga annonser, inga investerare och säljer aldrig dina data. Varje donation — stor som liten — hjälper till att hålla appen gratis för alla, för alltid."
          }
        }
      }
    },
