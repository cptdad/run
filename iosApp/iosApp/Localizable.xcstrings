    "add_contact_paste_not_ready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال صندوق الوارد قيد التجهيز — حاول مجددًا بعد لحظات"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter stadig indbakke — prøv igen om et øjeblik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Postfach wird noch eingerichtet — versuch es gleich erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still setting up inbox — try again in a moment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía se está preparando el buzón; inténtalo dentro de un momento"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صندوق ورودی هنوز در حال راه‌اندازی است — چند لحظهٔ دیگر دوباره تلاش کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Postilaatikkoa valmistellaan vielä — yritä hetken kuluttua uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boîte de réception en cours de création — réessayez dans un instant"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сандачето сè уште се поставува — обидете се повторно за момент"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter fortsatt opp innboksen – prøv igjen om et øyeblikk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почтовый ящик ещё создаётся — попробуйте снова через мгновение"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanduuqa weli waa la diyaarinayaa — wax yar ka dib isku day mar kale"
          }
        },
        "sv": {
