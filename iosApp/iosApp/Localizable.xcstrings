    "ext_proxy_saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. أغلق Rún ثم افتحه مجددًا لتطبيق ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt. Luk og åbn Rún igen for at anvende det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Schließe Rún und öffne es erneut, um die Änderung zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Close and reopen Rún to apply it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Cierra y vuelve a abrir Rún para aplicarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره شد. برای اعمال، Rún را ببندید و دوباره باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu. Sulje Rún ja avaa se uudelleen ottaaksesi muutoksen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Fermez puis rouvrez Rún pour l'appliquer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачувано. Затворете го и повторно отворете го Rún за да се примени."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret. Lukk og åpne Rún på nytt for å ta den i bruk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Закройте и снова откройте Rún, чтобы применить настройку."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "La keydiyay. Xir oo mar kale fur Rún si loo dabaqo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparat. Stäng och öppna Rún igen för att tillämpa det."
          }
        }
      }
    },
