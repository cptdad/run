    "pin_permanent_key_loss_lockscreen_has_recovery": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر قفل شاشة جهازك، لذا فُقد مفتاح العتاد الذي يحمي هذه الخزنة. لا يزال بإمكان رمز الاسترداد فتحها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din enheds skærmlås er blevet ændret, så hardwarenøglen, der beskytter denne boks, er væk. Din gendannelseskode kan stadig åbne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bildschirmsperre hat sich geändert, deshalb ist der Hardware-Schlüssel für diesen Tresor verloren. Dein Wiederherstellungscode kann ihn noch öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device lock screen changed, so the hardware key protecting this vault is gone. Your recovery code can still open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de bloqueo de tu dispositivo ha cambiado, así que la clave de hardware que protegía esta caja fuerte ya no existe. Tu código de recuperación todavía puede abrirla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل صفحهٔ دستگاه شما تغییر کرده، بنابراین کلید سخت‌افزاریِ محافظ این گاوصندوق از بین رفته است. کد بازیابی شما هنوز می‌تواند آن را باز کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteesi näytön lukitus muuttui, joten tätä holvia suojannut laitteistoavain on poissa. Palautuskoodisi voi silti avata sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran de verrouillage de votre appareil a changé : la clé matérielle qui protégeait ce coffre-fort a disparu. Votre code de récupération peut encore l'ouvrir."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заклучувањето на екранот на вашиот уред се промени, па хардверскиот клуч што го штитеше овој трезор исчезна. Вашиот код за обновување сепак може да го отклучи."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låseskjermen på enheten er endret, så maskinvarenøkkelen som beskytter dette hvelvet, er borte. Gjenopprettingskoden din kan fortsatt åpne det."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран блокировки устройства изменился, поэтому аппаратный ключ, защищавший это хранилище, утерян. Ваш код восстановления всё ещё может его открыть."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Qufulka shaashadda ee qalabkaaga ayaa isbeddelay, sidaas darteed furaha qalabka ee ilaalinayay khasnaddan wuu lumay. Koodhka soo-celinta ayaa weli furi kara."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetens skärmlås har ändrats, så hårdvarunyckeln som skyddar valvet är borta. Din återställningskod kan fortfarande öppna det."
          }
        }
      }
    },
    "pin_permanent_key_loss_lockscreen_no_recovery": {
      "extractionState": "manual",
      "localizations": {
