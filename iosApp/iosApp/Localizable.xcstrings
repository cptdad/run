    "ext_proxy_error_save": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الإعداد. حاول مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingen kunne ikke gemmes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung konnte nicht gespeichert werden. Versuche es erneut."
