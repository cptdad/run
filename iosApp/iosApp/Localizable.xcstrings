    "protection_empty_state": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستوى للمتابعة. لن يُختار لك أي مستوى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et niveau for at fortsætte. Der bliver ikke valgt et niveau for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Stufe, um fortzufahren. Es wird keine Stufe für dich vorausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a level to continue. No level is chosen for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nivel para continuar. Nadie elige por ti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامه یک سطح انتخاب کنید. هیچ سطحی به‌جای شما انتخاب نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse taso jatkaaksesi. Mitään tasoa ei valita puolestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un niveau pour continuer. Aucun niveau n'est choisi à votre place."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете ниво за да продолжите. Ниту едно ниво не е избрано за вас."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et nivå for å fortsette. Ingen nivå velges for deg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите уровень, чтобы продолжить. Уровень не выбирается автоматически."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Dooro heer si aad u sii wadato. Heer kuuma la dooran."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en nivå för att fortsätta. Ingen nivå väljs åt dig."
          }
        }
      }
    },
    "protection_enabling_body_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يطلب منك هاتفك التأكيد بقفل الشاشة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon beder dig måske bekræfte med skærmlåsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon fragt dich möglicherweise nach seiner Bildschirmsperre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone may ask you to confirm with its screen lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tu teléfono te pida confirmar con su bloqueo de pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی شما ممکن است برای تأیید، قفل صفحه را بخواهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimesi voi pyytää vahvistusta näytön lukituksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone peut vous demander de confirmer avec son verrouillage d'écran."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот телефон може да побара потврда со заклучувањето на екранот."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kan be deg bekrefte med skjermlåsen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон может попросить подтвердить действие с помощью блокировки экрана."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankaagu wuxuu kaa codsan karaa inaad ku xaqiijiso qufulka shaashaddiisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kan be dig bekräfta med skärmlåset."
          }
        }
      }
    },
    "protection_enabling_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يطلب منك هاتفك التأكيد بواسطة Face ID أو رمز الدخول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon beder dig måske bekræfte med Face ID eller enhedens adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon fragt dich möglicherweise nach Face ID oder deinem Gerätecode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone may ask you to confirm with Face ID or its passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tu teléfono te pida confirmar con Face ID o con su código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی شما ممکن است برای تأیید، Face ID یا رمز دستگاه را بخواهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimesi voi pyytää vahvistusta Face ID:llä tai pääsykoodilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone peut vous demander de confirmer avec Face ID ou son code."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашиот телефон може да побара потврда со Face ID или неговиот код за пристап."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kan be deg bekrefte med Face ID eller koden sin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон может попросить подтвердить действие с помощью Face ID или код-пароля."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleefankaagu wuxuu kaa codsan karaa inaad ku xaqiijiso Face ID ama passcode-kiisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kan be dig bekräfta med Face ID eller lösenkoden."
          }
        }
      }
    },
    "protection_enabling_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تأمين خزنتك…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikrer din boks…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tresor wird gesichert…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Securing your vault…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegurando tu caja fuerte…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال ایمن‌سازی گاوصندوق شما…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojataan holviasi…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurisation de votre coffre-fort…"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се обезбедува вашиот трезор…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikrer hvelvet ditt…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищаем хранилище…"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waa la ammaanayaa khasnaddaada…"
