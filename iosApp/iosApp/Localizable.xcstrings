    "connect_mint_stalled_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الاتصال جاريًا… قد تكون هذه الشبكة تحجب الاتصال الخاص. جرّب شبكة Wi-Fi أخرى أو بيانات الهاتف — وسنواصل المحاولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbinder stadig… Dette netværk blokerer måske den private forbindelse. Prøv et andet Wi-Fi eller mobildata — vi bliver ved med at forsøge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung läuft noch… Dieses Netzwerk blockiert möglicherweise die private Verbindung. Versuch ein anderes WLAN oder mobile Daten — wir versuchen es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still connecting… This network may be blocking the private connection. Try different Wi-Fi or mobile data — we’ll keep trying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos conectando… Es posible que esta red esté bloqueando la conexión privada. Prueba con otra red Wi-Fi o con datos móviles; seguiremos intentándolo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همچنان در حال اتصال… شاید این شبکه ارتباط خصوصی را مسدود می‌کند. یک وای‌فای دیگر یا اینترنت همراه را امتحان کنید — ما به تلاش ادامه می‌دهیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään yhä… Tämä verkko saattaa estää yksityisen yhteyden. Kokeile toista Wi-Fi-verkkoa tai mobiilidataa — jatkamme yrittämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion toujours en cours… Ce réseau bloque peut-être la connexion privée. Essayez un autre Wi-Fi ou les données mobiles — nous continuons d'essayer."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште се поврзува… Оваа мрежа можеби ја блокира приватната врска. Обидете се со друг Wi-Fi или мобилен интернет — ние ќе продолжиме да се обидуваме."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler fortsatt til… Dette nettverket blokkerer kanskje den private forbindelsen. Prøv et annet Wi-Fi eller mobildata – vi fortsetter å prøve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё подключаемся… Эта сеть может блокировать приватное соединение. Попробуйте другой Wi-Fi или мобильный интернет — мы продолжим попытки."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Weli waa la xidhiidhayaa… Shabakaddan ayaa laga yaabaa inay xannibayso xidhiidhka gaarka ah. Isku day Wi-Fi kale ama datada mobilka — waxaannu sii isku dayi doonnaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter fortfarande… Nätverket kan blockera den privata anslutningen. Prova ett annat Wi-Fi eller mobildata — vi fortsätter försöka."
          }
        }
      }
    },
