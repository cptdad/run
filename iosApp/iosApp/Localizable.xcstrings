    "contact_list_block_shared_groups_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال %1$@ عضوًا في مجموعة تشترك فيها معه. الحظر لا يزيله منها — سيظل يتلقى رسائلك هناك عبر بقية الأعضاء. غادر مجموعة مشتركة أدناه، أو احظر %1$@ على أي حال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er stadig medlem af en gruppe, I deler. At blokere fjerner ikke personen fra den — vedkommende bliver ved med at modtage dine beskeder der fra alle de andre medlemmer. Forlad en delt gruppe nedenfor, eller bloker %1$@ alligevel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist weiterhin Mitglied einer Gruppe, die ihr gemeinsam habt. Eine Blockierung entfernt die Person nicht daraus — sie bekommt deine Nachrichten dort weiterhin von allen anderen Mitgliedern. Verlasse unten eine gemeinsame Gruppe, oder blockiere %1$@ trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is still a member of a group you share. Blocking doesn't remove them from it — they'll keep receiving your messages there from every other member. Leave a shared group below, or block %1$@ anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sigue siendo miembro de un grupo que compartís. Bloquear a esa persona no la saca de él — seguirá recibiendo ahí tus mensajes a través de todos los demás miembros. Sal de un grupo compartido más abajo, o bloquea a %1$@ de todos modos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ هنوز عضو گروهی است که با او مشترک دارید. مسدود کردن، او را از آن گروه بیرون نمی‌کند — او همچنان پیام‌های شما را از طریق دیگر اعضا در آنجا دریافت خواهد کرد. یکی از گروه‌های مشترک را در پایین ترک کنید، یا %1$@ را در هر صورت مسدود کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on yhä jäsenenä ryhmässä, joka teillä on yhteinen. Estäminen ei poista häntä siitä — hän saa siellä edelleen viestisi kaikkien muiden jäsenten kautta. Poistu jaetusta ryhmästä alta, tai estä %1$@ silti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fait toujours partie d'un groupe que vous partagez. Bloquer cette personne ne la retire pas du groupe — elle continuera d'y recevoir vos messages via tous les autres membres. Quittez un groupe partagé ci-dessous, ou bloquez %1$@ quand même."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сè уште е член на група што ја делите. Блокирањето не го отстранува од неа — таму сепак ќе ги добива вашите пораки од сите други членови. Напуштете заедничка група подолу, или сепак блокирајте го %1$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er fortsatt medlem av en gruppe dere deler. Å blokkere fjerner ikke personen fra den — vedkommende fortsetter å motta meldingene dine der, fra alle de andre medlemmene. Forlat en delt gruppe nedenfor, eller blokker %1$@ likevel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ всё ещё состоит в группе, которая есть у вас обоих. Блокировка не удаляет его из неё — он будет по-прежнему получать там ваши сообщения от всех остальных участников. Покиньте общую группу ниже или всё равно заблокируйте %1$@."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ weli waa xubin koox la wadaago. Xannibaaddu ma ka saarayso koox-daas — fariimahaaga ayaa halkaas u sii socon doona xubnaha kale oo dhan. Ka bax koox la wadaago hoos, ama xannib %1$@ si kastaba ha ahaatee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ är fortfarande medlem i en grupp som ni delar. En blockering tar inte bort personen ur den — personen fortsätter ändå att få dina meddelanden där, från alla andra medlemmar. Lämna en delad grupp nedan, eller blockera %1$@ ändå."
          }
        }
      }
    },
