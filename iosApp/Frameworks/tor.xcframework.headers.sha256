# Tree-digest of each slice's compiled Tor.framework/Headers.
# The headers are COMPILE INPUTS (SYSTEM_HEADER_SEARCH_PATHS → the app compiles the
# iCepa Obj-C wrapper incl. tor_api.h), so a tampered/added header would compile
# into the app while the binary-only gate (tor.xcframework.sha256) passed. This is a
# whole-tree digest computed by verify-tor-xcframework.sh:
#   ( cd <slice>/Tor.framework/Headers && find . -type f | LC_ALL=C sort | xargs shasum -a256 ) | shasum -a256
# so it catches a modified header (content) AND an added/removed one (the file list).
# Regenerated by build-tor-xcframework.sh on rebuild — never by hand.
778b5e47d66c03347ca92adb1269ddd2a3960ddedbaf18120477387f64fdbc11  ios-arm64/Tor.framework/Headers
1a7b08a93d6a90810daa08218ef4b2064238beb1a785e3e3be3b613588a45a6f  ios-arm64_x86_64-simulator/Tor.framework/Headers
