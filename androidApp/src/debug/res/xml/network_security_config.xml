<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration (DEBUG override).

    Replaces the release config for DEBUG builds only (build-type resources take
    precedence over main). Adds the dev/test cleartext loopback + emulator
    aliases on top of .onion:
      • localhost / 127.0.0.1 — loopback (MockWebServer / instrumented tests,
        Tor SOCKS proxy)
      • 10.0.2.2 — Android emulator alias for the host's localhost

    These never reach a release build, which permits cleartext for .onion only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Tor hidden services — no TLS needed, Tor encrypts end-to-end -->
        <domain includeSubdomains="true">onion</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
