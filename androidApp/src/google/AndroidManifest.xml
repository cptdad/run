<?xml version="1.0" encoding="utf-8"?>
<!-- `google` flavour only: the FCM service and the Firebase meta-data. The `foss` flavour
     (F-Droid) links no Firebase, so none of this is merged into it; the shared manifest
     (src/main) carries everything else, including the UnifiedPush service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- FCM vendor-push tier — used when
             Play Services is present and the user opts in. -->
        <service
            android:name=".RunFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The FirebaseMessaging component is
             registered alwaysEager() in the SDK, so the merged FirebaseInitProvider
             constructs it at process start — before ANY app code runs, including
             RunApplication.onCreate() — and with no override here it defaults to
             auto-init ENABLED, registering this device with Google on first launch
             regardless of the in-app push opt-in. These two meta-data flip that
             default OFF; VendorPush.currentToken() re-enables isAutoInitEnabled
             just-in-time, immediately before a GENUINE opt-in registration, and
             WipeRoutine's destroyLocalPushIdentity() turns it back off on every
             wipe (that setter persists across app restarts). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_data_collection_default_enabled"
            android:value="false" />

        <!-- Refuses Firebase's "notification
             delegation" grant on a FRESH install. `ProxyNotificationInitializer`
             (bytecode-verified against firebase-messaging 25.1.2) runs from an
             UNGATED eager lambda at process start — NOT gated on
             firebase_messaging_auto_init_enabled above, unlike its siblings —
             and when this key is ABSENT it defaults to calling
             `NotificationManager.setNotificationDelegate("com.google.android.gms")`,
             authorising Play Services to render an FCM display payload as a Rún
             notification WITHOUT this app's process ever starting, bypassing
             RunFcmService.handleIntent's payload strip and the NotificationLevel wake
             gate entirely. This meta-data closes that for installs that have
             NEVER granted the delegate. It does NOT close it retroactively — the
             SDK persists whichever delegate it last set, once-ever, in its own
             prefs — so VendorPush.disableNotificationDelegation's RUNTIME call
             (RunApplication.onCreate + every VendorPush.destroyLocalPushIdentity
             call, i.e. every wipe and every push opt-out) is the half that
             actually revokes an already-granted delegate. Both halves are
             required; neither alone is sufficient. -->
        <meta-data
            android:name="firebase_messaging_notification_delegation_enabled"
            android:value="false" />

        <!-- Fallback channel for FCM messages the SDK
             displays ITSELF — i.e. any payload carrying a "notification" block
             rather than being data-only. This app's own wake push is contractually
             data-only (see RunFcmService's "Contentless invariant" header) and is
             always routed through NotificationHelper's channel
             (run_new_messages_v3, NotificationHelper.CHANNEL_ID), whose
             settings the user owns. Without this meta-data, an
             SDK-auto-displayed notification would fall back to an ad-hoc
             "Miscellaneous" channel — a SECOND entry in system settings that
             the user's choices on the real channel would not govern, carrying
             whatever text the payload put in its "notification" block.
             Pointing this at the SAME id keeps every notification this app can
             possibly post under one user-controllable channel. Must stay
             byte-for-byte equal to
             NotificationHelper.CHANNEL_ID ("run_new_messages_v3") — a mismatch
             silently recreates this gap by referencing a channel that doesn't
             exist yet at first-notification time. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="run_new_messages_v3" />

    </application>

</manifest>
