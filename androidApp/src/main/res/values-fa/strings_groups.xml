    <string name="create_group_failed">ایجاد گروه ممکن نشد. اتصال را بررسی کنید و دوباره تلاش کنید.</string>
    <string name="create_group_creating">در حال ایجاد…</string>
    <string name="create_group_select_members">انتخاب اعضا</string>
