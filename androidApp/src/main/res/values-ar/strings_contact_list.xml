    <!-- Reset relay access -->
    <string name="contact_list_reset_relay_title">هل تريد إعادة تعيين الوصول إلى المُرحّل؟</string>
    <string name="contact_list_reset_relay_message">سيحصل Rún على مفاتيح وصول جديدة لهذه المحادثة من المُرحّل. تبقى رسائلك وسجلّك وجهة الاتصال هذه كما هي تمامًا، ولا يحتاج %1$s إلى فعل أي شيء.\n\nافعل هذا إذا كنت تعتقد أن شخصًا آخر أمسك بهاتفك وهو غير مقفل. لا يُلغي هذا أي شيء قرأه ذلك الشخص بالفعل — وإذا كان الهاتف قد أُخذ فعلًا، فالحل الأسلم يبقى حذف جهة الاتصال هذه والاقتران من جديد شخصيًا.</string>
    <string name="contact_list_reset_button">إعادة تعيين</string>
    <string name="contact_list_reset_relay_success">تمت إعادة تعيين الوصول إلى المُرحّل.</string>
    <string name="contact_list_reset_relay_failure">تعذّر الوصول إلى المُرحّل. سيكمل Rún هذا بنفسه.</string>

    <!-- Leave-group confirmation (Android wording) -->
