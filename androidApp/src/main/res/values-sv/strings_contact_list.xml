<?xml version="1.0" encoding="utf-8"?>
<!--
  Kontaktlistan: lista, tomt läge, inställningsmeny/ark, uppdateringsmodal,
  push-fråga, dialoger för introduktioner, banner om omparkoppling,
  blockerade kontakter (endast iOS — Android har ingen blockera/anmäl-funktion,
  se docs) samt statusraden för Tor/relä med tips vid stopp (delad hjälpfunktion:
  RelayConnectHints.kt / AppState.connectStatusLine).

  Nyckelprefix: contact_list_, nudge_, push_prompt_, referral_, connect_.
  Två undantag bor också här eftersom deras Swift-innehåll ligger inbakat i
  ContactListView.swift (Om-rutan och push-inställningarnas karusellram) trots
  att Android-motsvarigheterna är separata filer som ägs av ett annat område —
  prefixen about_info_ / notif_settings_, enligt kampanjens dedupe-konvention.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Statusrad för reläet före anslutning + tips vid stopp (RelayConnectHints.kt / AppState.connectStatusLine — Android och iOS delar dessa nycklar byte för byte) -->
    <string name="connect_tor_phase">Ansluter till Tor</string>
    <string name="connect_relay_phase">Ansluter till reläet</string>
    <string name="connect_relay_first_time_hint">Den första anslutningen kan ta några minuter.</string>
    <string name="connect_relay_slow_hint">Tor-nätverket kan ibland vara långsamt — det är priset för total anonymitet.</string>
    <string name="connect_tor_stalled_hint">Ansluter fortfarande…\nNätverket kan blockera den privata anslutningen. Prova ett annat Wi-Fi eller mobildata — vi fortsätter försöka.</string>
    <string name="connect_mint_stalled_hint">Ansluter fortfarande… Nätverket kan blockera den privata anslutningen. Prova ett annat Wi-Fi eller mobildata — vi fortsätter försöka.</string>
    <string name="connect_relay_stalled">Når fortfarande inte reläet.</string>
    <string name="connect_reconnect_button">Anslut igen</string>

    <!-- Relä-/Tor-tips som bara finns på iOS (iOS kan inte starta om Tor i processen — tor_main körs en gång per process, så plattformen behöver extra text om omstart och stopp i flera steg som Android inte behöver) -->
    <string name="connect_relay_stalled_reopen_hint">Når fortfarande inte reläet.\nÖppna Rún igen om det här fortsätter.</string>
    <string name="connect_relay_relaunch_hint">Den säkra anslutningen kan inte återhämta sig i den här sessionen.\nStäng och öppna Rún igen för att ansluta på nytt.</string>
    <string name="connect_tor_stalled_long_hint">Kan fortfarande inte ansluta.\nStäng Rún helt och öppna appen igen — det startar en ny privat anslutning.</string>
    <string name="connect_tor_reboot_hint">Om det inte hjälpte att stänga och öppna appen, starta om din iPhone.</string>

