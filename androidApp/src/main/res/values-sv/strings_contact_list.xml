    <!-- Blockera / anmäl en kontakt (riktlinje 1.2, endast iOS — Android har ingen blockera/anmäl-funktion) -->
    <string name="contact_list_block_contact_title">Blockera kontakt</string>
    <string name="contact_list_block_contact_message">Du får inte längre meddelanden från %1$s, och personen tas bort från din lista.</string>
    <string name="contact_list_contact_blocked_title">Kontakten är blockerad</string>
    <string name="contact_list_post_block_report_message">Vill du anmäla kontakten för stötande innehåll eller kränkande beteende? Anmälningar granskas och åtgärdas inom 24 timmar. Din anmälan skickas från din egen e-postapp, så vi ser din e-postadress — och utkastet sparas av den appen, utanför Rún, där det inte raderas om du raderar Rún.</string>
    <string name="contact_list_block_shared_groups_title">Delade grupper</string>
    <string name="contact_list_block_shared_groups_message">%1$s är fortfarande medlem i en grupp som ni delar. En blockering tar inte bort personen ur den — personen fortsätter ändå att få dina meddelanden där, från alla andra medlemmar. Lämna en delad grupp nedan, eller blockera %1$s ändå.</string>
    <string name="contact_list_block_shared_groups_leave_button">Lämna ”%1$s”</string>
    <string name="contact_list_block_shared_groups_anyway_button">Blockera ändå</string>

