    <!-- Återställ reläåtkomst (samma formulering på båda plattformarna) -->
    <string name="contact_list_reset_relay_title">Återställa reläåtkomsten?</string>
    <string name="contact_list_reset_relay_message">Rún hämtar nya åtkomstnycklar för den här konversationen från reläet. Dina meddelanden, din historik och kontakten är kvar precis som de är, och %1$s behöver inte göra någonting.\n\nGör det här om du tror att någon annan haft din telefon medan den var upplåst. Det gör inte det de redan hunnit läsa ogjort — och om telefonen verkligen togs är det säkraste ändå att radera kontakten och parkoppla på nytt personligen.</string>
    <string name="contact_list_reset_button">Återställ</string>
    <string name="contact_list_reset_relay_success">Reläåtkomsten är återställd.</string>
    <string name="contact_list_reset_relay_failure">Kunde inte nå reläet. Rún slutför det här på egen hand.</string>

