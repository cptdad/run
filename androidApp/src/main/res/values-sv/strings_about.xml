<?xml version="1.0" encoding="utf-8"?>
<!--
  Ramen för Om-modalen (AboutInfoModal.kt — den klassiska rutan med appnamn/
  version/tack, skild från den svepbara funktionskarusellen som är nycklad i
  strings_shared.xml under about_*) samt donations-/stödmodalen och dricksburken
  (DonateModal.kt, TipJar.kt — Play Billing) och iOS-motsvarigheten
  (SupportView.swift, TipStore.swift). Nyckelprefix: about_info_, donate_, tip_.

  Lokaliseras medvetet INTE här (enligt kampanjens undantagslista): appnamnet
  "Rún", runtecknet "ᚱ", tillverkarnamnet "Vikstrom Group AB", adressen
  "vgab.eu", namn och licenser i tacklistan (AboutContent.credits — ett par av
  namn och licens, inte en mening) och själva versionsnumren i "Version X (Y)"
  (bara det omgivande ordet är en resurs).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Om-modalen (AboutInfoModal.kt) -->
    <string name="about_info_tagline">Privata meddelanden, dirigerade via Tor.</string>
