    <string name="about_info_open_source_heading">Byggd på öppen källkod</string>
    <string name="about_info_clearnet_title">Öppna i webbläsaren?</string>
    <string name="about_info_clearnet_message">vgab.eu öppnas i din webbläsare över det vanliga internet — inte Tor. Webbplatsen och ditt nätverk kan se enhetens IP-adress.</string>

