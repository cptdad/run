<?xml version="1.0" encoding="utf-8"?>
<!--
  Contact-list screen: list, empty state, settings menu/sheet, update-nudge
  modal, push-prompt dialog, referral/introduce dialogs, stale re-pair banner,
  blocked contacts (iOS-only — Android has no block/report feature, see
  docs), and the Tor/relay connect status line + stall hints (shared pure
  helper: RelayConnectHints.kt / AppState.connectStatusLine).

  Key prefixes: contact_list_, nudge_, push_prompt_, referral_, connect_.
  Two carve-outs live here too because their Swift content is physically
  inlined inside ContactListView.swift (About-info box + Push-settings
  carousel chrome) even though their Android counterparts are separate
  files owned by another area — about_info_ / notif_settings_ prefixes,
  per the campaign dedupe convention.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Pre-connect relay status line + stall hints (RelayConnectHints.kt / AppState.connectStatusLine — Android+iOS share these keys byte-for-byte) -->
    <string name="connect_tor_phase">Connecting to Tor</string>
    <string name="connect_relay_phase">Connecting to Relay</string>
    <string name="connect_relay_first_time_hint">The first connection can take a few minutes.</string>
    <string name="connect_relay_slow_hint">Tor network can sometimes be slow, this is the price for total anonymity</string>
    <string name="connect_tor_stalled_hint">Still connecting…\nThis network may be blocking the private connection. Try different Wi-Fi or mobile data — we’ll keep trying.</string>
    <string name="connect_mint_stalled_hint">Still connecting… This network may be blocking the private connection. Try different Wi-Fi or mobile data — we’ll keep trying.</string>
    <string name="connect_relay_stalled">Still can’t reach the relay.</string>
    <string name="connect_reconnect_button">Reconnect</string>

    <!-- iOS-only relay/Tor hints (iOS cannot restart Tor in-process — tor_main runs once per process, so it has extra relaunch/tiered-stall copy Android doesn't need) -->
    <string name="connect_relay_stalled_reopen_hint">Still can’t reach the relay.\nReopen Rún if this keeps happening.</string>
    <string name="connect_relay_relaunch_hint">The secure connection can’t recover in this session.\nClose and reopen Rún to reconnect.</string>
    <string name="connect_tor_stalled_long_hint">Still can’t connect.\nClose Rún completely and open it again — that starts a fresh private connection.</string>
    <string name="connect_tor_reboot_hint">If closing and reopening hasn’t helped, restart your iPhone.</string>

