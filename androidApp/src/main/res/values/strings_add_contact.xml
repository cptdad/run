<?xml version="1.0" encoding="utf-8"?>
<!--
  Add Contact — QR scan/show, code entry, alias naming, referral/introduction
  offers, camera permission copy (AddContactScreen.kt / AddContactView.swift).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Header / navigation -->
    <string name="add_contact_title">Add contact</string>
    <string name="add_contact_nav_title">Add Contact</string>

    <!-- Step 1 — Choice -->
    <string name="add_contact_choice_heading">Add a contact</string>
    <string name="add_contact_choice_subtitle">You and your contact swap codes. Pick how to start — you’ll do both.</string>
    <string name="add_contact_choice_show">Show my code</string>
    <string name="add_contact_choice_scan">Scan a code</string>

    <!-- Step — Show my code -->
    <string name="add_contact_show_heading">Show this to your contact</string>
    <string name="add_contact_show_hint_scanned">Have them scan this, then finish.</string>
    <string name="add_contact_show_hint_pending">Have them scan this. You’ll scan theirs next.</string>
    <string name="add_contact_next">Next</string>
    <string name="add_contact_show_first_android">I’ve shown it →</string>
    <string name="add_contact_show_first_ios">I’ve shown it</string>

    <!-- Step — Scan code -->
    <string name="add_contact_scan_heading">Scan your contact\'s QR code</string>
    <string name="add_contact_camera_permission">Camera permission required to scan</string>
    <string name="add_contact_invalid_qr">Invalid QR code format</string>
    <!-- The quoted screen name must match add_contact_scan_back_title below: it
         points the user at the peer's post-scan screen, which is where the peer's
         FULL code (the one that carries their inbox) is shown. -->
    <string name="add_contact_scan_deadlock">Scan the code on their “Almost there” screen</string>

    <!-- Mint status / finishing wait -->
    <string name="add_contact_mint_failed_relay">Could not reach the relay</string>
    <string name="add_contact_solving_pow">Solving proof-of-work…</string>
    <string name="add_contact_setting_up_inbox">Setting up inbox…</string>
    <string name="add_contact_mint_failed_prefix">Mint failed: %1$s</string>
    <!-- iOS-only mintStatusLine fallback for the .ready case — not normally
         visible (the finishing step transitions away as soon as mint lands),
         kept for the defensive switch exhaustiveness. -->
    <string name="add_contact_mint_ready">Inbox ready</string>

    <!-- Step — Done -->
    <string name="add_contact_done_heading">✓ Contact added</string>
    <string name="add_contact_saved_as">Saved as: %1$s</string>
    <string name="add_contact_qr_preparing">Preparing your code…</string>
    <string name="add_contact_announce_hint">They\'ll be able to message you in a moment — your inbox is delivered automatically.</string>
    <string name="add_contact_mnemonic_label">Personal memory (optional)</string>
    <string name="add_contact_mnemonic_placeholder">e.g. Met at the conference in Oslo</string>

    <!-- Step — Done, but the pairing is only HALF done (App Store 2.1(a), 1.6.13).
         We scanned their instant secret-only code, so they still have to scan OUR
         full code (it is the one that carries our inbox). This screen used to claim
         "✓ Contact added" and offer Done — tapping it dropped the transient inbox
         write capability and left a contact that could never be completed. -->
    <string name="add_contact_scan_back_title">Almost there</string>
    <string name="add_contact_scan_back_hint">Now let them scan your code. You’ll be able to message each other the moment they do.</string>
    <string name="add_contact_keep_waiting">Keep waiting</string>
    <string name="add_contact_cancel_pairing">Cancel pairing</string>
    <string name="add_contact_cancel_pairing_title">Cancel pairing?</string>
    <string name="add_contact_cancel_pairing_message">This deletes the half-finished contact and closes its inboxes. You’ll both have to start over with new codes.</string>

    <!-- Code exchange (paste) tab -->
    <string name="add_contact_your_code">Your code</string>
    <string name="add_contact_their_code">Their code</string>
    <string name="add_contact_paste_placeholder">Paste contact code here</string>
    <string name="add_contact_copied_bang">Copied!</string>
    <string name="add_contact_invalid_code">Invalid code</string>
    <string name="add_contact_paste_not_ready">Still setting up inbox — try again in a moment</string>

    <!-- vault-refused add (peer inbox id already owned by an existing contact).
         Kept byte-identical across platforms — see the shared-comment note in both
         AddContactScreen.kt and AddContactView.swift. -->
    <string name="add_contact_inbox_in_use">Couldn\'t add this contact — one of the inboxes in their code is already in use here. If you\'re re-adding someone you already have, delete the old contact first, then try again.</string>

</resources>
