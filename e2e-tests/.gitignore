_crossrun_*.log
push-tier2-*.log
push-tier2-*.taillog
android-poll-*.log

# Device-pool lease store (helpers/devicePool.js) — leases, slots, waiters, inventory
.device-pool/
prod-tester-*.log
prod-tester-cycles*.csv
.prod-tester-pause

# test:dynamic_real_life run folders (scenario, actions, ledger, frames — pure artifacts)
dynamic/runs/
