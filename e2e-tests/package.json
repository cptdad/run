{
  "name": "run-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for the Rún secure messenger (iOS + Android)",
  "private": true,
  "scripts": {
    "mock:relay": "node ./mock-relay/server.js",
    "mock:relay:selftest": "node ./mock-relay/selftest.js",
    "test:mock-push": "node ./mock-relay/push-contract.test.js",
    "test:mock-lease": "node ./mock-relay/lease-ack.test.js",
    "test:emulator:android": "./scripts/with-node22.sh ./scripts/run-android-emu.sh",
    "test:emulator:ios": "./scripts/with-node22.sh ./scripts/run-ios-sim.sh",
    "test:emulator:all": "npm run test:emulator:android && npm run test:emulator:ios",
    "test:emulator:android:raw": "./scripts/with-node22.sh wdio run ./wdio.android.conf.ts",
    "test:emulator:ios:raw": "./scripts/with-node22.sh wdio run ./wdio.ios.conf.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.12.4",
    "typescript": "^7.0.2",
    "webdriverio": "^9.31.9"
  },
  "dependencies": {}
}
